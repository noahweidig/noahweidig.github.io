{
  "_comment": "House style for scripts/prose-lint.mjs (#250). US spelling, sentence case for headings and labels, plain voice. Proper nouns are the allowlist for the sentence-case rule.",
  "skipDirs": ["node_modules", "_site", "_freeze", "_extensions", "publications", "uploads"],
  "headingClasses": ["nw-title", "nw-exp-edu-label", "nw-section-title"],
  "labelClasses": ["nw-btn", "nw-head-link", "nw-start-link", "nw-cta"],
  "britishSpellings": {
    "modelling": "modeling",
    "modelled": "modeled",
    "colour": "color",
    "colours": "colors",
    "behaviour": "behavior",
    "behaviours": "behaviors",
    "analyse": "analyze",
    "analysed": "analyzed",
    "organise": "organize",
    "organised": "organized",
    "organisation": "organization",
    "recognise": "recognize",
    "recognised": "recognized",
    "centre": "center",
    "labelled": "labeled",
    "favourite": "favorite",
    "programme": "program",
    "catalogue": "catalog",
    "visualise": "visualize",
    "visualisation": "visualization",
    "utilise": "utilize"
  },
  "bannedPhrases": [
    "amazing",
    "feel free",
    "cutting-edge",
    "world-class",
    "passionate about",
    "leverage synergies",
    "reach out to me today"
  ],
  "properNouns": ["I", "GIS", "R", "Quarto", "Python", "WUI", "English"],
  "properNounPhrases": ["Shift Your Phone", "Google Earth Engine", "Open Access"]
}

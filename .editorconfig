# One source of truth for whitespace, so an editor that has never seen this
# repo produces the same bytes Prettier would.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

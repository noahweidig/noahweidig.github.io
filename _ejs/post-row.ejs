```{=html}
<% for (const item of items) { %>
<div class="nw-post<%= item.image ? ' nw-has-cover' : '' %>" data-cats="<%= (item.categories || []).join('|') %>">
<%
// The cover link and the heading link below it point at the same page, so a
// screen reader would announce every card twice. The heading link keeps the
// accessible name; the cover is hidden from assistive tech and taken out of
// the tab order, staying a click target for pointer users. Same treatment the
// project cards give their screenshots.
%>
<% if (item.image) { %>
<a class="nw-post-media" href="<%- item.path %>" tabindex="-1" aria-hidden="true"><img class="nw-post-cover" src="<%= item.image %>" alt="<%= item['image-alt'] || '' %>" width="1200" height="675" loading="lazy"><% if (item['reading-time']) { %><span class="nw-post-readtime"><%= item['reading-time'] %> read</span><% } %></a>
<% } else if (item['reading-time']) { %>
<div class="nw-post-readtime"><%= item['reading-time'] %> read</div>
<% } %>
<div class="nw-post-body">
<h3><a href="<%- item.path %>"><%= item.title %></a></h3>
<div class="nw-post-date"><%= item.date ? new Date(item.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) : '' %></div>
<p><%= item.description || '' %></p>
<% if ((item.categories || []).length) { %>
<div class="nw-chips">
<% for (const c of item.categories) { %><span class="nw-chip"><%= c %></span><% } %>
</div>
<% } %>
</div>
</div>
<% } %>
```

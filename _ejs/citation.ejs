<%
// Slug used for the accent colour, e.g. "Journal Article" -> "journal-article".
const citeSlug = (s) => String(s || "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

// One plain-language line, derived from the entry's own description (the
// abstract's opening, written by scripts/update-pubs.js). Cut at the first
// sentence break so the row gets a readable line rather than a paragraph.
// Descriptions that are just the generated citation fallback ("Presentation
// by ... (2025). Venue.") repeat the meta line above, so they are dropped.
function citeSummary(item, category) {
  let text = String(item.description || "").replace(/\s+/g, " ").trim();
  if (!text) return "";
  if (category && text.toLowerCase().startsWith(category.toLowerCase())) return "";
  const stop = text.slice(0, 200).search(/[.!?](\s|$)/);
  if (stop > 40) text = text.slice(0, stop + 1);
  else if (text.length > 200) {
    const cut = text.slice(0, 200);
    const sp = cut.lastIndexOf(" ");
    text = (sp > 0 ? cut.slice(0, sp) : cut).replace(/[\s.,;:]+$/, "") + "…";
  }
  return text;
}

// Repeat appearances of one work (#253). scripts/update-pubs.js lists every
// venue the work was presented at on the one entry that gets listed, so the
// row can say "presented at IALE-NA (Apr 2025), ESA (Aug 2025)" instead of the
// same abstract appearing four times in the section.
function citeAppearances(item) {
  const raw = item['pub-appearances'];
  if (!Array.isArray(raw) || raw.length < 2) return [];
  return raw
    .filter((a) => a && typeof a === 'object')
    .map((a) => ({
      venue: String(a.venue || '').trim(),
      when: String(a.when || '').trim(),
      kind: String(a.kind || '').trim(),
      url: String(a.url || '').trim(),
    }))
    .filter((a) => a.venue || a.when);
}
%>
<%
// The icon paths below are written as literal markup rather than assembled in
// JS: Quarto's EJS escapes "<" in interpolated output, so a string of <path>
// elements would render as visible text instead of a glyph.
%>
<% for (const item of items) { %>
<%
const cats = item.categories || [];
const category = cats[0] || "";
const summary = citeSummary(item, category);
const appearances = citeAppearances(item);
const cites = Number(item['pub-citations'] || 0);
%>
<div class="nw-cite" data-cats="<%= cats.join('|') %>" data-cite-type="<%= citeSlug(category) %>">
<span class="nw-cite-year"><span class="nw-cite-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><% if (category === "Journal Article") { %><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/><path d="M9 9h1"/><path d="M9 13h6"/><path d="M9 17h6"/><% } else if (category === "Preprint") { %><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/><path d="M9 13h6"/><path d="M9 17h3"/><% } else if (category === "Thesis") { %><path d="M22 9l-10 -4l-10 4l10 4l10 -4v6"/><path d="M6 10.6v5.4a6 3 0 0 0 12 0v-5.4"/><% } else if (category === "Book") { %><path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0"/><path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0"/><path d="M3 6l0 13"/><path d="M12 6l0 13"/><path d="M21 6l0 13"/><% } else if (category === "Report") { %><path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2"/><path d="M9 3m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v0a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z"/><path d="M9 12l2 2l4 -4"/><% } else if (category === "Presentation") { %><path d="M3 4h18"/><path d="M4 4v10a1 1 0 0 0 1 1h14a1 1 0 0 0 1 -1v-10"/><path d="M12 15v4"/><path d="M9 19h6"/><% } else if (category === "Webinar") { %><path d="M15 10l4.553 -2.276a1 1 0 0 1 1.447 .894v6.764a1 1 0 0 1 -1.447 .894l-4.553 -2.276v-4z"/><path d="M3 6m0 2a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2z"/><% } else if (category === "Media Coverage") { %><path d="M16 6h3a1 1 0 0 1 1 1v11a2 2 0 0 1 -4 0v-13a1 1 0 0 0 -1 -1h-10a1 1 0 0 0 -1 1v12a3 3 0 0 0 3 3h11"/><path d="M8 8l4 0"/><path d="M8 12l4 0"/><path d="M8 16l4 0"/><% } else if (category === "Peer Review") { %><path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"/><path d="M9 12l2 2l4 -4"/><% } else if (category === "Book Chapter") { %><path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0"/><path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0"/><path d="M3 6l0 13"/><path d="M12 6l0 13"/><path d="M21 6l0 13"/><% } else { %><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/><% } %></svg></span><%= item.date ? new Date(item.date).getUTCFullYear() : '' %></span>
<div class="nw-cite-body">
<div class="nw-cite-title"><a href="<%- item.path %>"><%= item.title %></a></div>
<div class="nw-cite-meta"><% for (const [i, part] of String(item['pub-authors'] || '').replace(/&lt;\/?strong&gt;|<\/?strong>/g, '**').split('**').entries()) { if (i % 2) { %><strong><%= part %></strong><% } else { %><%= part %><% } } %><% if (item['pub-venue']) { %> &middot; <em><%= item['pub-venue'] %></em><% } %></div>
<% if (appearances.length) { %><p class="nw-cite-appearances">Presented at <% for (const [i, a] of appearances.entries()) { %><% if (i) { %>, <% } %><% if (a.url) { %><a href="<%- a.url %>" target="_blank" rel="noopener"><%= a.venue %></a><% } else { %><%= a.venue %><% } %><% if (a.when) { %> (<%= a.when %>)<% } %><% } %></p><% } %>
<% if (summary) { %><p class="nw-cite-summary"><%= summary %></p><% } %>
<div class="nw-cite-links">
<% for (const c of cats.slice(0, 2)) { %><span class="nw-chip nw-cite-cat"><%= c %></span><% } %>
<% if (cites > 0) { %><span class="nw-chip nw-cite-cites"><%= cites %> citation<%= cites === 1 ? '' : 's' %></span><% } %>
<% if (item['pub-oa']) { %><span class="nw-chip nw-cite-oa">Open Access</span><% } %>
<% if (item['pub-doi']) { %><a href="https://doi.org/<%- item['pub-doi'] %>" target="_blank" rel="noopener">DOI</a><% } %>
<% if (item['pub-url'] && !item['pub-doi']) { %><a href="<%- item['pub-url'] %>" target="_blank" rel="noopener">Source</a><% } %>
<% if (item['pub-pdf']) { %><a class="nw-cite-pdf" href="<%- String(item.path).replace(/index\.html?$/, '') + item['pub-pdf'] %>" target="_blank" rel="noopener">View PDF</a><% } %>
</div>
</div>
</div>
<% } %>

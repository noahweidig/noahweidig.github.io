{
  "name": "noahweidig-ai-search",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker behind noahweidig.com/api/* — Groq-backed answers for the search dialog.",
  "scripts": {
    "catalog": "node scripts/fetch-catalog.mjs",
    "dev": "npm run catalog && wrangler dev --port 8788",
    "deploy": "npm run catalog && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}

---
import { u } from '../lib/url';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { shotFor } from '../lib/images';

interface Props {
  entry: CollectionEntry<'projects'>;
  index?: number;
  cta?: boolean;
  reveal?: boolean;
  class?: string;
}
const { entry, index = 0, reveal = true, class: cls } = Astro.props;
const { title, categories } = entry.data;
const slug = entry.id;
const shot = shotFor(slug);
---

<article
  class={cls}
  data-cats={categories.join('|')}
  data-reveal={reveal ? '' : undefined}
  style={`--reveal-delay:${Math.min(index, 5) * 60}ms`}
>
  <a href={u(`/projects/${slug}/`)} class="relative block aspect-16/10 overflow-hidden bg-raised">
    {shot ? (
      <Image
        src={shot}
        alt=""
        widths={[600, 1000, 1200]}
        sizes="(min-width: 768px) 608px, 92vw"
        loading={index === 0 ? 'eager' : 'lazy'}
        class="h-full w-full object-cover object-top"
      />
    ) : (
      <div class="grid h-full place-items-center opacity-30">
        <Icon name="layers" size={48} />
      </div>
    )}
    <span class="absolute bottom-3 left-3 max-w-[calc(100%-1.5rem)] rounded-full bg-white px-5 py-2.5 text-[0.95rem] leading-tight font-medium text-[#14161a] sm:bottom-4 sm:left-4 sm:px-5 sm:py-2.5 sm:text-[0.95rem]">
      {title}
    </span>
  </a>
</article>

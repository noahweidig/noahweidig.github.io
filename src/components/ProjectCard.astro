---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { shotFor } from '../lib/images';
import { vtName } from '../lib/format';

interface Props {
  entry: CollectionEntry<'projects'>;
  index?: number;
  cta?: boolean;
  reveal?: boolean;
  class?: string;
}
const { entry, index = 0, reveal = true, class: cls } = Astro.props;
const { title, categories } = entry.data;
const slug = entry.id;
const shot = shotFor(slug);
---

<article
  class={cls}
  data-cats={categories.join('|')}
  data-reveal={reveal ? '' : undefined}
  style={`--reveal-delay:${Math.min(index, 5) * 60}ms`}
>
  <a
    href={`/projects/${slug}/`}
    class="relative block aspect-16/10 overflow-hidden rounded-md bg-raised"
  >
    {shot ? (
      <Image
        src={shot}
        alt=""
        widths={[600, 1000, 1200]}
        sizes="(min-width: 768px) 608px, 92vw"
        loading={index === 0 ? 'eager' : 'lazy'}
        class="h-full w-full object-cover object-top"
      />
    ) : (
      <div class="grid h-full place-items-center opacity-30">
        <Icon name="layers" size={48} />
      </div>
    )}
    <span class="card-badge" style={`view-transition-name:${vtName(`/projects/${slug}`)}`}>
      {title}
    </span>
  </a>
</article>

---
import { u } from '../lib/url';
import { nav, socials } from '../lib/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import NewsletterForm from './NewsletterForm.astro';
const year = new Date().getFullYear();
---

<footer
  data-pagefind-ignore
  data-site-footer
  class="footer-dark relative mt-28 border-t border-line bg-bg-deep"
>
  <div class="w-full px-5 sm:px-6 lg:px-8">
    <div class="py-10">
      <div class="flex flex-col items-center gap-6 lg:flex-row lg:items-center lg:justify-between">
        <a href={u('/')} class="group inline-flex shrink-0 items-center gap-2.5">
          <Logo class="wordmark-icon h-7 w-auto" />
          <span
            data-text="Noah Weidig"
            class="wordmark-wipe footer-ink font-display text-xl font-bold"
          >
            Noah Weidig
          </span>
        </a>

        <div class="flex w-full min-w-0 flex-wrap items-center justify-center gap-4 sm:w-auto sm:gap-5">
          <span class="footer-ink font-display text-xl whitespace-nowrap">
            Subscribe to my newsletter
          </span>
          <NewsletterForm />
        </div>
      </div>

      <div class="mt-8 flex flex-col items-center gap-y-6 border-t border-line pt-8 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-x-8 sm:gap-y-4">
        <nav
          aria-label="Footer"
          class="mx-auto grid grid-cols-2 gap-x-6 gap-y-3 text-center sm:mx-0 sm:flex sm:flex-wrap sm:items-center sm:gap-x-2 sm:text-left"
        >
          {nav.map((item, i) => (
            <>
              {i > 0 && (
                <span class="mx-1.5 hidden text-faint sm:inline" aria-hidden="true">
                  ·
                </span>
              )}
              <a
                href={u(item.href)}
                data-tip={item.tip}
                class="footer-ink text-body-lg font-semibold transition-colors hover:text-accent-ink"
              >
                {item.text}
              </a>
            </>
          ))}
        </nav>
        <div class="mx-auto grid grid-cols-3 gap-2 sm:mx-0 sm:flex sm:items-center">
          {socials.map((s) => (
            <a
              href={s.href}
              aria-label={`${s.label} (opens in a new tab)`}
              data-tip={`${s.label} profile`}
              target="_blank"
              rel="noopener"
              class="icon-tile mx-auto sm:mx-0"
            >
              <Icon name={s.icon} size={17} />
            </a>
          ))}
          <a
            href={u('/rss.xml')}
            aria-label="RSS Feed"
            data-tip="Subscribe to the blog feed"
            class="icon-tile mx-auto sm:mx-0"
          >
            <Icon name="rss" size={17} />
          </a>
        </div>
      </div>

      <div class="mt-6 flex flex-col items-center gap-3 border-t border-line pt-6 text-center text-[0.85rem] text-dim sm:flex-row sm:items-center sm:justify-between sm:text-left">
        <p>
          © {year} Noah Weidig
          <span class="mx-1.5 text-faint">·</span>
          <a class="footer-dim hover:text-accent-ink" href={u('/privacy/')}>
            Privacy Policy
          </a>
          <span class="mx-1.5 text-faint">·</span>
          <a class="footer-dim hover:text-accent-ink" href={u('/terms/')}>
            Terms &amp; Conditions
          </a>
          <span class="mx-1.5 text-faint">·</span>
          <a class="footer-dim hover:text-accent-ink" href={u('/styleguide/')}>
            Styleguide
          </a>
        </p>
        <div class="flex items-center gap-2">
          <span class="font-mono text-caption tracking-[0.12em] text-faint uppercase">Sitemap</span>
          <a
            href={u('/sitemap-0.xml')}
            data-tip="XML sitemap for crawlers"
            class="footer-dim rounded-full border border-line px-2.5 py-1 font-mono text-caption transition-colors hover:border-accent-ink hover:text-accent-ink"
          >
            .xml
          </a>
          <a
            href={u('/sitemap.md')}
            data-tip="Markdown sitemap for humans and LLMs"
            class="footer-dim rounded-full border border-line px-2.5 py-1 font-mono text-caption transition-colors hover:border-accent-ink hover:text-accent-ink"
          >
            .md
          </a>
          <a
            href={u('/llms.txt')}
            data-tip="Short site guide for AI agents"
            class="footer-dim rounded-full border border-line px-2.5 py-1 font-mono text-caption transition-colors hover:border-accent-ink hover:text-accent-ink"
          >
            llms.txt
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Footer stays on the dark palette regardless of site theme, for a
     consistent, premium look — overriding the theme tokens locally means
     every existing text-dim/text-faint/border-line/hover:text-accent-ink
     utility below just works without a separate light-mode override. Every
     link in the footer carries its own explicit text-ink/text-dim class (or
     the icon-tile rule) rather than relying on inherited color, so this base
     rule only needs to cover non-link text (the wordmark) and the
     background. */
  .footer-dark {
    --c-bg: #000000;
    --c-bg-deep: #000000;
    --c-surface: #101216;
    --c-raised: #171a20;
    --c-line: #23272f;
    --c-line-strong: #333845;
    --c-ink: #e9ecf2;
    --c-dim: #99a1b1;
    --c-faint: #7c8494;
    --c-accent: #0072e3;
    --c-accent-ink: #6ba4ff;
    --c-accent-contrast: #ffffff;
    background-color: var(--c-bg-deep);
    color: var(--c-ink);
  }

  /* Tailwind v4 puts every utility class (including hover: variants) inside
     `@layer utilities`, and an unlayered rule always outranks a layered one
     regardless of specificity — so these live in the same layer, or they'd
     make hover:text-accent-ink inert. :global() stops Astro from appending
     its own scoping attribute (which would inflate specificity unpredictably
     and risk winning anyway); a plain single class reliably loses to any
     `:hover`/`:focus-visible` variant, which is what lets the hover color
     still take over. These are a deliberate replacement for text-ink/
     text-dim in the footer, not a fallback layered on top of them — every
     footer link's color reaches it through one of these two classes, so
     contrast holds even where the shared stylesheet can't load (e.g. the
     axe-core file:// audit). */
  @layer utilities {
    :global(.footer-ink) {
      color: var(--c-ink);
    }
    :global(.footer-dim) {
      color: var(--c-dim);
    }
  }

  /* icon-tile's default border/icon color (--c-line / --c-dim) reads too
     faint against the footer's forced-dark background; bump both up a step
     here without touching the shared component used elsewhere on the site. */
  @layer components {
    .footer-dark .icon-tile {
      border-color: var(--c-line-strong);
      color: var(--c-ink);
    }
    .footer-dark .icon-tile:hover {
      border-color: var(--c-accent);
      color: var(--c-accent-ink);
    }
  }
</style>

---
import { u } from '../lib/url';
import { footerColumns, socials, site } from '../lib/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer
  data-pagefind-ignore
  data-site-footer
  class="relative mt-28 overflow-hidden border-t border-line bg-bg-deep"
>
  <div class="topo-bg absolute inset-0" aria-hidden="true"></div>
  <div class="shell relative py-16">
    <div class="grid gap-10 sm:gap-12 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
      <div>
        <a href={u('/')} class="flex items-center gap-2.5">
          <Logo class="h-8 w-auto" />
          <span class="font-display text-xl">Noah Weidig</span>
        </a>
        <p class="mt-3 text-[0.95rem] text-dim">{site.role}</p>
        <div class="mt-5 flex gap-2">
          {
            socials.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                data-tip={`${s.label} profile`}
                target="_blank"
                rel="noopener"
                class="icon-tile"
              >
                <Icon name={s.icon} size={17} />
              </a>
            ))
          }
          <a
            href={u('/rss.xml')}
            aria-label="RSS Feed"
            data-tip="Subscribe to the blog feed"
            class="icon-tile"
          >
            <Icon name="rss" size={17} />
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:gap-x-10 lg:contents">
        {
          footerColumns.map((col) => (
            <div>
              <h2 class="font-mono text-[0.72rem] font-medium tracking-[0.18em] text-dim uppercase">
                {col.heading}
              </h2>
              <ul class="mt-4 grid gap-2.5">
                {col.links.map((l) => (
                  <li>
                    <a
                      href={u(l.href)}
                      data-tip={l.tip}
                      class="inline-flex items-center text-[0.95rem] text-dim transition-colors hover:text-accent-ink"
                    >
                      {l.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-line pt-6 text-[0.85rem] text-dim sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {year} Noah Weidig
        <span class="mx-1.5 text-faint">·</span>
        <a class="hover:text-accent-ink" href={u('/privacy/')}>Privacy</a>
        <span class="mx-1.5 text-faint">·</span>
        <a class="hover:text-accent-ink" href={u('/styleguide/')}>Styleguide</a>
      </p>
      <p>
        Built with <a
          class="underline underline-offset-2 hover:text-accent-ink"
          href="https://astro.build"
          target="_blank"
          rel="noopener">Astro</a
        >
      </p>
    </div>
  </div>
</footer>

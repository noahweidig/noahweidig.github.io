---
import { u } from '../lib/url';
import { footerColumns, socials, site } from '../lib/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer
  data-pagefind-ignore
  data-site-footer
  class="footer-dark relative mt-28 border-t border-line bg-bg-deep pt-28 sm:pt-40"
>
  <div class="w-full px-5 pb-16 sm:px-8 lg:px-16">
    <div class="px-6 py-8 sm:px-10 sm:py-10">
      <div class="grid gap-10 sm:gap-8 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
        <div class="flex flex-col items-center text-center sm:items-start sm:text-left">
          <a href={u('/')} class="group flex items-center gap-2.5">
            <Logo class="wordmark-icon h-8 w-auto" />
            <span data-text="Noah Weidig" class="wordmark-wipe font-display text-xl"
              >Noah Weidig</span
            >
          </a>
          <p class="mt-3 text-body-lg text-dim">{site.role}</p>
          <div class="mt-5 grid w-fit grid-cols-3 gap-2">
            {
              socials.map((s) => (
                <a
                  href={s.href}
                  aria-label={`${s.label} (opens in a new tab)`}
                  data-tip={`${s.label} profile`}
                  target="_blank"
                  rel="noopener"
                  class="icon-tile"
                >
                  <Icon name={s.icon} size={17} />
                </a>
              ))
            }
            <a
              href={u('/rss.xml')}
              aria-label="RSS Feed"
              data-tip="Subscribe to the blog feed"
              class="icon-tile"
            >
              <Icon name="rss" size={17} />
            </a>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:gap-x-10 lg:contents">
          {
            footerColumns.map((col) => (
              <div>
                <h2 class="font-mono text-caption font-medium tracking-[0.18em] text-dim uppercase">
                  {col.heading}
                </h2>
                <ul class="mt-4 grid gap-2.5">
                  {col.links.map((l) => {
                    const external = /^https?:\/\//.test(l.href);
                    return (
                      <li>
                        <a
                          href={external ? l.href : u(l.href)}
                          data-tip={l.tip}
                          target={external ? '_blank' : undefined}
                          rel={external ? 'noopener' : undefined}
                          class="inline-flex items-center text-body-lg text-dim transition-colors hover:text-accent-ink"
                        >
                          {l.text}
                          {external && <span class="sr-only-nw"> (opens in a new tab)</span>}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="mt-14 flex flex-col items-center gap-3 border-t border-line pt-6 text-center text-[0.85rem] text-dim sm:flex-row sm:items-center sm:justify-between sm:text-left"
      >
        <p>
          © {year} Noah Weidig
          <span class="mx-1.5 text-faint">·</span>
          <a class="hover:text-accent-ink" href={u('/privacy/')}>Privacy Policy</a>
          <span class="mx-1.5 text-faint">·</span>
          <a class="hover:text-accent-ink" href={u('/terms/')}>Terms &amp; Conditions</a>
          <span class="mx-1.5 text-faint">·</span>
          <a class="hover:text-accent-ink" href={u('/styleguide/')}>Styleguide</a>
        </p>
        <div class="flex items-center gap-2">
          <span class="font-mono text-caption tracking-[0.12em] text-faint uppercase">Sitemap</span>
          <a
            href={u('/sitemap-0.xml')}
            data-tip="XML sitemap for crawlers"
            class="rounded border border-line px-2 py-1 font-mono text-caption text-dim transition-colors hover:border-accent-ink hover:text-accent-ink"
            >.xml</a
          >
          <a
            href={u('/sitemap.md')}
            data-tip="Markdown sitemap for humans and LLMs"
            class="rounded border border-line px-2 py-1 font-mono text-caption text-dim transition-colors hover:border-accent-ink hover:text-accent-ink"
            >.md</a
          >
          <a
            href={u('/llms.txt')}
            data-tip="Short site guide for AI agents"
            class="rounded border border-line px-2 py-1 font-mono text-caption text-dim transition-colors hover:border-accent-ink hover:text-accent-ink"
            >llms.txt</a
          >
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Footer stays on the dark palette regardless of site theme, for a
     consistent, premium look — overriding the theme tokens locally means
     every existing text-dim/text-faint/border-line/hover:text-accent-ink
     utility below just works without a separate light-mode override. */
  .footer-dark {
    --c-bg: #07080b;
    --c-bg-deep: #040507;
    --c-surface: #0c0e13;
    --c-raised: #11141b;
    --c-line: #1c202a;
    --c-line-strong: #2a303d;
    --c-ink: #e9ecf2;
    --c-dim: #99a1b1;
    --c-faint: #7c8494;
    --c-accent: #3d86ff;
    --c-accent-ink: #6ba4ff;
    --c-accent-contrast: #040507;
    color: var(--c-ink);
  }
</style>

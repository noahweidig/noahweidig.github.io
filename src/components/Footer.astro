---
import { u } from '../lib/url';
import { footerColumns, socials, site } from '../lib/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer
  data-pagefind-ignore
  data-site-footer
  class="relative mt-28 overflow-hidden border-t border-line bg-bg-deep pt-28 sm:pt-40"
>
  <div class="footer-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="shell pb-16">
    <div
      class="footer-card rounded-xl border px-6 py-8 backdrop-blur-[24px] backdrop-saturate-[1.4] sm:px-10 sm:py-10"
    >
      <div class="grid gap-10 sm:gap-8 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
        <div>
          <a href={u('/')} class="flex items-center gap-2.5">
            <Logo class="h-8 w-auto" />
            <span class="font-display text-xl">Noah Weidig</span>
          </a>
          <p class="mt-3 text-body-lg text-dim">{site.role}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {
              socials.map((s) => (
                <a
                  href={s.href}
                  aria-label={`${s.label} (opens in a new tab)`}
                  data-tip={`${s.label} profile`}
                  target="_blank"
                  rel="noopener"
                  class="icon-tile"
                >
                  <Icon name={s.icon} size={17} />
                </a>
              ))
            }
            <a
              href={u('/rss.xml')}
              aria-label="RSS Feed"
              data-tip="Subscribe to the blog feed"
              class="icon-tile"
            >
              <Icon name="rss" size={17} />
            </a>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:gap-x-10 lg:contents">
          {
            footerColumns.map((col) => (
              <div>
                <h2 class="font-mono text-caption font-medium tracking-[0.18em] text-dim uppercase">
                  {col.heading}
                </h2>
                <ul class="mt-4 grid gap-2.5">
                  {col.links.map((l) => {
                    const external = /^https?:\/\//.test(l.href);
                    return (
                      <li>
                        <a
                          href={external ? l.href : u(l.href)}
                          data-tip={l.tip}
                          target={external ? '_blank' : undefined}
                          rel={external ? 'noopener' : undefined}
                          class="inline-flex items-center text-body-lg text-dim transition-colors hover:text-accent-ink"
                        >
                          {l.text}
                          {external && <span class="sr-only-nw"> (opens in a new tab)</span>}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="mt-14 flex flex-col gap-3 border-t border-line pt-6 text-[0.85rem] text-dim sm:flex-row sm:items-center sm:justify-between"
      >
        <p>
          © {year} Noah Weidig
          <span class="mx-1.5 text-faint">·</span>
          <a class="hover:text-accent-ink" href={u('/privacy/')}>Privacy</a>
          <span class="mx-1.5 text-faint">·</span>
          <a class="hover:text-accent-ink" href={u('/styleguide/')}>Styleguide</a>
        </p>
        <div class="flex items-center gap-2">
          <span class="font-mono text-caption tracking-[0.12em] text-faint uppercase">Sitemap</span>
          <a
            href={u('/sitemap-0.xml')}
            data-tip="XML sitemap for crawlers"
            class="rounded border border-line px-2 py-1 font-mono text-caption text-dim transition-colors hover:border-accent-ink hover:text-accent-ink"
            >.xml</a
          >
          <a
            href={u('/sitemap.md')}
            data-tip="Markdown sitemap for humans and LLMs"
            class="rounded border border-line px-2 py-1 font-mono text-caption text-dim transition-colors hover:border-accent-ink hover:text-accent-ink"
            >.md</a
          >
          <a
            href={u('/llms.txt')}
            data-tip="Short site guide for AI agents"
            class="rounded border border-line px-2 py-1 font-mono text-caption text-dim transition-colors hover:border-accent-ink hover:text-accent-ink"
            >llms.txt</a
          >
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Warm accent/violet field echoing the site's own hero gradients, strongest
     at the very bottom of the page and fading to nothing above the card —
     replaces the topo texture that used to sit behind this section. */
  .footer-glow {
    background: linear-gradient(
      to top,
      color-mix(in oklab, var(--c-accent) 42%, transparent) 0%,
      color-mix(in oklab, var(--c-violet) 26%, transparent) 22%,
      color-mix(in oklab, var(--c-accent) 10%, transparent) 45%,
      transparent 80%
    );
  }
  :root[data-theme='light'] .footer-glow {
    background: linear-gradient(
      to top,
      color-mix(in oklab, var(--c-accent) 30%, transparent) 0%,
      color-mix(in oklab, var(--c-violet) 18%, transparent) 22%,
      color-mix(in oklab, var(--c-accent) 7%, transparent) 45%,
      transparent 80%
    );
  }

  .footer-card {
    background: color-mix(in oklab, var(--c-surface) 55%, transparent);
    border-color: rgb(255 255 255 / 0.1);
    box-shadow: var(--shadow-card);
  }
  :root[data-theme='light'] .footer-card {
    border-color: rgb(255 255 255 / 0.6);
  }
</style>

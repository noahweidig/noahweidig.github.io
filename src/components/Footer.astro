---
import { u } from '../lib/url';
import { footerColumns, socials, site } from '../lib/site';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer
  data-pagefind-ignore
  data-site-footer
  class="relative mt-28 overflow-hidden border-t border-line bg-bg-deep"
>
  <div class="topo-bg absolute inset-0" aria-hidden="true"></div>
  <div class="shell relative py-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
      <div>
        <a href={u('/')} class="flex items-center gap-2.5">
          <img src={u('/media/logo.svg')} alt="" width="920" height="1079" class="h-8 w-auto" />
          <span class="font-display text-xl">Noah Weidig</span>
        </a>
        <p class="mt-3 text-sm text-dim">{site.role}</p>
        <div class="mt-5 flex gap-2">
          {
            socials.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                target="_blank"
                rel="noopener"
                class="grid h-9 w-9 place-items-center rounded-full border border-line text-dim transition-all duration-200 hover:-translate-y-0.5 hover:border-accent hover:text-accent-ink"
              >
                <Icon name={s.icon} size={17} />
              </a>
            ))
          }
          <a
            href={u('/rss.xml')}
            aria-label="RSS Feed"
            class="grid h-9 w-9 place-items-center rounded-full border border-line text-dim transition-all duration-200 hover:-translate-y-0.5 hover:border-accent hover:text-accent-ink"
          >
            <Icon name="rss" size={17} />
          </a>
        </div>
      </div>

      {
        footerColumns.map((col) => (
          <div>
            <h2 class="font-mono text-[0.68rem] font-medium tracking-[0.18em] text-faint uppercase">
              {col.heading}
            </h2>
            <ul class="mt-4 grid gap-2.5">
              {col.links.map((l) => (
                <li>
                  <a
                    href={u(l.href)}
                    class="group inline-flex items-center gap-2 text-sm text-dim transition-colors hover:text-ink"
                  >
                    <Icon
                      name={l.icon}
                      size={15}
                      class="text-faint transition-colors group-hover:text-accent-ink"
                    />
                    {l.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-line pt-6 text-xs text-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {year} Noah Weidig · <a class="hover:text-ink" href={u('/privacy/')}>Privacy</a> ·
        <a class="hover:text-ink" href={u('/styleguide/')}>Styleguide</a>
      </p>
      <p>
        Built with <a
          class="text-dim underline underline-offset-2 hover:text-accent-ink"
          href="https://astro.build"
          target="_blank"
          rel="noopener">Astro</a
        >
      </p>
    </div>
  </div>
</footer>

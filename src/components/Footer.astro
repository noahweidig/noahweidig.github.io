---
import { navGroups, socials } from '../lib/site';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import NewsletterForm from './NewsletterForm.astro';
const year = new Date().getFullYear();
type Link = { text: string; href: string; tip?: string; external?: boolean };
const extra: Record<string, Link[]> = {
  Work: [{ text: 'Tech stack', href: '/tech/' }],
  Writing: [
    { text: 'Tags', href: '/tags/' },
    { text: 'AI', href: '/ai/' },
  ],
};
const columns: { text: string; items: Link[] }[] = [
  ...navGroups.map((g) => ({ text: g.text, items: [...g.items, ...(extra[g.text] ?? [])] })),
  {
    text: 'More',
    items: [
      { text: 'Contact', href: '/contact/' },
      { text: 'Privacy', href: '/privacy/' },
      { text: 'Terms', href: '/terms/' },
      { text: 'Style', href: '/styleguide/' },
    ],
  },
];
const iconBtn =
  'grid size-9 place-items-center rounded-full border border-line-strong text-dim transition-colors hover:border-accent hover:bg-accent hover:text-accent-contrast';
---

<footer data-pagefind-ignore data-site-footer class="relative mt-28 bg-bg-deep text-ink">
  <div class="footer-rule" aria-hidden="true"></div>
  <div class="w-full px-5 sm:px-6 lg:px-8">
    <div class="py-10">
      <div class="flex flex-col gap-10 lg:flex-row lg:justify-between">
        <div class="flex flex-col items-center gap-6 text-center sm:items-start sm:text-left">
          <a
            href="/"
            data-tip="Noah Weidig — back to the home page"
            class="group inline-flex shrink-0 items-center gap-2.5"
          >
            <Wordmark class="text-2xl" />
          </a>
          <p class="footer-dim max-w-xs text-body-lg leading-relaxed">
            Spatial analysis and applied AI for wildfire risk, land-use change and conservation.
          </p>
          <div class="flex w-full min-w-0 flex-col items-center gap-2 sm:items-start">
            <span class="footer-ink text-sm font-medium">Subscribe to my newsletter</span>
            <NewsletterForm />
          </div>
        </div>

        <nav
          aria-label="Footer"
          class="grid grid-cols-[repeat(2,auto)] justify-center gap-x-16 gap-y-8 sm:grid-cols-4 sm:justify-start sm:gap-x-10 lg:gap-x-14"
        >
          {columns.map((col) => (
            <div>
              <p class="font-mono text-xs font-medium tracking-[0.06em] text-accent-ink uppercase">
                {col.text}
              </p>
              <ul class="mt-3 flex flex-col gap-2">
                {col.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      data-tip={item.tip}
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener' : undefined}
                      class="footer-dim text-small transition-colors hover:text-ink"
                    >
                      {item.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>

      <div class="mt-16 flex flex-col items-center gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-col items-center gap-2 text-small text-dim sm:flex-row sm:flex-wrap">
          <span>© {year} Noah Weidig</span>
          <span class="mx-1 hidden text-faint sm:inline" aria-hidden="true">
            ·
          </span>
          <div class="flex flex-wrap items-center justify-center gap-2">
            <span class="text-xs font-medium text-faint">Sitemap</span>
            <a
              href="/sitemap-0.xml"
              data-tip="XML sitemap for crawlers"
              class="chip chip-link footer-dim"
            >
              .xml
            </a>
            <a
              href="/sitemap.md"
              data-tip="Markdown sitemap for humans and LLMs"
              class="chip chip-link footer-dim"
            >
              .md
            </a>
            <a
              href="/llms.txt"
              data-tip="Short site guide for AI agents"
              class="chip chip-link footer-dim"
            >
              llms.txt
            </a>
          </div>
        </div>
        <div class="flex items-center gap-2">
          {socials.map((s) => (
            <a
              href={s.href}
              aria-label={`${s.label} (opens in a new tab)`}
              data-tip={`${s.label} profile`}
              target="_blank"
              rel="noopener"
              class={iconBtn}
            >
              <Icon name={s.icon} size={18} />
            </a>
          ))}
          <a
            href="/rss.xml"
            aria-label="RSS Feed"
            data-tip="Subscribe to the blog feed"
            class={iconBtn}
          >
            <Icon name="rss" size={18} stroke-width={1.6} />
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Blue rule across the top edge, fading out at both ends. */
  .footer-rule {
    height: 3px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--c-accent) 20%,
      var(--c-accent-ink) 50%,
      var(--c-accent) 80%,
      transparent
    );
  }
  /* Tailwind v4 puts every utility class (including hover: variants) inside
     `@layer utilities`, and an unlayered rule always outranks a layered one
     regardless of specificity — so these live in the same layer, or they'd
     make hover:text-accent-ink inert. :global() stops Astro from appending
     its own scoping attribute (which would inflate specificity unpredictably
     and risk winning anyway); a plain single class reliably loses to any
     `:hover`/`:focus-visible` variant, which is what lets the hover color
     still take over. These are a deliberate replacement for text-ink/
     text-dim in the footer, not a fallback layered on top of them — every
     footer link's color reaches it through one of these two classes, so
     contrast holds even where the shared stylesheet can't load (e.g. the
     axe-core file:// audit). */
  @layer utilities {
    :global(.footer-ink) {
      color: var(--c-ink);
    }
    :global(.footer-dim) {
      color: var(--c-dim);
    }
  }
</style>

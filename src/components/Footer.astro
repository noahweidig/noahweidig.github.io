---
import { navGroups, socials } from '../lib/site';
import { tintAt } from '../lib/tint';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import NewsletterForm from './NewsletterForm.astro';
const year = new Date().getFullYear();
type Link = { text: string; href: string; tip?: string; external?: boolean };
const extra: Record<string, Link[]> = {
  Work: [{ text: 'Tech stack', href: '/tech/' }],
  Writing: [
    { text: 'Tags', href: '/tags/' },
    { text: 'AI', href: '/ai/' },
  ],
};
const columns: { text: string; items: Link[] }[] = [
  ...navGroups.map((g) => ({ text: g.text, items: [...g.items, ...(extra[g.text] ?? [])] })),
  {
    text: 'More',
    items: [
      { text: 'Contact', href: '/contact/' },
      { text: 'Privacy Policy', href: '/privacy/' },
      { text: 'Terms & Conditions', href: '/terms/' },
      { text: 'Styleguide', href: '/styleguide/' },
    ],
  },
];
const iconBtn =
  'grid h-8 w-8 place-items-center rounded-sm transition-[filter] hover:brightness-95 dark:hover:brightness-125';
---

<footer
  data-pagefind-ignore
  data-site-footer
  class="relative mt-28 border-t border-line bg-bg-deep text-ink"
>
  <div class="w-full px-5 sm:px-6 lg:px-8">
    <div class="py-10">
      <div class="flex flex-col gap-10 lg:flex-row lg:justify-between">
        <div class="flex flex-col items-start gap-6">
          <a href="/" class="group inline-flex shrink-0 items-center gap-2.5">
            <Wordmark class="text-2xl" />
          </a>
          <div class="flex w-full min-w-0 flex-col items-start gap-2">
            <span class="footer-ink text-sm font-medium">Subscribe to my newsletter</span>
            <NewsletterForm />
          </div>
        </div>

        <nav
          aria-label="Footer"
          class="grid grid-cols-2 gap-x-10 gap-y-8 sm:grid-cols-4 lg:gap-x-14"
        >
          {columns.map((col) => (
            <div>
              <p class="text-xs font-medium text-faint">{col.text}</p>
              <ul class="mt-3 flex flex-col gap-2">
                {col.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      data-tip={item.tip}
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener' : undefined}
                      class="footer-dim text-small transition-colors hover:text-ink"
                    >
                      {item.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>

      <div class="mt-16 flex flex-col items-start gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap items-center gap-2 text-small text-dim">
          <span>© {year} Noah Weidig</span>
          <span class="mx-1 text-faint" aria-hidden="true">
            ·
          </span>
          <span class="text-xs font-medium text-faint">Sitemap</span>
          <a
            href="/sitemap-0.xml"
            data-tip="XML sitemap for crawlers"
            class="chip chip-link footer-dim"
          >
            .xml
          </a>
          <a
            href="/sitemap.md"
            data-tip="Markdown sitemap for humans and LLMs"
            class="chip chip-link footer-dim"
          >
            .md
          </a>
          <a
            href="/llms.txt"
            data-tip="Short site guide for AI agents"
            class="chip chip-link footer-dim"
          >
            llms.txt
          </a>
        </div>
        <div class="flex items-center gap-0.5">
          {socials.map((s, i) => (
            <a
              href={s.href}
              aria-label={`${s.label} (opens in a new tab)`}
              data-tip={`${s.label} profile`}
              target="_blank"
              rel="noopener"
              class={`${iconBtn} tile-${tintAt(i)}`}
            >
              <Icon name={s.icon} size={18} />
            </a>
          ))}
          <a
            href="/rss.xml"
            aria-label="RSS Feed"
            data-tip="Subscribe to the blog feed"
            class={`${iconBtn} tile-${tintAt(socials.length)}`}
          >
            <Icon name="rss" size={18} stroke-width={1.6} />
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Tailwind v4 puts every utility class (including hover: variants) inside
     `@layer utilities`, and an unlayered rule always outranks a layered one
     regardless of specificity — so these live in the same layer, or they'd
     make hover:text-accent-ink inert. :global() stops Astro from appending
     its own scoping attribute (which would inflate specificity unpredictably
     and risk winning anyway); a plain single class reliably loses to any
     `:hover`/`:focus-visible` variant, which is what lets the hover color
     still take over. These are a deliberate replacement for text-ink/
     text-dim in the footer, not a fallback layered on top of them — every
     footer link's color reaches it through one of these two classes, so
     contrast holds even where the shared stylesheet can't load (e.g. the
     axe-core file:// audit). */
  @layer utilities {
    :global(.footer-ink) {
      color: var(--c-ink);
    }
    :global(.footer-dim) {
      color: var(--c-dim);
    }
  }
</style>

---
/**
 * One responsive <img> for a blog cover. The site is light-only, so only the
 * light variant is rendered. Its URLs sit in `src`/`srcset` so the preload
 * scanner can start the fetch from the raw HTML.
 */
import { getImage } from 'astro:assets';

interface Props {
  light: ImageMetadata;
  widths: number[];
  sizes: string;
  alt: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { light, widths, sizes, alt, loading = 'lazy', class: className } = Astro.props;
const image = await getImage({ src: light, widths, sizes });
---

<img
  src={image.src}
  srcset={image.srcSet.attribute}
  sizes={sizes}
  alt={alt}
  width={image.attributes.width}
  height={image.attributes.height}
  loading={loading}
  decoding="async"
  class={className}
/>

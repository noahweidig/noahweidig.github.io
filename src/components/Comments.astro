---
import { giscus, site } from '../lib/site';

/** Giscus, mounted lazily and re-themed with the site toggle. Renders nothing
    until the repo and category ids are configured in src/lib/site.ts. */
const enabled = Boolean(giscus.repoId && giscus.categoryId);
---

{
  enabled && (
    <section data-comments data-pagefind-ignore class="no-print mt-4 border-t border-line pt-10">
      <h2 class="font-display text-xl">Comments</h2>
      <div
        class="mt-5"
        id="giscus-root"
        data-giscus={JSON.stringify(giscus)}
        data-theme-base={site.url}
      />
    </section>
  )
}

<script>
  function mountGiscus() {
    const root = document.getElementById('giscus-root');
    if (!root || root.dataset.mounted === 'true') return;
    let cfg: { repo: string; repoId: string; category: string; categoryId: string };
    try {
      cfg = JSON.parse(root.dataset.giscus ?? '');
    } catch {
      return;
    }
    root.dataset.mounted = 'true';
    const theme = giscusTheme(root);
    const s = document.createElement('script');
    s.src = 'https://giscus.app/client.js';
    s.async = true;
    s.crossOrigin = 'anonymous';
    Object.entries({
      'data-repo': cfg.repo,
      'data-repo-id': cfg.repoId,
      'data-category': cfg.category,
      'data-category-id': cfg.categoryId,
      'data-mapping': 'pathname',
      'data-reactions-enabled': '1',
      'data-emit-metadata': '0',
      'data-input-position': 'top',
      'data-theme': theme,
      'data-lang': 'en',
      'data-loading': 'lazy',
    }).forEach(([k, v]) => s.setAttribute(k, v));
    root.appendChild(s);
  }

  // giscus renders in a cross-origin iframe, so it cannot read the page's
  // custom properties. /giscus/{light,dark}.css restate the palette for it.
  // Those files only exist on the deployed origin, so local dev falls back to
  // the closest stock giscus themes.
  function giscusTheme(root: HTMLElement) {
    const mode = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    const base = root.dataset.themeBase;
    if (!base || /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname)) {
      return mode === 'light' ? 'light' : 'dark_dimmed';
    }
    return new URL(`/giscus/${mode}.css`, base).href;
  }

  function syncTheme() {
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    const root = document.getElementById('giscus-root');
    if (!frame?.contentWindow || !root) return;
    const theme = giscusTheme(root);
    frame.contentWindow.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
  }

  new MutationObserver(syncTheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });

  // Comments sit below the fold on every post; only fetch giscus.app's
  // client.js and iframe once the section is actually about to be seen,
  // mirroring the IntersectionObserver-gated loading used for the globe
  // and tech marquee elsewhere on the site.
  function observe() {
    const section = document.querySelector<HTMLElement>('[data-comments]');
    if (!section) return;
    if (!('IntersectionObserver' in window)) {
      mountGiscus();
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        mountGiscus();
      },
      { rootMargin: '200px 0px' },
    );
    io.observe(section);
  }

  observe();
  document.addEventListener('astro:page-load', observe);
</script>

---
// Posts directly to Substack's own subscribe endpoint instead of embedding
// their iframe widget, so the form can be styled to match the site instead
// of Substack's own chrome. The response is cross-origin (can't be read back
// into the page), so a real POST goes to a hidden same-page iframe — no
// navigation, no redirect — and the pill optimistically morphs to a
// green confirmation (same box, no layout shift) once it's sent, the same assumption Substack's own embed
// widget makes.
import Icon from './Icon.astro';

const substackUrl = 'https://noahweidig.substack.com';
const frameName = 'substack-newsletter-frame';
---

<div class="newsletter-form relative w-full max-w-full min-w-0 sm:w-auto" data-newsletter>
  <form
    action={`${substackUrl}/api/v1/free`}
    method="post"
    target={frameName}
    data-newsletter-form
    class="newsletter-pill confirm-morph h-[calc(2.5rem+2px)] w-full min-w-0 rounded-full border border-control sm:w-80"
  >
    <div class="confirm-face" data-newsletter-face>
      <label for="newsletter-email" class="sr-only-nw">
        Email address
      </label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        required
        placeholder="you@example.com"
        autocomplete="email"
        class="newsletter-input h-10 w-0 min-w-0 flex-1 rounded-full border-0 pr-2 pl-4 text-small text-ink focus-visible:outline-none"
      />
      <button
        type="submit"
        class="group btn btn-primary newsletter-submit m-1 h-8 shrink-0 rounded-full px-4 text-small"
      >
        Subscribe
        <Icon
          name="arrow"
          size={15}
          class="transition-transform duration-300 group-hover:translate-x-1"
        />
      </button>
    </div>
    <div class="confirm-done" data-newsletter-done role="status" aria-live="polite" inert>
      <div class="confirm-msg">
        <Icon name="check" size={16} stroke-width={2} />
        <span>Check your inbox to confirm</span>
      </div>
      <button
        type="button"
        class="confirm-redo"
        data-newsletter-redo
        aria-label="Subscribe another email"
      >
        <Icon name="rotate-ccw" size={15} stroke-width={2} />
      </button>
    </div>
  </form>
  <p class="mt-2 text-xs text-dim">No spam. Unsubscribe anytime.</p>
  <iframe name={frameName} hidden title="Newsletter subscription"></iframe>
</div>

<style>
  @layer components {
    .newsletter-form .newsletter-pill {
      background: var(--c-raised);
    }
    .newsletter-form .newsletter-pill:focus-within {
      border-color: var(--c-accent-ink);
      outline: 2px solid var(--c-accent);
      outline-offset: 2px;
    }
    .newsletter-form .newsletter-pill[data-state='sent'] {
      background: color-mix(in oklab, var(--c-moss) 10%, transparent);
      border-color: color-mix(in oklab, var(--c-moss) 60%, transparent);
      outline: none;
    }
    .newsletter-form .newsletter-input {
      background: var(--c-raised);
      color: var(--c-ink);
      /* iOS Safari zooms the page on focus when an input's font-size is under 16px; the site's text-body-lg (0.95rem) sits just below that. */
      font-size: max(1rem, var(--text-body-lg));
    }
    .newsletter-form .newsletter-input::placeholder {
      color: var(--c-dim);
    }
  }
</style>

<script>
  function bindNewsletterForms() {
    document.querySelectorAll<HTMLElement>('[data-newsletter]').forEach((root) => {
      const form = root.querySelector<HTMLFormElement>('[data-newsletter-form]');
      const face = root.querySelector<HTMLElement>('[data-newsletter-face]');
      const done = root.querySelector<HTMLElement>('[data-newsletter-done]');
      const redo = root.querySelector<HTMLElement>('[data-newsletter-redo]');
      if (!form || !face || !done || form.dataset.bound) return;
      form.dataset.bound = 'true';
      const show = (sent: boolean) => {
        form.dataset.state = sent ? 'sent' : '';
        face.inert = sent;
        done.inert = !sent;
      };
      form.addEventListener('submit', () => {
        // The POST still happens (target is the hidden iframe); this just
        // swaps the UI without waiting on a cross-origin response we can't read.
        show(true);
        setTimeout(() => redo?.focus(), 350);
      });
      redo?.addEventListener('click', () => {
        form.reset();
        show(false);
        form.querySelector<HTMLInputElement>('input[type="email"]')?.focus();
      });
    });
  }
  bindNewsletterForms();
</script>

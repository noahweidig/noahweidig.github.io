---
import Icon from './Icon.astro';

interface Props {
  layout?: 'grid' | 'stack';
  label: string;
}
const { layout = 'grid', label } = Astro.props;
---

<div class="hm-carousel" data-carousel>
  <div class:list={['hm-track', layout === 'grid' ? 'hm-grid' : 'hm-stack']} data-carousel-track>
    <slot />
  </div>
  <div class="hm-car-ctl">
    <button
      type="button"
      class="popup-plus carousel-btn"
      data-carousel-prev
      aria-label={`Previous ${label}`}
    >
      <span class="carousel-chev carousel-chev-prev">
        <Icon name="chevron" size={18} />
      </span>
    </button>
    <button
      type="button"
      class="popup-plus carousel-btn"
      data-carousel-next
      aria-label={`Next ${label}`}
    >
      <span class="carousel-chev carousel-chev-next">
        <Icon name="chevron" size={18} />
      </span>
    </button>
  </div>
</div>

---
import { allTools } from '../lib/tech';
---

<ul class="mt-10 flex flex-wrap gap-2" data-reveal>
  {allTools.map((t) => (
    <li class="tech-pill">
      <span
        class="tech-ic"
        style={`--tech-ic:url(/media/icons/tech/${t.icon}.svg)`}
        aria-hidden="true"
      ></span>
      {t.name}
    </li>
  ))}
</ul>

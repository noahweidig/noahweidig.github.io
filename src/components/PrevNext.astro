---
import Icon from './Icon.astro';

export interface Sibling {
  href: string;
  title: string;
}

interface Props {
  prev?: Sibling | null;
  next?: Sibling | null;
  label: string;
  /** Match the article text column: 'article' (46rem text beside a ToC) or 'body' (58rem). */
  width?: 'article' | 'body';
}
const { prev, next, label, width = 'body' } = Astro.props;
---

{(prev || next) && (
  <nav
    aria-label={`More ${label}`}
    class:list={['no-print border-t border-line', !next && 'hidden sm:block']}
    data-pagefind-ignore
  >
    <div
      class:list={[
        width === 'article' ? 'mx-auto w-full max-w-[50rem] px-5 md:px-8' : 'shell-body',
        'grid grid-cols-1 gap-4 py-6 sm:grid-cols-2',
      ]}
    >
      {prev ? (
        <a
          href={prev.href}
          data-tip-title={prev.title}
          data-tip={`Previous in ${label}`}
          class="card card-hover group hidden min-w-0 flex-col gap-2 px-5 py-5 sm:flex sm:px-6"
        >
          <span class="flex items-center gap-2 text-xs font-medium text-faint">
            <Icon
              name="arrow"
              size={15}
              class="rotate-180 transition-transform duration-300 group-hover:-translate-x-1"
            />
            Previous
          </span>
          <span
            data-truncate-words
            class="block w-full truncate font-display text-lg leading-snug transition-colors group-hover:text-accent-ink"
          >
            {prev.title}
          </span>
        </a>
      ) : (
        <div class="hidden sm:block" />
      )}

      {next && (
        <a
          href={next.href}
          data-tip-title={next.title}
          data-tip={`Next in ${label}`}
          class="card card-hover group flex min-w-0 flex-col items-end gap-2 px-5 py-5 text-right sm:px-6"
        >
          <span class="flex items-center gap-2 text-xs font-medium text-faint">
            Next
            <Icon
              name="arrow"
              size={15}
              class="transition-transform duration-300 group-hover:translate-x-1"
            />
          </span>
          <span
            data-truncate-words
            class="block w-full truncate font-display text-lg leading-snug transition-colors group-hover:text-accent-ink"
          >
            {next.title}
          </span>
        </a>
      )}
    </div>
  </nav>
)}

<script>
  import { initTruncateWords } from '../lib/truncate-words';
  document.addEventListener('astro:page-load', initTruncateWords);
</script>

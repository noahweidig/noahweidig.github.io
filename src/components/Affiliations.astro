---
import { u } from '../lib/url';
const orgs = [
  ['University of Florida', 'https://www.ufl.edu/', '/media/icons/custom/uf.svg'],
  [
    'USDA Agricultural Research Service',
    'https://www.ars.usda.gov/',
    '/media/icons/custom/ars.svg',
  ],
  ['USDA Forest Service', 'https://www.fs.usda.gov/', '/media/icons/custom/fs.svg'],
  ['University of Cincinnati', 'https://www.uc.edu/', '/media/icons/custom/uc.svg'],
  ['Northern Kentucky University', 'https://www.nku.edu/', '/media/icons/custom/nku.svg'],
  ['Student Conservation Association', 'https://thesca.org/', '/media/icons/custom/sca.svg'],
  [
    "Boone County Clerk's Office",
    'https://boonecountyclerk.ky.gov/',
    '/media/icons/custom/boone.svg',
  ],
  [
    'Garage Living',
    'https://www.garageliving.com/f/cincinnati',
    '/media/icons/custom/garage-living.svg',
  ],
  ['ECOS', 'https://www.instagram.com/nku_ecos/', '/media/icons/custom/ecos.svg'],
];
---

<div class="mt-12" id="affiliations" data-reveal>
  <p class="text-center font-mono text-[0.68rem] tracking-[0.18em] text-faint uppercase">
    Worked with
  </p>
  <div class="marquee mt-5" role="group" aria-label="Affiliations">
    <div class="marquee-track py-1" data-marquee>
      {
        orgs.map(([name, href, src]) => (
          <a href={href} target="_blank" rel="noopener" title={name} class="group/logo shrink-0">
            <img
              data-src={u(src!)}
              alt={name}
              width="140"
              height="48"
              loading="lazy"
              decoding="async"
              class="h-10 w-auto max-w-[9rem] object-contain opacity-45 grayscale transition duration-300 group-hover/logo:opacity-100 group-hover/logo:grayscale-0 dark:hidden"
            />
            {/* Dark mode recolors via mask instead of filter: brightness-0/invert
                 chains render as solid black on some iOS Safari versions, so this
                 draws a plain currentColor silhouette instead. */}
            <span
              aria-hidden="true"
              data-mask-src={u(src!)}
              class="hidden h-10 w-[9rem] max-w-[9rem] bg-current opacity-55 transition duration-300 group-hover/logo:opacity-100 dark:block [mask-position:center] [mask-repeat:no-repeat] [mask-size:contain] [-webkit-mask-position:center] [-webkit-mask-repeat:no-repeat] [-webkit-mask-size:contain]"
            />
          </a>
        ))
      }
    </div>
  </div>
</div>

---
const orgs = [
  ['University of Florida', 'https://www.ufl.edu/'],
  ['USDA Agricultural Research Service', 'https://www.ars.usda.gov/'],
  ['USDA Forest Service', 'https://www.fs.usda.gov/'],
  ['University of Cincinnati', 'https://www.uc.edu/'],
  ['Northern Kentucky University', 'https://www.nku.edu/'],
  ['Student Conservation Association', 'https://thesca.org/'],
  ["Boone County Clerk's Office", 'https://boonecountyclerk.ky.gov/'],
  ['ECOS', 'https://www.instagram.com/nku_ecos/'],
];
---

<div class="mt-12" id="affiliations" data-reveal>
  <p class="text-center text-xs font-medium text-faint">Worked with</p>
  <ul class="mt-5 flex flex-wrap justify-center gap-2" aria-label="Institutions I have worked with">
    {orgs.map(([name, href]) => (
      <li>
        <a
          href={href}
          target="_blank"
          rel="noopener"
          aria-label={`${name} (opens in a new tab)`}
          class="pill pill-link"
        >
          {name}
        </a>
      </li>
    ))}
  </ul>
</div>

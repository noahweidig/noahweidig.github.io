---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { fullDate } from '../lib/format';

interface Props {
  entry: CollectionEntry<'blog'>;
  readingTime?: string;
  index?: number;
}
const { entry, readingTime, index = 0 } = Astro.props;
const { title, description, date, categories, image } = entry.data;
const alt = entry.data['image-alt'] ?? '';
---

<article
  class="card card-hover group flex flex-col overflow-hidden"
  data-cats={categories.join('|')}
  data-reveal
  style={`--reveal-delay:${Math.min(index, 5) * 60}ms`}
>
  {
    image && (
      <a
        href={`/blog/${entry.id}/`}
        tabindex="-1"
        aria-hidden="true"
        class="relative block aspect-16/9 overflow-hidden border-b border-line"
      >
        <Image
          src={image}
          alt={alt}
          widths={[400, 800, 1200]}
          sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
          loading={index < 2 ? 'eager' : 'lazy'}
          class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(.22,1,.36,1)] group-hover:scale-[1.04]"
        />
        {readingTime && (
          <span class="absolute right-3 bottom-3 chip bg-black/55 text-white backdrop-blur-md">
            {readingTime}
          </span>
        )}
      </a>
    )
  }
  <div class="flex flex-1 flex-col p-5">
    <div
      class="flex items-center gap-2 font-mono text-[0.7rem] tracking-[0.1em] text-faint uppercase"
    >
      <time datetime={date.toISOString()}>{fullDate(date)}</time>
      {
        !image && readingTime && (
          <>
            <>
              <span>·</span>
              <span>{readingTime}</span>
            </>
          </>
        )
      }
    </div>
    <h3 class="mt-2.5 text-xl leading-snug">
      <a href={`/blog/${entry.id}/`} class="transition-colors group-hover:text-accent-ink">
        {title}
      </a>
    </h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-dim line-clamp-4">{description}</p>
    <div class="mt-4 flex flex-wrap gap-1.5">
      {categories.map((c) => <span class="chip">{c}</span>)}
    </div>
  </div>
</article>

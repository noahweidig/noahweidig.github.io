---
import type { CollectionEntry } from 'astro:content';
import { fullDate, vtName } from '../lib/format';
import { tagIcon } from '../lib/tags';
import Icon from './Icon.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
  readingTime?: string;
  index?: number;
  cta?: boolean;
  reveal?: boolean;
  class?: string;
}
const { entry, readingTime, index = 0, reveal = true, class: cls } = Astro.props;
const { title, description, date, categories } = entry.data;
const icon = categories.map(tagIcon).find(Boolean) ?? 'file';
---

<article
  class:list={['card card-hover group relative flex flex-col overflow-hidden', cls]}
  data-cats={categories.join('|')}
  data-reveal={reveal ? '' : undefined}
  style={`--reveal-delay:${Math.min(index, 5) * 60}ms`}
>
  <a href={`/blog/${entry.id}/`} class="absolute inset-0 z-10" tabindex="-1" aria-hidden="true"></a>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-3">
      <span
        class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-line bg-raised text-accent-ink"
        aria-hidden="true"
      >
        <Icon name={icon} size={20} />
      </span>
      <div class="flex items-center gap-2 text-xs font-medium text-faint">
        <time datetime={date.toISOString()}>{fullDate(date)}</time>
        {readingTime && (
          <>
            <span>·</span>
            <span>{readingTime}</span>
          </>
        )}
      </div>
    </div>
    <h3 class="mt-2.5 text-xl leading-snug">
      <a
        href={`/blog/${entry.id}/`}
        class="relative z-20 transition-colors group-hover:text-accent-ink"
        style={`view-transition-name:${vtName(`/blog/${entry.id}`)}`}
      >
        {title}
      </a>
    </h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-dim line-clamp-4">{description}</p>
    <div class="mt-4 flex justify-end">
      <span
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-line bg-raised transition-colors group-hover:bg-accent group-hover:text-white"
        aria-hidden="true"
      >
        <Icon
          name="chevron"
          size={16}
          class="-rotate-90 transition-transform duration-300 group-hover:translate-x-0.5"
        />
      </span>
    </div>
  </div>
</article>

---
interface Props {
  name: string;
  icon: string;
  /** Category label under the name, and the key the /tech filter bar matches. */
  category?: string;
  class?: string;
}
const { name, icon, category, class: klass } = Astro.props;
---

<li class:list={['card card-hover tech-tile', klass]} data-cats={category}>
  <span
    class="tech-ic"
    style={`--tech-ic:url(/media/icons/tech/${icon}.svg)`}
    aria-hidden="true"
  ></span>
  <span class="text-sm leading-tight text-ink">{name}</span>
  {category && <span class="tech-tile-cat">{category}</span>}
</li>

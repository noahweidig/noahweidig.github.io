---
import { u } from '../lib/url';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  entry: CollectionEntry<'awards'>;
  index?: number;
  reveal?: boolean;
  class?: string;
}
const { entry, index = 0, reveal = true, class: cls } = Astro.props;
const d = entry.data;
---

<article
  class={cls}
  data-reveal={reveal ? '' : undefined}
  style={`--reveal-delay:${Math.min(index, 5) * 55}ms`}
>
  <a href={u(`/awards/${entry.id}/`)} class="relative block aspect-16/10 overflow-hidden bg-raised">
    {d.image && (
      <Image
        src={d.image}
        alt=""
        widths={[800, 1200]}
        sizes="(min-width: 768px) 608px, 92vw"
        loading={index === 0 ? 'eager' : 'lazy'}
        class="h-full w-full object-cover"
      />
    )}
    <span class="absolute bottom-3 left-3 max-w-[calc(100%-1.5rem)] rounded-3xl bg-white px-5 py-2.5 text-[0.95rem] leading-tight font-medium text-[#14161a] sm:bottom-4 sm:left-4 sm:px-5 sm:py-2.5 sm:text-[0.95rem]">
      {d.title}
    </span>
  </a>
</article>

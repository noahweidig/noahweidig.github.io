---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  entry: CollectionEntry<'awards'>;
  index?: number;
  reveal?: boolean;
  class?: string;
}
const { entry, index = 0, reveal = true, class: cls } = Astro.props;
const d = entry.data;
---

<article
  class={cls}
  data-reveal={reveal ? '' : undefined}
  style={`--reveal-delay:${Math.min(index, 5) * 55}ms`}
>
  <a
    href={`/awards/${entry.id}/`}
    class="relative block aspect-16/10 overflow-hidden border-2 border-line-strong bg-raised"
  >
    {d.image && (
      <Image
        src={d.image}
        alt=""
        widths={[800, 1200]}
        sizes="(min-width: 768px) 608px, 92vw"
        loading={index === 0 ? 'eager' : 'lazy'}
        class="h-full w-full object-cover"
      />
    )}
    <span class="card-badge">{d.title}</span>
  </a>
</article>

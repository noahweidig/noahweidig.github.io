---
import { Image } from 'astro:assets';
import { IMAGE_WIDTHS } from '../lib/images';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/research/*.webp', {
  eager: true,
});
const photoFor = (id: string) => photos[`../assets/research/${id}.webp`]?.default;

const areas = [
  {
    id: 'remote-sensing',
    tab: 'Remote Sensing',
    icon: 'satellite',
    eyebrow: 'Earth Observation',
    heading: 'Seeing change from orbit.',
    body: 'Multi-temporal satellite imagery turned into measurable change — classification, spectral indices, and time-series analysis at landscape scale in Google Earth Engine.',
    chips: ['Imagery Analysis', 'Google Earth Engine', 'Change Detection'],
    image: photoFor('remote-sensing'),
    alt: 'Earth and cloud cover seen from the International Space Station',
    caption: 'Earth from the ISS',
  },
  {
    id: 'land-use',
    tab: 'Land-Use Change',
    icon: 'layers',
    eyebrow: 'Social-Ecological Systems',
    heading: 'Where people and landscapes meet.',
    body: 'Modeling how development, disturbance, and policy reshape land cover, with a focus on wildfire risk in the wildland–urban interface.',
    chips: ['Land-Use Change', 'Wildfire & WUI', 'Risk Assessment'],
    image: photoFor('land-use'),
    alt: 'Wildfire burning on a hillside at night behind power-line towers',
    caption: 'Wildfire at the edge of infrastructure',
  },
  {
    id: 'spatial-stats',
    tab: 'Spatial Statistics',
    icon: 'chart',
    eyebrow: 'Statistical Modeling',
    heading: 'Uncertainty, stated honestly.',
    body: 'Bayesian and spatial-statistical models that quantify what the data actually support, in reproducible pipelines anyone can rerun.',
    chips: ['Bayesian Analysis', 'Forecasting', 'Reproducible Research'],
    image: photoFor('spatial-stats'),
    alt: 'Aerial view of crop fields in a geometric patchwork',
    caption: 'Fields from above',
  },
  {
    id: 'applied-ai',
    tab: 'Applied AI',
    icon: 'ai',
    eyebrow: 'Data Storytelling',
    heading: 'Models that reach a decision-maker.',
    body: 'Machine learning applied to ecological and geospatial problems, paired with visualization that makes the result legible to non-specialists.',
    chips: ['Machine Learning', 'Data Visualization', 'Quantitative Ecology'],
    image: photoFor('applied-ai'),
    alt: 'Aerial view of a river winding through rocky terrain',
    caption: 'A river, seen from above',
  },
  {
    id: 'biodiversity',
    tab: 'Biodiversity',
    icon: 'leaf',
    eyebrow: 'Conservation Monitoring',
    heading: 'Mapping what lives where.',
    body: 'Species distribution models and habitat mapping that turn scattered occurrence records into conservation-planning inputs.',
    chips: ['Species Distribution', 'Habitat Mapping', 'Conservation Planning'],
    image: photoFor('biodiversity'),
    alt: 'A stag with large antlers standing among trees',
    caption: 'A stag in its forest habitat',
  },
  {
    id: 'geo-engineering',
    tab: 'Geospatial Engineering',
    icon: 'database',
    eyebrow: 'Open Data & Tooling',
    heading: 'Infrastructure for spatial work.',
    body: 'Spatial databases, automated data pipelines, and open-source GIS tooling that keep analysis fast, current, and shareable.',
    chips: ['Spatial Databases', 'Data Pipelines', 'Open Source GIS'],
    image: photoFor('geo-engineering'),
    alt: 'A laptop showing source code in a dark room',
    caption: 'Code on screen',
  },
];
---

<div class="mt-10" data-tabs data-reveal>
  {/* Hidden until the tab script wires it up: with no JS every panel stays
      visible and the section reads as a stack rather than dead buttons. */}
  <div
    role="tablist"
    aria-label="Research areas"
    hidden
    class="pill-row flex flex-wrap gap-2 border-b border-line pb-5"
  >
    {areas.map((a, i) => (
      <button
        type="button"
        role="tab"
        id={`area-tab-${a.id}`}
        aria-controls={`area-panel-${a.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="pill"
      >
        {a.tab}
      </button>
    ))}
  </div>

  {areas.map((a) => (
    <div
      role="tabpanel"
      id={`area-panel-${a.id}`}
      aria-labelledby={`area-tab-${a.id}`}
      class="grid gap-8 pt-10 lg:grid-cols-2 lg:items-center lg:gap-14"
    >
      <div class="min-w-0">
        <p class="chip gap-2 px-3 py-1.5">{a.eyebrow}</p>
        <h3 class="mt-4 font-display text-[clamp(1.6rem,1.1rem+1.8vw,2.4rem)]">{a.heading}</h3>
        <p class="mt-4 text-lead leading-relaxed text-dim">{a.body}</p>
        <div class="mt-5 flex flex-wrap gap-1.5">
          {a.chips.map((c) => (
            <span class="chip">{c}</span>
          ))}
        </div>
      </div>
      <figure class="overflow-hidden rounded-md bg-card">
        <Image
          src={a.image}
          alt={a.alt}
          widths={IMAGE_WIDTHS.thumbnail}
          sizes="(min-width: 1024px) 560px, 92vw"
          loading="lazy"
          decoding="async"
          class="aspect-16/10 w-full object-cover"
        />
        <figcaption class="border-t border-line px-4 py-3 text-xs text-faint">
          {a.caption}
        </figcaption>
      </figure>
    </div>
  ))}
</div>

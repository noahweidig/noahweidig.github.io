---
import Icon from './Icon.astro';
import { socials } from '../lib/site';
import { tintAt } from '../lib/tint';

/* The word in "Real {x}." rolls through these, each in its own color. The first is
   repeated at the end so the loop can snap back without a visible rewind. */
const words = [
  { text: 'insights', color: '--c-accent-ink' },
  { text: 'answers', color: '--c-moss' },
  { text: 'impact', color: '--c-violet' },
  { text: 'clarity', color: '--c-yellow-ink' },
  { text: 'action', color: '--c-red' },
];
const rows = [...words, words[0]!];
---

<section class="under-nav relative overflow-x-clip border-b border-line" id="hero" data-hero>
  <div class="shell relative pt-16 pb-16 text-center md:pt-18 md:pb-24 lg:pt-20 lg:pb-32">
    <h1 class="hero-title font-display font-bold">
      <span class="sr-only-nw">Spatial analysis. Real {words.map((w) => w.text).join(', ')}.</span>
      <span class="hero-line" aria-hidden="true" data-reveal>
        Spatial analysis.
      </span>
      <span
        class="hero-line hero-line-flex"
        aria-hidden="true"
        data-reveal
        style="--reveal-delay:70ms"
      >
        <span class="real">Real</span>
        <span class="roll" data-roll data-words={JSON.stringify(words.map((w) => w.color))}>
          <span class="roll-track" data-roll-track>
            {rows.map((w) => (
              <span>{w.text}</span>
            ))}
          </span>
        </span>
        <span>.</span>
      </span>
    </h1>

    <p class="lede mx-auto mt-8 max-w-xl text-center" data-reveal style="--reveal-delay:140ms">
      I turn satellite imagery, fire perimeters, and messy field data into models people can
      actually decide something with — mostly around wildfire risk in the wildland-urban interface.
    </p>

    <div
      class="mt-10 flex flex-wrap items-center justify-center gap-3"
      data-reveal
      style="--reveal-delay:200ms"
    >
      <a class="btn btn-primary hero-btn" href="#projects">
        View my work
        <Icon name="arrow" size={15} />
      </a>
      <a class="btn btn-ghost hero-btn" href="/contact/">
        Get in touch
        <Icon name="mail" size={15} />
      </a>
    </div>
    <div
      class="mt-8 flex flex-wrap items-center justify-center gap-3"
      data-reveal
      style="--reveal-delay:260ms"
    >
      {socials.map((s, i) => (
        <a
          href={s.href}
          aria-label={`${s.label} (opens in a new tab)`}
          data-tip={`${s.label} profile`}
          target="_blank"
          rel="noopener"
          class={`social tile-${tintAt(i)} grid size-12 place-items-center rounded-full sm:size-14`}
        >
          <Icon name={s.icon} size={26} />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Sized from the viewport so the longest line never wraps. */
  .hero-title {
    font-size: clamp(2rem, calc((100vw - 4rem) / 9.4), 6rem);
    line-height: 1.3;
    letter-spacing: -0.04em;
  }
  .hero-line {
    display: block;
    white-space: nowrap;
  }
  /* Flex items, so no stray whitespace can open a gap before the period. */
  .hero-line-flex {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.1em;
  }
  .hero-line-flex > span {
    display: block;
    height: 1.2em;
    line-height: 1.2;
  }
  .hero-line-flex > .real {
    margin-right: 0.26em;
  }
  /* The rolling pill: a clipped window onto a column of words. Fill and text
     follow the theme: a light wash with dark ink in light mode, a dark wash
     with bright ink in dark mode. */
  .roll {
    --tint: var(--c-accent-ink);
    display: inline-block;
    height: 1.2em;
    padding-inline: 0.38em;
    overflow: hidden;
    vertical-align: bottom;
    color: var(--tint);
    background: color-mix(in oklab, var(--tint) 18%, var(--c-surface));
    border-radius: var(--radius-pill);
    transition:
      width 0.6s var(--ease-out-soft),
      background-color 0.5s,
      color 0.5s;
  }
  .roll-track {
    display: flex;
    flex-direction: column;
    transition: transform 0.6s var(--ease-out-soft);
  }
  /* Each row clips its own glyphs so neighbors' ascenders and descenders never show. */
  .roll-track > span {
    display: block;
    height: 1.2em;
    overflow: hidden;
    line-height: 1.2;
    white-space: nowrap;
  }
  /* Grey at rest; each icon takes its tile color on hover or focus. The
     .tile-* class on the link only supplies --tint. */
  .social {
    background: var(--c-matte);
    color: var(--c-dim);
    transition:
      transform 0.25s var(--ease-out-soft),
      background-color 0.2s,
      color 0.2s;
  }
  .social:hover,
  .social:focus-visible {
    background: color-mix(in oklab, var(--tint) 16%, var(--c-surface));
    color: var(--tint);
  }
  .social:hover {
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .social,
    .roll,
    .roll-track {
      transition: none;
    }
  }
</style>

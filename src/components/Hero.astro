---
import HeroMesh from './HeroMesh.astro';
import { u } from '../lib/url';
import Icon from './Icon.astro';
import { socials } from '../lib/site';

const typed = [
  'geospatial analyses',
  'remote sensing workflows',
  'data-driven insights',
  'GIS applications',
];

/* Raster values are computed at build time so the client ships static rects, no JS. */
const cells = Array.from({ length: 176 }, (_, i) => {
  const x = i % 16;
  const y = Math.floor(i / 16);
  const v =
    0.18 +
    Math.sin(x * 0.72) * Math.cos(y * 0.58) * 0.28 +
    Math.exp(-((x - 10) ** 2 + (y - 4) ** 2) / 14) * 0.5;
  return [x, y, Math.max(0.05, Math.min(0.82, v)).toFixed(2)] as const;
});
const nodes = [
  [116, 215],
  [254, 174],
  [386, 128],
  [208, 93],
  [404, 309],
  [492, 237],
];
/* Attribute rows: deterministic so the build is stable. */
const rows = Array.from({ length: 7 }, (_, i) => [
  `F${String(101 + i * 7).padStart(4, '0')}`,
  (0.21 + ((i * 37) % 61) / 100).toFixed(2),
  String(142 + ((i * 53) % 97)),
  (1.4 + ((i * 29) % 43) / 10).toFixed(1),
]);
const cols = [
  [12, 38, 0.1],
  [25, 65, 0.4],
  [39, 48, 0.7],
  [54, 82, 0.2],
  [70, 55, 0.9],
  [85, 72, 0.5],
];
---

<section class="under-nav relative overflow-x-clip border-b border-line" id="hero" data-hero>
  <HeroMesh />
  <div class="grid-bg absolute inset-0" aria-hidden="true"></div>

  <div class="shell relative grid items-center gap-12 py-16 md:py-24 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:py-28">
    <div class="text-center lg:text-left">
      <p class="kicker" data-reveal>
        {'GIS Analyst & Data Scientist'}
      </p>

      <h1
        class="display-1 mt-5 font-display leading-[1.1] font-bold"
        data-reveal
        style="--reveal-delay:70ms"
      >
        <span class="mx-auto block w-fit lg:mx-0">Spatial analysis.</span>
        <span class="mx-auto block w-fit text-inferno-b lg:mx-0">Real insights.</span>
      </h1>

      <p
        class="mt-6 flex min-h-[2.9em] max-[360px]:min-h-[4.4em] flex-wrap items-baseline justify-center gap-x-2 font-mono lg:min-h-0 lg:justify-start text-body-lg text-dim"
        data-reveal
        style="--reveal-delay:140ms"
      >
        <span>I build</span>
        <span class="text-accent-ink" data-typed={JSON.stringify(typed)} aria-hidden="true"></span>
        <span class="caret inline-block h-[1.05em] w-[2px] translate-y-[0.16em] bg-accent"></span>
        <span class="sr-only-nw">{typed.join(', ')}</span>
      </p>

      <p class="lede mx-auto mt-6 max-w-xl lg:mx-0" data-reveal style="--reveal-delay:200ms">
        I turn satellite imagery, fire perimeters, and messy field data into models people can
        actually decide something with — mostly around wildfire risk in the wildland-urban
        interface.
      </p>

      <div
        class="mt-8 flex flex-wrap items-center justify-center gap-3 lg:justify-start"
        data-reveal
        style="--reveal-delay:260ms"
      >
        <a class="btn btn-primary hero-btn" href="#projects">
          View my work
          <Icon name="arrow" size={15} />
        </a>
        <a class="btn btn-ghost hero-btn" href={u('/contact/')}>
          Get in touch
          <Icon name="mail" size={15} />
        </a>
      </div>

      <div
        class="mt-8 flex items-center justify-center gap-2 lg:justify-start"
        data-reveal
        style="--reveal-delay:320ms"
      >
        {socials.map((s) => (
          <a
            href={s.href}
            aria-label={`${s.label} (opens in a new tab)`}
            data-tip={`${s.label} profile`}
            target="_blank"
            rel="noopener"
            class="icon-tile icon-bare h-12 w-12"
          >
            <Icon name={s.icon} size={24} />
          </a>
        ))}
      </div>
    </div>

    <div
      class="geo relative order-first mx-auto mt-6 aspect-square w-full max-w-[17rem] sm:max-w-[22rem] lg:order-last lg:max-w-[30rem]"
      data-reveal
      data-geo
      style="--reveal-delay:160ms"
      aria-hidden="true"
    >
      <div class="geo-stage" data-geo-stage>
        <span class="geo-orbit geo-orbit-1"></span>
        <span class="geo-orbit geo-orbit-2"></span>
        <div class="geo-layer geo-l5">
          <table class="geo-table">
            <thead>
              <tr>
                <th>FID</th>
                <th>NDVI</th>
                <th>ELEV</th>
                <th>HA</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  {r.map((c) => (
                    <td>{c}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          <span class="geo-tag">05 / Attribute table</span>
        </div>
        <div class="geo-layer geo-l4">
          <div class="geo-tiles"></div>
          <span class="geo-tag">04 / Infrastructure</span>
        </div>
        <div class="geo-layer geo-l3">
          <svg class="geo-svg" viewBox="0 0 600 420" preserveAspectRatio="none">
            <g class="geo-vec">
              <path d="M30 281L116 215L183 239L254 174L332 203L386 128L476 151L569 77"></path>
              <path d="M54 105L138 141L208 93L284 127L351 69L431 106L532 48"></path>
              <path d="M89 380L165 307L251 344L325 271L404 309L492 237L579 260"></path>
              <path d="M98 35L128 109L105 183L151 255L128 337"></path>
              <path d="M235 12L262 83L240 161L285 234L253 405"></path>
              <path d="M401 9L380 96L421 180L390 259L438 400"></path>
            </g>
            <g class="geo-nodes">
              {nodes.map(([x, y]) => (
                <circle cx={x} cy={y} r="5"></circle>
              ))}
            </g>
          </svg>
          <span class="geo-tag">03 / Vector network</span>
        </div>
        <div class="geo-layer geo-l2">
          <svg class="geo-svg geo-contours" viewBox="0 0 600 420" preserveAspectRatio="none">
            <path d="M-20 275C59 217 99 310 172 263C237 222 240 126 330 140C415 154 407 245 495 225C551 212 576 167 630 180"></path>
            <path d="M-30 304C47 249 106 341 183 290C253 244 257 153 338 166C426 180 433 273 511 252C567 237 594 195 640 207"></path>
            <path d="M-20 334C74 280 120 371 199 318C272 270 283 188 354 196C440 206 452 304 530 278C581 261 605 226 640 231"></path>
            <path d="M42 206C100 163 137 214 191 180C245 145 247 75 319 76C385 77 412 143 472 126C519 113 539 73 595 91"></path>
            <path d="M82 139C130 106 160 143 208 112C255 81 275 35 329 37C383 38 404 82 455 69"></path>
            <path d="M71 380C121 351 151 402 213 370C277 337 300 276 366 286C421 295 457 355 526 323"></path>
          </svg>
          <span class="geo-tag">02 / Elevation contours</span>
        </div>
        <div class="geo-layer geo-l1">
          <svg class="geo-svg geo-raster" viewBox="0 0 16 11" preserveAspectRatio="none">
            {cells.map(([x, y, o]) => (
              <rect x={x + 0.06} y={y + 0.06} width=".88" height=".88" fill-opacity={o}></rect>
            ))}
          </svg>
          <span class="geo-scan"></span>
          <span class="geo-target"></span>
          <span class="geo-tag">01 / Multispectral raster</span>
        </div>
        <div class="geo-cols">
          {cols.map(([x, h, d]) => (
            <i style={`--x:${x}%;--h:${h}%;--d:${d}s`}></i>
          ))}
        </div>
      </div>
      <div class="geo-readout">
        <span class="geo-dot"></span>
        <span>
          <small>ACTIVE DATASET</small>
          <strong data-geo-name>MULTISPECTRAL / B08</strong>
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    new IntersectionObserver(([e]) => hero.classList.toggle('hero-off', !e.isIntersecting)).observe(
      hero,
    );
  }
  const v = document.querySelector<HTMLElement>('[data-geo]');
  const st = v?.querySelector<HTMLElement>('[data-geo-stage]');
  const nm = v?.querySelector<HTMLElement>('[data-geo-name]');
  if (v && st && nm) {
    const ds = [
      'MULTISPECTRAL / B08',
      'ELEVATION / DSM',
      'VECTOR / NETWORK',
      'ANOMALY / INDEX',
      'ATTRIBUTE / TABLE',
    ];
    new IntersectionObserver(([e]) => v.classList.toggle('geo-off', !e.isIntersecting)).observe(v);
    if (matchMedia('(pointer: fine)').matches) {
      let raf = 0;
      let cur = 0;
      /* Tilt follows the pointer directly (moves are already rAF-throttled, so a
         CSS transition only re-starts every frame). A short ease is applied on
         enter and a longer one on leave so the stage never snaps. */
      const ease = (ms: number) => {
        st.style.transition = `transform ${ms}ms ease-out`;
        setTimeout(() => (st.style.transition = ''), ms + 50);
      };
      v.addEventListener('pointerenter', () => ease(150));
      v.addEventListener('pointermove', (e) => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const r = v.getBoundingClientRect();
          const lx = (e.clientX - r.left) / r.width;
          const x = lx - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          st.style.transform = `translate(-50%,-50%) rotateX(${58 - y * 9}deg) rotateZ(${-32 + x * 8}deg)`;
          /* Only touch the text when the section changes: a write forces layout. */
          const i = Math.min(4, Math.max(0, Math.floor(lx * 5)));
          if (i !== cur) {
            cur = i;
            nm.textContent = ds[i];
          }
        });
      });
      v.addEventListener('pointerleave', () => {
        ease(400);
        st.style.transform = '';
        cur = 0;
        nm.textContent = ds[0];
      });
    }
  }
</script>

<style>
  /* Geospatial layer stack. Everything animates transform/opacity only, and
     animations pause while the hero is off screen (.geo-off). */
  .geo {
    --g: var(--c-accent);
    container-type: inline-size;
    perspective: 1500px;
  }
  /* Raised layers project up out of the box, so the stage sits low and small
     enough that the top layer clears the hero's overflow clip. */
  .geo-stage {
    position: absolute;
    top: 56%;
    left: 50%;
    width: 70%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%) rotateX(58deg) rotateZ(-32deg);
    transform-style: preserve-3d;
  }
  :global(:root:not([data-theme='light'])) .geo {
    --g: var(--c-accent-ink);
  }
  :global(:root:not([data-theme='light'])) .geo-layer {
    border-color: color-mix(in oklab, var(--g) 70%, transparent);
    box-shadow: 0 0 24px color-mix(in oklab, var(--g) 18%, transparent);
  }
  :global(:root:not([data-theme='light'])) .geo-l4,
  :global(:root:not([data-theme='light'])) .geo-l5 {
    opacity: 1;
  }
  .geo-layer {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in oklab, var(--g) 40%, transparent);
    background: color-mix(in oklab, var(--c-bg) 55%, transparent);
    transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .geo-layer::before,
  .geo-layer::after {
    position: absolute;
    width: 12px;
    height: 12px;
    content: '';
    border: 0 solid var(--g);
  }
  .geo-layer::before {
    top: -1px;
    left: -1px;
    border-width: 2px 0 0 2px;
  }
  .geo-layer::after {
    right: -1px;
    bottom: -1px;
    border-width: 0 2px 2px 0;
  }
  .geo-l1 {
    overflow: hidden;
    background: color-mix(in oklab, var(--g) 5%, var(--c-bg) 50%);
    transform: translateZ(34cqw);
  }
  .geo-l2 {
    overflow: hidden;
    transform: translateZ(22cqw);
  }
  .geo-l3 {
    transform: translateZ(9cqw);
  }
  .geo-l4 {
    opacity: 0.85;
    transform: translateZ(-3cqw);
  }
  .geo-l5 {
    opacity: 0.9;
    transform: translateZ(-15cqw);
  }
  .geo:hover .geo-l5 {
    transform: translateZ(-24cqw);
  }
  .geo-table {
    position: absolute;
    top: 16%;
    left: 6%;
    width: 88%;
    height: 78%;
    table-layout: fixed;
    border-collapse: collapse;
    color: var(--c-dim);
    font: 0.5rem/1 var(--font-mono, monospace);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .geo-table th {
    color: var(--g);
    font-weight: 500;
    letter-spacing: 0.1em;
  }
  .geo-table th,
  .geo-table td {
    padding: 0.35em 0.4em;
    border-bottom: 1px solid color-mix(in oklab, var(--g) 22%, transparent);
  }
  .geo-table :is(th, td):first-child {
    text-align: left;
  }
  .geo:hover .geo-l1 {
    transform: translateZ(40cqw);
  }
  .geo:hover .geo-l2 {
    transform: translateZ(24cqw);
  }
  .geo:hover .geo-l3 {
    transform: translateZ(7cqw);
  }
  .geo:hover .geo-l4 {
    transform: translateZ(-9cqw);
  }
  .geo-tag {
    position: absolute;
    top: 8px;
    left: 9px;
    padding: 4px 6px;
    border-left: 2px solid var(--g);
    background: color-mix(in oklab, var(--c-bg) 85%, transparent);
    color: var(--c-dim);
    font: 0.5rem/1 var(--font-mono, monospace);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .geo-tiles {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(color-mix(in oklab, var(--g) 32%, transparent) 1px, transparent 1px) 0 0 / 10%
        14%,
      linear-gradient(90deg, color-mix(in oklab, var(--g) 32%, transparent) 1px, transparent 1px) 0
        0 / 10% 14%;
  }
  .geo-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }
  .geo-vec path {
    stroke: var(--g);
    stroke-width: 1.6;
    stroke-dasharray: 8 8;
  }
  .geo-nodes circle {
    fill: var(--c-ink);
    stroke: var(--g);
    stroke-width: 3;
  }
  .geo-contours path {
    stroke: var(--g);
    stroke-width: 1.3;
  }
  .geo-contours path:nth-child(even) {
    stroke-opacity: 0.75;
  }
  .geo-raster {
    fill: var(--g);
    opacity: 0.45;
  }
  .geo-scan {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    border-left: 2px solid var(--g);
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--g) 8%, transparent),
      transparent 14%
    );
    transform: translateX(8%);
  }
  .geo-target {
    position: absolute;
    top: 34%;
    left: 61%;
    width: 46px;
    height: 46px;
    border: 1px solid var(--g);
    border-radius: 50%;
    background:
      linear-gradient(var(--g), var(--g)) center / 1px 100% no-repeat,
      linear-gradient(var(--g), var(--g)) center / 100% 1px no-repeat;
  }
  .geo-cols {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .geo-cols i {
    position: absolute;
    bottom: 10%;
    left: var(--x);
    width: 2px;
    height: var(--h);
    background: linear-gradient(to top, transparent, var(--g));
    transform: translateZ(37cqw);
    transform-origin: bottom;
  }
  .geo-orbit {
    position: absolute;
    inset: -15%;
    border: 1px dashed color-mix(in oklab, var(--g) 25%, transparent);
    border-radius: 50%;
  }
  .geo-orbit-2 {
    inset: -31%;
    border-style: solid;
    opacity: 0.4;
  }
  .geo-readout {
    contain: layout paint style;
    position: absolute;
    right: 0;
    bottom: 4%;
    display: flex;
    gap: 10px;
    align-items: center;
    min-width: 12rem;
    padding: 10px 13px;
    border: 1px solid var(--c-line);
    background: color-mix(in oklab, var(--c-bg) 85%, transparent);
    font-family: var(--font-mono, monospace);
  }
  .geo-readout span:last-child {
    display: grid;
    gap: 3px;
  }
  .geo-readout small {
    color: var(--c-dim);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
  }
  .geo-readout strong {
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.08em;
  }
  .geo-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--g);
  }
  @media (max-width: 639px) {
    .geo-readout,
    .geo-tag {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Only transform/opacity on HTML elements animate, so they stay on the
       compositor. Animating SVG strokes or opacity (dash flow, node pulse)
       repainted the SVG layers every frame, so those are static. */
    .geo-dot {
      animation: geo-pulse 2.4s ease-in-out infinite;
    }
    .geo-scan {
      animation: geo-scan 5s ease-in-out infinite alternate;
    }
    .geo-target {
      animation: geo-target 2.5s ease-in-out infinite;
    }
    .geo-cols i {
      animation: geo-col 2.8s var(--d) ease-in-out infinite alternate;
    }
    .geo-orbit-1 {
      animation: geo-spin 22s linear infinite;
    }
    .geo-off *,
    .hero-off .hero-blob,
    :global(html[data-menu-open]) :is(.hero-blob, .geo *) {
      animation-play-state: paused !important;
    }
  }
  @keyframes geo-pulse {
    50% {
      opacity: 0.35;
    }
  }
  @keyframes geo-scan {
    to {
      transform: translateX(88%);
    }
  }
  @keyframes geo-target {
    50% {
      opacity: 0.55;
      transform: scale(1.16);
    }
  }
  @keyframes geo-col {
    to {
      transform: translateZ(37cqw) scaleY(0.55);
    }
  }
  @keyframes geo-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hero-btn {
    width: 11.25rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.05s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>

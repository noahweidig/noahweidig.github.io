---
import { u } from '../lib/url';
import { Image } from 'astro:assets';
import portrait from '../assets/me.webp';
import { PORTRAIT_SIZES, PORTRAIT_WIDTHS } from '../lib/portrait';
import Icon from './Icon.astro';
import { socials } from '../lib/site';

const typed = [
  'geospatial analyses',
  'remote sensing workflows',
  'data-driven insights',
  'GIS applications',
];
---

<section
  class="relative -mt-14 overflow-hidden border-b border-line pt-14 md:-mt-16 md:pt-16"
  id="hero"
>
  {/* Three large, heavily blurred fields rather than one glow: the colour has
      to carry the section, and overlapping blurs are what give the soft
      mesh-like falloff. Sized in vw so the composition holds at any width. */}
  <div class="hero-mesh" aria-hidden="true">
    <span class="hero-blob hero-blob-1"></span>
    <span class="hero-blob hero-blob-2"></span>
    <span class="hero-blob hero-blob-3"></span>
    <span class="hero-blob hero-blob-4"></span>
    <span class="hero-blob hero-blob-5"></span>
  </div>
  {/* Readability scrim: the mesh at full strength put the copy on a bright
      field and the body text stopped clearing AA. This pulls the area behind
      the text back to near the page ground and leaves the bloom around it. */}
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="grid-bg absolute inset-0" aria-hidden="true"></div>

  <div class="shell relative grid items-center gap-12 py-16 md:py-24 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:py-28">
    <div class="text-center lg:text-left">
      <p class="kicker" data-reveal>
        {'GIS Analyst & Data Scientist'}
      </p>

      <h1
        class="display-1 mt-5 font-display leading-[1.1] font-bold"
        data-reveal
        style="--reveal-delay:70ms"
      >
        <span class="block">Spatial analysis.</span>
        <span class="block text-gradient">Real insights.</span>
      </h1>

      <p
        class="mt-6 flex min-h-[2.9em] max-[360px]:min-h-[4.4em] flex-wrap items-baseline justify-center gap-x-2 font-mono lg:min-h-0 lg:justify-start text-body-lg text-dim"
        data-reveal
        style="--reveal-delay:140ms"
      >
        <span>I build</span>
        <span class="text-accent-ink" data-typed={JSON.stringify(typed)} aria-hidden="true"></span>
        <span class="caret inline-block h-[1.05em] w-[2px] translate-y-[0.16em] bg-accent"></span>
        <span class="sr-only-nw">{typed.join(', ')}</span>
      </p>

      <p class="lede mx-auto mt-6 max-w-xl lg:mx-0" data-reveal style="--reveal-delay:200ms">
        I turn satellite imagery, fire perimeters, and messy field data into models people can
        actually decide something with — mostly around wildfire risk in the wildland-urban
        interface.
      </p>

      <div
        class="mt-8 flex flex-wrap items-center justify-center gap-3 lg:justify-start"
        data-reveal
        style="--reveal-delay:260ms"
      >
        <a class="btn btn-primary hero-btn" href="#projects">
          View my work
          <Icon name="arrow" size={15} />
        </a>
        <a class="btn btn-ghost hero-btn" href={u('/contact/')}>
          Get in touch
          <Icon name="mail" size={15} />
        </a>
      </div>

      <div
        class="mt-8 flex items-center justify-center gap-2 lg:justify-start"
        data-reveal
        style="--reveal-delay:320ms"
      >
        {socials.map((s) => (
          <a
            href={s.href}
            aria-label={`${s.label} (opens in a new tab)`}
            data-tip={`${s.label} profile`}
            target="_blank"
            rel="noopener"
            class="icon-tile h-12 w-12 rounded-[0.85rem]"
          >
            <Icon name={s.icon} size={24} />
          </a>
        ))}
      </div>
    </div>

    <div
      class="relative order-first mx-auto w-full max-w-[13rem] sm:max-w-[17rem] lg:order-last lg:max-w-md"
      data-reveal
      style="--reveal-delay:160ms"
    >
      <div class="portrait-frame relative aspect-square">
        <svg class="portrait-blob" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
          <path d="M.99 .552C.987 .595 .969 .639 .952 .678C.934 .717 .911 .753 .887 .786C.862 .818 .834 .848 .803 .874C.773 .899 .74 .922 .706 .94C.671 .957 .634 .971 .596 .98C.559 .988 .52 .991 .482 .99C.444 .989 .404 .987 .368 .976C.333 .965 .298 .945 .268 .923C.238 .901 .211 .874 .188 .846C.165 .818 .146 .787 .129 .756C.111 .725 .096 .693 .081 .659C.067 .625 .055 .591 .043 .552C.031 .513 .014 .47 .01 .426C.005 .381 0 .325 .016 .283C.033 .242 .068 .199 .107 .177C.147 .156 .208 .157 .253 .156C.299 .156 .343 .169 .381 .175C.419 .18 .45 .184 .482 .19C.514 .195 .543 .201 .574 .208C.605 .215 .634 .222 .667 .232C.699 .241 .733 .25 .77 .264C.806 .279 .851 .293 .885 .319C.919 .345 .956 .382 .973 .42C.991 .459 .994 .509 .99 .552Z"></path>
          <clipPath id="portrait-clip" clipPathUnits="objectBoundingBox">
            <rect width="1" height=".62"></rect>
            <path d="M.99 .552C.987 .595 .969 .639 .952 .678C.934 .717 .911 .753 .887 .786C.862 .818 .834 .848 .803 .874C.773 .899 .74 .922 .706 .94C.671 .957 .634 .971 .596 .98C.559 .988 .52 .991 .482 .99C.444 .989 .404 .987 .368 .976C.333 .965 .298 .945 .268 .923C.238 .901 .211 .874 .188 .846C.165 .818 .146 .787 .129 .756C.111 .725 .096 .693 .081 .659C.067 .625 .055 .591 .043 .552C.031 .513 .014 .47 .01 .426C.005 .381 0 .325 .016 .283C.033 .242 .068 .199 .107 .177C.147 .156 .208 .157 .253 .156C.299 .156 .343 .169 .381 .175C.419 .18 .45 .184 .482 .19C.514 .195 .543 .201 .574 .208C.605 .215 .634 .222 .667 .232C.699 .241 .733 .25 .77 .264C.806 .279 .851 .293 .885 .319C.919 .345 .956 .382 .973 .42C.991 .459 .994 .509 .99 .552Z"></path>
          </clipPath>
        </svg>
        <div class="portrait-clip">
          <Image
            src={portrait}
            alt="Noah Weidig"
            widths={PORTRAIT_WIDTHS}
            sizes={PORTRAIT_SIZES}
            loading="eager"
            fetchpriority="high"
            class="aspect-square w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    filter: blur(var(--hero-blur));
    opacity: var(--hero-opacity);
  }

  /* Positioned by centre and pulled back half its own size, so the bright core
     of each field lands inside the frame. Anchoring by edge put the cores off
     canvas and left only the falloff showing. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        118% 78% at 26% 58%,
        var(--c-bg) 0%,
        color-mix(in oklab, var(--c-bg) 82%, transparent) 38%,
        transparent 72%
      ),
      linear-gradient(to bottom, transparent 55%, var(--c-bg) 100%);
  }

  .hero-blob {
    position: absolute;
    display: block;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    /* Screen over the near-black ground is what makes these read as light rather than paint — overlapping fields add up instead of occluding. */
    mix-blend-mode: var(--hero-blend);
  }

  /* A plateau before the falloff: a bare closest-side gradient peaks at a
     single point and reads as a spotlight rather than a field of colour. */
  .hero-blob-1 {
    top: 26%;
    left: 14%;
    width: 92vw;
    height: 92vw;
    background: radial-gradient(
      circle at center,
      var(--hero-1) 0%,
      var(--hero-1) 30%,
      transparent 68%
    );
  }

  .hero-blob-2 {
    top: 16%;
    left: 88%;
    width: 86vw;
    height: 86vw;
    background: radial-gradient(
      circle at center,
      var(--hero-2) 0%,
      var(--hero-2) 28%,
      transparent 66%
    );
  }

  /* The seam between the two: without it they read as two separate lights
     rather than one field that changes hue across the section. */
  .hero-blob-3 {
    top: 92%;
    left: 52%;
    width: 88vw;
    height: 70vw;
    background: radial-gradient(
      circle at center,
      color-mix(in oklab, var(--hero-1) 55%, var(--hero-2)) 0%,
      color-mix(in oklab, var(--hero-1) 55%, var(--hero-2)) 26%,
      transparent 66%
    );
  }

  .hero-blob-4 {
    top: 78%;
    left: 84%;
    width: 70vw;
    height: 70vw;
    background: radial-gradient(
      circle at center,
      var(--hero-3) 0%,
      var(--hero-3) 26%,
      transparent 64%
    );
  }

  .hero-blob-5 {
    top: 50%;
    left: 55%;
    width: 60vw;
    height: 60vw;
    opacity: 0.55;
    background: radial-gradient(
      circle at center,
      var(--hero-4) 0%,
      var(--hero-4) 22%,
      transparent 62%
    );
  }

  @media (min-width: 1024px) {
    .hero-blob-5 {
      width: 38vw;
      height: 38vw;
    }
    .hero-blob-4 {
      width: 44vw;
      height: 44vw;
    }
    .hero-blob-1 {
      width: 62vw;
      height: 62vw;
    }
    .hero-blob-2 {
      width: 58vw;
      height: 58vw;
    }
    .hero-blob-3 {
      width: 60vw;
      height: 46vw;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-blob-1 {
      animation: drift-a 26s var(--ease-in-out-soft) infinite alternate;
    }
    .hero-blob-2 {
      animation: drift-b 32s var(--ease-in-out-soft) infinite alternate;
    }
    .hero-blob-3 {
      animation: drift-c 38s var(--ease-in-out-soft) infinite alternate;
    }
    .hero-blob-5 {
      animation: drift-c 30s var(--ease-in-out-soft) infinite alternate-reverse;
    }
    .hero-blob-4 {
      animation: drift-a 34s var(--ease-in-out-soft) infinite alternate-reverse;
    }
  }

  /* Transform only — animating the blur or the gradient would repaint the
     whole field every frame. The translate(-50%, -50%) has to be repeated in
     every keyframe or the blob snaps back to corner anchoring. */
  @keyframes drift-a {
    to {
      transform: translate(-50%, -50%) translate3d(5%, 7%, 0) scale(1.12);
    }
  }
  @keyframes drift-b {
    to {
      transform: translate(-50%, -50%) translate3d(-7%, 5%, 0) scale(1.08);
    }
  }
  @keyframes drift-c {
    to {
      transform: translate(-50%, -50%) translate3d(4%, -6%, 0) scale(1.14);
    }
  }

  /* Flat accent blob behind the cutout. The clip box shares the blob's bottom
     shape plus the band above it, so the head clears the blob. */
  .portrait-blob {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--c-accent);
  }
  .portrait-clip {
    position: absolute;
    inset: 0;
    clip-path: url(#portrait-clip);
  }

  .hero-btn {
    width: 11.25rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.05s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>

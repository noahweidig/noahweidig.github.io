---
import HeroIcons from './HeroIcons.astro';
import Icon from './Icon.astro';
import { socials } from '../lib/site';
---

<section class="under-nav relative overflow-x-clip border-b border-line" id="hero" data-hero>
  <div class="hero-glow" aria-hidden="true"></div>
  <HeroIcons />
  <div class="shell relative pt-16 pb-16 text-center md:pt-18 md:pb-24 lg:pt-20 lg:pb-32">
    <h1 class="hero-title font-display font-semibold">
      <span class="hero-line" data-reveal>
        Spatial analysis.
      </span>
      <span class="hero-line" data-reveal style="--reveal-delay:70ms">
        Real <span class="blue-grad">insights</span>.
      </span>
    </h1>

    <p class="lede mx-auto mt-8 max-w-xl text-center" data-reveal style="--reveal-delay:140ms">
      I turn satellite imagery, fire perimeters, and messy field data into models people can
      actually decide something with — mostly around wildfire risk in the wildland-urban interface.
    </p>

    <div
      class="mt-10 flex flex-wrap items-center justify-center gap-3"
      data-reveal
      style="--reveal-delay:200ms"
    >
      <a class="btn btn-primary hero-btn" href="#projects">
        View my work
        <Icon name="arrow" size={15} />
      </a>
      <a class="btn btn-ghost hero-btn" href="/contact/">
        Get in touch
        <Icon name="mail" size={15} />
      </a>
    </div>
    <div
      class="mt-8 flex flex-wrap items-center justify-center gap-2"
      data-reveal
      style="--reveal-delay:260ms"
    >
      {socials.map((s) => (
        <a
          href={s.href}
          aria-label={`${s.label} (opens in a new tab)`}
          data-tip={`${s.label} profile`}
          target="_blank"
          rel="noopener"
          class="social grid size-12 place-items-center rounded-full sm:size-14"
        >
          <Icon name={s.icon} size={26} />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Sized from the viewport so the longest line never wraps. */
  .hero-title {
    font-size: clamp(2rem, calc((100vw - 4rem) / 9.4), 6rem);
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  .hero-line {
    display: block;
    white-space: nowrap;
  }
  .hero-line + .hero-line {
    margin-top: 0.1em;
  }
  /* Same outline as the secondary button; fills blue on hover. */
  .social {
    border: 1px solid var(--c-line-strong);
    background: transparent;
    color: var(--c-ink);
    transition:
      background-color var(--dur-fast),
      border-color var(--dur-fast),
      color var(--dur-fast);
  }
  .social:hover,
  .social:focus-visible {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-accent-contrast);
  }
  @media (prefers-reduced-motion: reduce) {
    .social {
      transition: none;
    }
  }
</style>

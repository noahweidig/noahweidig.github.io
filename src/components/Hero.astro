---
import Icon from './Icon.astro';

/* The word in "Real {x}." rolls through these, each in its own color. The first is
   repeated at the end so the loop can snap back without a visible rewind. */
const words = [
  { text: 'insights', color: '--k-blue' },
  { text: 'answers', color: '--k-green' },
  { text: 'impact', color: '--k-purple' },
  { text: 'clarity', color: '--k-yellow' },
  { text: 'action', color: '--k-red' },
];
const rows = [...words, words[0]!];
---

<section class="under-nav relative overflow-x-clip border-b border-line" id="hero" data-hero>
  <div class="shell relative py-16 text-center md:py-24 lg:py-32">
    <h1 class="hero-title font-display font-bold">
      <span class="sr-only-nw">Spatial analysis. Real {words.map((w) => w.text).join(', ')}.</span>
      <span class="hero-line" aria-hidden="true" data-reveal>
        Spatial analysis.
      </span>
      <span class="hero-line" aria-hidden="true" data-reveal style="--reveal-delay:70ms">
        Real
        <span class="roll" data-roll data-words={JSON.stringify(words.map((w) => w.color))}>
          <span class="roll-track" data-roll-track>
            {rows.map((w) => (
              <span>{w.text}</span>
            ))}
          </span>
        </span>
        .
      </span>
    </h1>

    <p class="lede mx-auto mt-8 max-w-xl text-center" data-reveal style="--reveal-delay:140ms">
      I turn satellite imagery, fire perimeters, and messy field data into models people can
      actually decide something with — mostly around wildfire risk in the wildland-urban interface.
    </p>

    <div
      class="mt-10 flex flex-wrap items-center justify-center gap-3"
      data-reveal
      style="--reveal-delay:200ms"
    >
      <a class="btn btn-primary hero-btn" href="#projects">
        View my work
        <Icon name="arrow" size={15} />
      </a>
      <a class="btn btn-ghost hero-btn" href="/contact/">
        Get in touch
        <Icon name="mail" size={15} />
      </a>
    </div>
  </div>
</section>

<script>
  const roll = document.querySelector<HTMLElement>('[data-roll]');
  const track = document.querySelector<HTMLElement>('[data-roll-track]');
  if (roll && track) {
    const colors: string[] = JSON.parse(roll.dataset.words ?? '[]');
    const count = colors.length;
    let index = 0;
    let widths: number[] = [];

    const measure = () => {
      const style = getComputedStyle(roll);
      const pad = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
      widths = [...track.children].map((row) => {
        const probe = row.cloneNode(true) as HTMLElement;
        probe.style.cssText =
          'position:absolute;visibility:hidden;display:inline-block;height:auto;white-space:nowrap';
        track.appendChild(probe);
        const width = probe.getBoundingClientRect().width;
        track.removeChild(probe);
        return width + pad;
      });
    };
    const show = (n: number) => {
      const rowHeight = track.children[0]!.getBoundingClientRect().height;
      track.style.transform = `translateY(${-n * rowHeight}px)`;
      roll.style.width = `${widths[n]}px`;
      roll.style.setProperty('--tint', `var(${colors[n % count]})`);
    };
    /* After rolling onto the repeated first word, jump back to the real first row
       with no transition so the loop reads as continuous. */
    const snap = () => {
      track.style.transition = 'none';
      index = 0;
      show(0);
      void track.offsetHeight;
      track.style.transition = '';
    };
    const start = () => {
      measure();
      show(0);
    };
    (document.fonts?.ready ?? Promise.resolve()).then(start);
    addEventListener('resize', () => {
      measure();
      show(index);
    });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => {
        index += 1;
        show(index);
        if (index === count) setTimeout(snap, 680);
      }, 2200);
    }
  }
</script>

<style>
  /* Sized from the viewport so the longest line never wraps. */
  .hero-title {
    font-size: clamp(2rem, calc((100vw - 4rem) / 9.4), 8.2rem);
    line-height: 1.3;
    letter-spacing: -0.04em;
  }
  .hero-line {
    display: block;
    white-space: nowrap;
  }
  /* The rolling pill: a clipped window onto a column of words, always in the
     dark-theme color so its text keeps its contrast in both themes. */
  .roll {
    --tint: var(--k-blue);
    display: inline-block;
    height: 1.2em;
    padding-inline: 0.38em;
    overflow: hidden;
    vertical-align: bottom;
    color: var(--tint);
    background: color-mix(in oklab, var(--tint) 18%, var(--k-surface));
    border-radius: var(--radius-pill);
    transition:
      width 0.6s var(--ease-out-soft),
      background-color 0.5s,
      color 0.5s;
  }
  .roll-track {
    display: flex;
    flex-direction: column;
    transition: transform 0.6s var(--ease-out-soft);
  }
  /* Each row clips its own glyphs so neighbors' ascenders and descenders never show. */
  .roll-track > span {
    display: block;
    height: 1.2em;
    overflow: hidden;
    line-height: 1.2;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .roll,
    .roll-track {
      transition: none;
    }
  }
</style>

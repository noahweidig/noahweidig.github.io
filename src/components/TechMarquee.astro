---
import { u } from '../lib/url';
import Icon from './Icon.astro';
const tech = [
  ['R', '/media/icons/devicon/r-original.svg'],
  ['Python', '/media/icons/devicon/python-original.svg'],
  ['JavaScript', '/media/icons/devicon/javascript-original.svg'],
  ['SQL', '/media/icons/devicon/azuresqldatabase-original.svg'],
  ['Markdown', '/media/icons/devicon/markdown-original.svg'],
  ['LaTeX', '/media/icons/devicon/latex-original.svg'],
  ['HTML', '/media/icons/devicon/html5-original.svg'],
  ['CSS', '/media/icons/devicon/css3-original.svg'],
  ['Git', '/media/icons/devicon/git-original.svg'],
  ['GitHub', '/media/icons/devicon/github-original.svg'],
  ['Actions', '/media/icons/devicon/githubactions-original.svg'],
  ['Conda', '/media/icons/devicon/anaconda-original.svg'],
  ['tidyverse', '/media/icons/custom/tidyverse.svg'],
  ['pandas', '/media/icons/devicon/pandas-original.svg'],
  ['NumPy', '/media/icons/devicon/numpy-original.svg'],
  ['Plotly', '/media/icons/devicon/plotly-original.svg'],
  ['ArcGIS Pro', '/media/icons/custom/arcgis.svg'],
  ['GEE', '/media/icons/custom/gee.svg'],
  ['QGIS', '/media/icons/custom/qgis.svg'],
  ['GDAL', '/media/icons/custom/gdal.svg'],
  ['sf', '/media/icons/custom/sf.webp'],
  ['terra', '/media/icons/custom/terra.svg'],
  ['GeoPandas', '/media/icons/custom/geopandas.svg'],
  ['OSM', '/media/icons/custom/openstreetmap.svg'],
  ['Claude Code', '/media/icons/devicon/claude-code.svg'],
  ['Codex', '/media/icons/devicon/codex.svg'],
  ['Copilot', '/media/icons/devicon/copilot.svg'],
  ['Cursor', '/media/icons/devicon/cursor.svg'],
  ['Antigravity', '/media/icons/devicon/antigravity.svg'],
  ['Jules', '/media/icons/devicon/google-jules.svg'],
];
/* Some marks are pure black and vanish on the dark ground; invert those only. */
const invert = new Set(['Markdown', 'LaTeX', 'GitHub', 'pandas']);
/* Codex is pure white and vanishes on the light ground; invert only there. */
const lightInvert = new Set(['Codex']);
---

<div class="marquee mt-10" role="group" aria-label="Tech stack" data-reveal>
  <button
    type="button"
    data-marquee-toggle
    data-label="scrolling tech stack"
    aria-pressed="false"
    aria-label="Pause scrolling tech stack"
    class="icon-btn marquee-toggle"
  >
    <Icon name="pause" size={16} class="marquee-toggle-icon-pause" />
    <Icon name="play" size={16} class="marquee-toggle-icon-play" />
  </button>
  <div class="marquee-track py-2" data-marquee>
    {
      tech.map(([label, src]) => (
        <span class="flex shrink-0 items-center gap-2.5 text-sm text-dim">
          <img
            data-src={u(src!)}
            alt=""
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
            class:list={[
              'h-9 w-9 object-contain opacity-70 transition-opacity duration-300 hover:opacity-100',
              invert.has(label!) && 'dark:invert',
              lightInvert.has(label!) && 'invert dark:invert-0',
            ]}
          />
          <noscript>
            <img
              src={u(src!)}
              alt=""
              width="40"
              height="40"
              loading="lazy"
              decoding="async"
              class:list={[
                'h-9 w-9 object-contain opacity-70',
                invert.has(label!) && 'dark:invert',
                lightInvert.has(label!) && 'invert dark:invert-0',
              ]}
            />
          </noscript>
          {label}
        </span>
      ))
    }
  </div>
</div>

<script>
  function bindMarqueeToggles() {
    document.querySelectorAll<HTMLButtonElement>('[data-marquee-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const marquee = btn.closest('.marquee');
        const paused = marquee?.toggleAttribute('data-paused');
        btn.setAttribute('aria-pressed', String(!!paused));
        const label = btn.dataset.label ?? '';
        btn.setAttribute('aria-label', `${paused ? 'Play' : 'Pause'} ${label}`);
      });
    });
  }
  document.addEventListener('astro:page-load', bindMarqueeToggles);
</script>

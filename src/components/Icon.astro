---
/**
 * One icon component for the whole site.
 *
 * Non-brand marks are filled Fluent UI System Icons (MIT) and live in
 * `src/lib/icons.generated.ts` — regenerate them with
 * `node scripts/generate-icons.mjs`. Brand marks are the SVGs in
 * `public/uploads/`, inlined at build time so they can take `currentColor`.
 */
import { fluentIcons } from '../lib/icons.generated';
import { BRAND_ALIAS, brand } from '../lib/brand-icons';

interface Props {
  name: string;
  size?: number | string;
  class?: string;
}
const { name, size = 20, class: klass = '' } = Astro.props;

const mark = brand[BRAND_ALIAS[name] ?? name];
const glyph = mark ?? fluentIcons[name];
if (!glyph) {
  throw new Error(`Icon: unknown icon name "${name}"`);
}

/* Each icon's paths go into the page once, as a <symbol> on its first use;
   every later use is a <use> reference. Cuts ~60KB of repeated path data
   from the homepage. Astro.locals is per page render. */
const seen = ((Astro.locals as { icons?: Set<string> }).icons ??= new Set<string>());
const id = `i-${name}`;
const body = seen.has(id)
  ? `<use href="#${id}"/>`
  : `<symbol id="${id}" viewBox="${glyph.viewBox}">${glyph.body}</symbol><use href="#${id}"/>`;
seen.add(id);
---

<svg
  viewBox={glyph.viewBox}
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={klass}
  set:html={body}
/>

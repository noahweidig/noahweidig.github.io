/* Glyphs that are drawn as shapes rather than lines. A stroked version of any
   of these is unreadable at 16px. */
const FILLED = new Set(['bluesky']);
const filled = FILLED.has(name);

const d = P[name] ?? P.arrow;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={filled ? undefined : sw}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={klass}
  set:html={d}
/>

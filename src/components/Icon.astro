---
/**
 * One icon component for the whole site.
 *
 * Non-brand marks come from Lucide (ISC, lucide.dev) and live in
 * `src/lib/icons.generated.ts` — regenerate them with
 * `node scripts/generate-icons.mjs`. Brand marks are the SVGs in
 * `public/uploads/`, inlined at build time so they can take `currentColor`.
 */
import { lucideIcons } from '../lib/icons.generated';
import { BRAND_ALIAS, brand } from '../lib/brand-icons';

interface Props {
  name: string;
  size?: number | string;
  class?: string;
  'stroke-width'?: number;
}
const { name, size = 20, class: klass = '', 'stroke-width': sw = 1.6 } = Astro.props;

const mark = brand[BRAND_ALIAS[name] ?? name];
if (!mark && !lucideIcons[name]) {
  throw new Error(`Icon: unknown icon name "${name}"`);
}
const d = mark ? mark.body : lucideIcons[name]!;

/* Each icon's paths go into the page once, as a <symbol> on its first use;
   every later use is a <use> reference. Cuts ~60KB of repeated path data
   from the homepage. Astro.locals is per page render. */
const seen = ((Astro.locals as { icons?: Set<string> }).icons ??= new Set<string>());
const id = `i-${name}`;
const body = seen.has(id)
  ? `<use href="#${id}"/>`
  : `<symbol id="${id}" viewBox="${mark ? mark.viewBox : '0 0 24 24'}">${d}</symbol><use href="#${id}"/>`;
seen.add(id);
---

{mark ? (
  <svg
    viewBox={mark.viewBox}
    width={size}
    height={size}
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
    class={klass}
    set:html={body}
  />
) : (
  <svg
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width={sw}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    class={klass}
    set:html={body}
  />
)}

---
/**
 * One icon component for the whole site.
 *
 * Non-brand marks come from Lucide (ISC, lucide.dev) and live in
 * `src/lib/icons.generated.ts` — regenerate them with
 * `node scripts/generate-icons.mjs`. Brand marks are the rounded-square SVGs
 * in `public/uploads/`, inlined at build time so they can take `currentColor`.
 */
import { lucideIcons } from '../lib/icons.generated';

interface Props {
  name: string;
  size?: number | string;
  class?: string;
  'stroke-width'?: number;
}
const { name, size = 20, class: klass = '', 'stroke-width': sw = 1.6 } = Astro.props;

const brandFiles = import.meta.glob<string>('/public/uploads/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const BRAND_ALIAS: Record<string, string> = { x: 'x-twitter', twitter: 'x-twitter' };

const brand: Record<string, { viewBox: string; body: string }> = {};
for (const [path, raw] of Object.entries(brandFiles)) {
  const key = path
    .split('/')
    .pop()!
    .replace(/\.svg$/, '');
  const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 448 448';
  const body = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>[\s\S]*$/, '');
  brand[key] = { viewBox, body };
}

const mark = brand[BRAND_ALIAS[name] ?? name];
const d = mark ? mark.body : (lucideIcons[name] ?? lucideIcons.arrow!);
---

{
  mark ? (
    <svg
      viewBox={mark.viewBox}
      width={size}
      height={size}
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
      class={klass}
      set:html={d}
    />
  ) : (
    <svg
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width={sw}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      class={klass}
      set:html={d}
    />
  )
}

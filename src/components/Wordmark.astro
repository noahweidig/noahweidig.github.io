---
interface Props {
  class?: string;
  iconOnlyNarrow?: boolean;
}
const { class: cls = '', iconOnlyNarrow = false } = Astro.props;
---

<span class:list={['wm-lockup', { 'wm-icon-narrow': iconOnlyNarrow }, cls]}>
  <svg class="wm-mark" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M8.3 10a.7.7 0 0 1-.626-1.079L11.4 3a.7.7 0 0 1 1.198-.043L16.3 8.9a.7.7 0 0 1-.572 1.1Z"
      fill="var(--logo-yellow)"
      stroke="var(--logo-yellow)"
    ></path>
    <rect
      x="3"
      y="14"
      width="7"
      height="7"
      rx="1"
      fill="var(--logo-blue)"
      stroke="var(--logo-blue)"
    ></rect>
    <circle cx="17.5" cy="17.5" r="3.5" fill="var(--logo-red)" stroke="var(--logo-red)"></circle>
  </svg>
  <span class="sr-only">Noah Weidig — home</span>
  <span class="wm font-display" aria-hidden="true">
    <span>Noah</span>
    <span class="wm-last">Weidig</span>
  </span>
</span>

<style>
  /* Logo mark: Lucide's triangle, square and circle (the `shapes` icon), solid. */
  .wm-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .wm-mark {
    width: 1.55em;
    height: 1.55em;
    flex: none;
    stroke-width: 1.2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  /* Two-tone name, no tag: the surname sits one step lighter. */
  .wm {
    display: inline-flex;
    gap: 0.28em;
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--c-ink);
    white-space: nowrap;
  }
  .wm > .wm-last {
    font-weight: 500;
    color: var(--c-faint);
  }
  @media (max-width: 23.75rem) {
    .wm-icon-narrow .wm {
      display: none;
    }
  }
</style>

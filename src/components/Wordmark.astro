---
interface Props {
  class?: string;
  iconOnlyNarrow?: boolean;
}
const { class: cls = '', iconOnlyNarrow = false } = Astro.props;
---

<span class:list={['wm-lockup', { 'wm-icon-narrow': iconOnlyNarrow }, cls]}>
  <span class="sr-only">Noah Weidig — home</span>
  <span class="wm font-display" aria-hidden="true">
    <span>Noah</span>
    <span class="wm-last">Weidig</span>
  </span>
</span>

<style>
  .wm-lockup {
    display: inline-flex;
    align-items: center;
  }
  /* Condensed capitals; the surname takes the band's accent. */
  .wm {
    display: inline-flex;
    gap: 0.25em;
    font-weight: 900;
    font-variation-settings:
      'wdth' 64,
      'wght' 900;
    letter-spacing: 0;
    line-height: 1;
    text-transform: uppercase;
    color: var(--c-ink);
    white-space: nowrap;
  }
  .wm > .wm-last {
    color: var(--c-accent-ink);
  }
  @media (max-width: 23.75rem) {
    .wm-icon-narrow .wm {
      font-size: 0.9em;
    }
  }
</style>

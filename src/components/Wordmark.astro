---
interface Props {
  class?: string;
  iconOnlyNarrow?: boolean;
}
const { class: cls = '', iconOnlyNarrow = false } = Astro.props;
---

<span class:list={['wm-lockup', { 'wm-icon-narrow': iconOnlyNarrow }, cls]}>
  <svg class="wm-mark" viewBox="0 0 24 24" aria-hidden="true">
    <path pathLength="1" d="M21.54 15H17a2 2 0 0 0-2 2v4.54" />
    <path
      pathLength="1"
      d="M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17"
    />
    <path pathLength="1" d="M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05" />
    <circle pathLength="1" cx="12" cy="12" r="10" />
  </svg>
  <span class="sr-only">Noah Weidig — home</span>
  <span class="wm font-display" aria-hidden="true">
    <span>Noah</span>
    <span class="wm-last">
      Weidig
      <svg class="wm-hl" viewBox="0 0 120 16" preserveAspectRatio="none">
        <path d="M2 6C24 3 52 8 80 5S106 4 119 7" />
      </svg>
      <svg class="wm-hl wm-hl-b" viewBox="0 0 120 16" preserveAspectRatio="none">
        <path d="M117 11C92 14 62 9 36 12S12 11 3 13" />
      </svg>
    </span>
  </span>
</span>

<style>
  /* Logo mark: Lucide's `earth`, outlined in the logo blue. */
  .wm-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .wm-mark {
    width: 1.55em;
    height: 1.55em;
    flex: none;
    fill: none;
    stroke: var(--logo-blue);
    stroke-width: 2.2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  /* Two-tone name, no tag: the surname is in the accent color. */
  .wm {
    display: inline-flex;
    gap: 0.28em;
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--c-ink);
    white-space: nowrap;
  }
  .wm > .wm-last {
    position: relative;
    isolation: isolate;
    font-weight: 500;
    color: var(--c-accent-ink);
  }
  /* Marker swipe under the surname: two rough passes, wiped in on hover. */
  .wm-hl {
    position: absolute;
    left: -5%;
    width: 110%;
    top: 0.62em;
    height: 0.62em;
    z-index: -1;
    overflow: visible;
    pointer-events: none;
    fill: none;
    clip-path: inset(-20% 100% -20% 0);
    transition: clip-path 0.22s ease-in;
  }
  .wm-hl-b {
    clip-path: inset(-20% 0 -20% 100%);
  }
  .wm-hl path {
    stroke: var(--c-dim);
    stroke-width: 0.3em;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.4;
  }
  :global(:root[data-theme='light']) .wm-hl path {
    opacity: 0.2;
  }
  .wm-mark * {
    stroke-dasharray: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(a):hover .wm-mark *,
    :global(a):focus-visible .wm-mark * {
      animation: wm-draw 0.9s cubic-bezier(0.5, 0, 0.2, 1) both;
    }
    :global(a):hover .wm-mark *:nth-child(2),
    :global(a):focus-visible .wm-mark *:nth-child(2) {
      animation-delay: 0.08s;
    }
    :global(a):hover .wm-mark *:nth-child(3),
    :global(a):focus-visible .wm-mark *:nth-child(3) {
      animation-delay: 0.16s;
    }
    :global(a):hover .wm-mark *:nth-child(4),
    :global(a):focus-visible .wm-mark *:nth-child(4) {
      animation-delay: 0.24s;
    }
  }
  :global(a):hover .wm-hl,
  :global(a):focus-visible .wm-hl {
    clip-path: inset(-20% -2% -20% -2%);
    transition: clip-path 0.38s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  :global(a):hover .wm-hl-b,
  :global(a):focus-visible .wm-hl-b {
    transition-delay: 0.14s;
  }
  @keyframes wm-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (max-width: 23.75rem) {
    .wm-icon-narrow .wm {
      display: none;
    }
  }
</style>

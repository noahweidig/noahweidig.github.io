---
interface Props {
  class?: string;
  collapse?: boolean;
}
const { class: cls = '', collapse = false } = Astro.props;
---

<span class:list={['wm-lockup', cls]}>
  <svg class="wm-mark" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M8.3 10a.7.7 0 0 1-.626-1.079L11.4 3a.7.7 0 0 1 1.198-.043L16.3 8.9a.7.7 0 0 1-.572 1.1Z"
      fill="var(--logo-yellow)"
      stroke="var(--logo-yellow)"
    ></path>
    <rect
      x="3"
      y="14"
      width="7"
      height="7"
      rx="1"
      fill="var(--logo-blue)"
      stroke="var(--logo-blue)"
    ></rect>
    <circle cx="17.5" cy="17.5" r="3.5" fill="var(--logo-red)" stroke="var(--logo-red)"></circle>
  </svg>
  <span class:list={['wm font-display font-bold tracking-tight', { 'wm-collapse': collapse }]}>
    <span>n</span>
    <span class="wm-fade wm-oah">oah</span>
    <span class="wm-ink">w</span>
    <span class="wm-fade wm-eidig wm-ink">eidig</span>
    <span class="wm-dot">.</span>
  </span>
</span>

<style>
  /* Logo mark: Lucide's triangle, square and circle (the `shapes` icon), solid. */
  .wm-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .wm-mark {
    width: 1.55em;
    height: 1.55em;
    flex: none;
    stroke-width: 1.2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  /* A tinted pill tag, same wash as the hero's rolling pill and the cover tags. */
  .wm {
    display: inline-flex;
    padding: 0.3em 0.85em 0.35em;
    border-radius: var(--radius-pill);
    color: var(--c-accent-ink);
    background: color-mix(in oklab, var(--c-accent-ink) 18%, var(--c-surface));
    white-space: nowrap;
    transition: padding 0.7s var(--ease-out-soft);
  }
  .wm > span {
    display: inline-block;
  }
  .wm > .wm-ink {
    color: var(--c-ink);
  }
  :global(html[data-scrolled]) .wm-collapse {
    box-sizing: border-box;
    width: 2.2em;
    height: 2.2em;
    padding: 0;
    align-items: center;
    justify-content: center;
  }
  .wm-dot {
    display: none !important;
  }
  .wm-collapse .wm-dot {
    display: inline-block !important;
    max-width: 0;
    opacity: 0;
  }
  .wm-collapse .wm-fade,
  .wm-collapse .wm-dot {
    transition:
      max-width 0.7s var(--ease-out-soft),
      opacity 0.5s var(--ease-out-soft);
  }
  .wm-collapse .wm-fade {
    overflow: clip;
    overflow-clip-margin: 0.15em;
  }
  .wm-collapse .wm-oah {
    max-width: 2.2em;
  }
  .wm-collapse .wm-eidig {
    max-width: 2.8em;
  }
  :global(html[data-scrolled]) .wm-collapse .wm-fade {
    max-width: 0;
    opacity: 0;
  }
  :global(html[data-scrolled]) .wm-collapse .wm-dot {
    max-width: 0.5em;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .wm-collapse .wm-fade,
    .wm-collapse .wm-dot {
      transition-duration: 1ms;
    }
  }
</style>

---
interface Props {
  class?: string;
  iconOnlyNarrow?: boolean;
}
const { class: cls = '', iconOnlyNarrow = false } = Astro.props;
---

<span class:list={['wm-lockup', { 'wm-icon-narrow': iconOnlyNarrow }, cls]}>
  <svg class="wm-mark" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21.54 15H17a2 2 0 0 0-2 2v4.54" />
    <path d="M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17" />
    <path d="M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05" />
    <circle cx="12" cy="12" r="10" />
  </svg>
  <span class="sr-only">Noah Weidig — home</span>
  <span class="wm font-display" aria-hidden="true">
    <span>Noah</span>
    <span class="wm-last">Weidig</span>
  </span>
</span>

<style>
  /* Logo mark: Lucide's `earth`, outlined in the logo blue. */
  .wm-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .wm-mark {
    width: 1.55em;
    height: 1.55em;
    flex: none;
    fill: none;
    stroke: var(--logo-blue);
    stroke-width: 2.2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  /* Two-tone name, no tag: the surname is in the accent color. */
  .wm {
    display: inline-flex;
    gap: 0.28em;
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--c-ink);
    white-space: nowrap;
  }
  .wm > .wm-last {
    font-weight: 500;
    color: var(--c-accent-ink);
  }
  @media (max-width: 23.75rem) {
    .wm-icon-narrow .wm {
      display: none;
    }
  }
</style>

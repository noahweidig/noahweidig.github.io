---
interface Props {
  class?: string;
  collapse?: boolean;
}
const { class: cls = '', collapse = false } = Astro.props;
---

<span class:list={['wm font-display font-bold tracking-tight', { 'wm-collapse': collapse }, cls]}>
  <span>n</span>
  <span class="wm-fade wm-oah">oah</span>
  <span>w</span>
  <span class="wm-fade wm-eidig">eidig</span>
  <span class="wm-dot">.</span>
</span>

<style>
  /* A tinted pill tag, same wash as the hero's rolling pill and the cover tags. */
  .wm {
    display: inline-flex;
    padding: 0.3em 0.85em 0.35em;
    border-radius: var(--radius-pill);
    color: var(--c-accent-ink);
    background: color-mix(in oklab, var(--c-accent-ink) 18%, var(--c-surface));
    white-space: nowrap;
    transition: padding 0.7s var(--ease-out-soft);
  }
  .wm > span {
    display: inline-block;
  }
  .wm-dot {
    display: none !important;
  }
  .wm-collapse .wm-dot {
    display: inline-block !important;
    max-width: 0;
    opacity: 0;
  }
  .wm-collapse .wm-fade,
  .wm-collapse .wm-dot {
    transition:
      max-width 0.7s var(--ease-out-soft),
      opacity 0.5s var(--ease-out-soft);
  }
  .wm-collapse .wm-fade {
    overflow: clip;
    overflow-clip-margin: 0.15em;
  }
  .wm-collapse .wm-oah {
    max-width: 2.2em;
  }
  .wm-collapse .wm-eidig {
    max-width: 2.8em;
  }
  :global(html[data-scrolled]) .wm-collapse .wm-fade {
    max-width: 0;
    opacity: 0;
  }
  :global(html[data-scrolled]) .wm-collapse .wm-dot {
    max-width: 0.5em;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .wm-collapse .wm-fade,
    .wm-collapse .wm-dot {
      transition-duration: 1ms;
    }
  }
</style>

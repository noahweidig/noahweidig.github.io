---
import Breadcrumbs from './Breadcrumbs.astro';
import DotGrid from './DotGrid.astro';
import Icon from './Icon.astro';
import { iconFor, tintFor } from '../lib/tint';
import { vtName } from '../lib/format';

interface Props {
  title: string;
  kicker?: string;
  /** Name of an icon in `icons.generated.ts`, drawn as the page icon above the title. */
  icon?: string;
  intro?: string;
  trail?: { label: string; href?: string }[];
  /** Tighter padding, for pages that are mostly a document. */
  compact?: boolean;
  /** `md` suits long titles (a paper's name); `lg` is the default. */
  size?: 'lg' | 'md';
  /** Whether the `actions` / `aside` slots carry anything; a forwarded slot
      always reports as present, so the caller says. */
  hasActions?: boolean;
  hasAside?: boolean;
}
const {
  title,
  kicker,
  icon,
  intro,
  trail = [],
  compact = false,
  size = 'lg',
  hasActions = Astro.slots.has('actions'),
  hasAside = Astro.slots.has('aside'),
} = Astro.props;
const tint = tintFor(kicker ?? title);
/* Only detail pages (/projects/x/, /blog/x/) morph from the card that linked here. */
const vt = /^\/(projects|blog)\/[^/]+\/?$/.test(Astro.url.pathname)
  ? vtName(Astro.url.pathname)
  : undefined;
const glyph = icon ?? iconFor(kicker ?? title);
---

<section
  class:list={['page-hero under-nav relative overflow-x-clip', compact && 'page-hero-compact']}
>
  <DotGrid />
  <div class:list={['shell page-hero-inner', hasAside && 'has-aside']}>
    <div class="page-hero-copy">
      <Breadcrumbs trail={trail} current={title} />
      {kicker && (
        <p class={`kicker page-hero-kicker tint-${tint}`} data-pagefind-ignore>
          {glyph && <Icon name={glyph} size={14} />}
          {kicker}
        </p>
      )}
      <h1
        class:list={['page-hero-title', size === 'md' && 'page-hero-title-md']}
        style={vt ? `view-transition-name:${vt}` : undefined}
      >
        {title}
      </h1>
      {intro && <p class="page-hero-lede">{intro}</p>}
      <slot />
      {hasActions && (
        <div class="page-hero-actions" data-pagefind-ignore>
          <slot name="actions" />
        </div>
      )}
    </div>
    {hasAside && (
      <div class="page-hero-aside" data-pagefind-ignore>
        <slot name="aside" />
      </div>
    )}
  </div>
</section>

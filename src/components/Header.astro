---
import { u } from '../lib/url';
import { nav, site } from '../lib/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Search from './Search.astro';

/* Compared against `u(href)`, not the bare href, so the check stays correct if
   the site is ever served under a base path again: `/publications/` would not
   match `/<base>/publications/` and no nav item would read as current. */
const slash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const path = slash(Astro.url.pathname);
const home = slash(u('/'));
const isActive = (href: string) => {
  const target = slash(u(href));
  return target === home ? path === home : path === target || path.startsWith(target);
};
---

<header
  data-pagefind-ignore
  data-site-header
  class="sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300"
  id="site-header"
>
  <div class="shell flex h-16 items-center gap-4 md:h-18">
    <a
      href={u('/')}
      class="group flex min-w-0 items-center gap-2.5"
      aria-label="Noah Weidig — home"
    >
      <Logo class="h-7 w-auto transition-transform duration-500 group-hover:-rotate-6" />
      <span
        class="truncate font-display text-[1.3rem] font-medium tracking-tight max-[360px]:hidden md:text-[1.45rem]"
        >Noah Weidig</span
      >
      <span
        aria-hidden="true"
        class="hidden font-display text-[1.3rem] font-medium tracking-tight max-[360px]:block"
        >Nw.</span
      >
    </a>

    <nav aria-label="Primary" class="ml-auto hidden min-w-0 xl:block">
      <ul class="flex items-center gap-0.5">
        {
          nav.map((item) => (
            <li>
              <a
                href={u(item.href)}
                data-tip={item.tip}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'nav-link rounded-[0.7rem] px-3 py-2 text-sm',
                  isActive(item.href) ? 'nav-link-active' : '',
                ]}
              >
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1.5 xl:ml-2">
      <button
        type="button"
        data-search-open
        data-tip="Search — press /"
        class="icon-btn"
        aria-label="Search the site"
      >
        <Icon name="search" size={21} stroke-width={1.8} />
      </button>

      <button
        type="button"
        data-theme-toggle
        data-tip="Switch between light and dark"
        class="icon-btn"
        aria-label="Toggle color theme"
      >
        <span class="hidden dark:block"><Icon name="sun" size={21} stroke-width={1.8} /></span>
        <span class="block dark:hidden"><Icon name="moon" size={21} stroke-width={1.8} /></span>
      </button>

      <a
        class="btn btn-primary btn-sm ml-1 hidden sm:inline-flex"
        href={site.booking}
        target="_blank"
        rel="noopener"
        data-tip="Book a 30-minute call on Cal.com"
      >
        Book now
        <Icon name="arrow" size={15} />
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="icon-btn xl:hidden"
        aria-label="Open menu"
      >
        <span data-menu-icon-open><Icon name="menu" size={22} stroke-width={1.8} /></span>
        <span data-menu-icon-close hidden><Icon name="close" size={22} stroke-width={1.8} /></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    hidden
    class="absolute inset-x-0 top-full max-h-[calc(100vh-4rem)] overflow-y-auto border-t border-line bg-surface/95 backdrop-blur-xl xl:hidden"
  >
    <nav aria-label="Mobile" class="shell py-4">
      <ul class="grid gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={u(item.href)}
                class:list={[
                  'nav-link flex items-center justify-between rounded-[0.7rem] px-3 py-2.5 text-[0.95rem]',
                  isActive(item.href) ? 'nav-link-active' : '',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.text}
                <Icon name="arrow" size={16} class="opacity-40" />
              </a>
            </li>
          ))
        }
      </ul>
      <a
        class="btn btn-primary mt-4 w-full"
        href={site.booking}
        target="_blank"
        rel="noopener"
      >
        Book a call
        <Icon name="arrow" size={15} />
      </a>
    </nav>
  </div>
</header>

<Search />

<style>
  #site-header[data-stuck] {
    background-color: color-mix(in oklab, var(--c-bg) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom-color: var(--c-line);
  }
</style>

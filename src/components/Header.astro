---
import { u } from '../lib/url';
import { nav, site } from '../lib/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Search from './Search.astro';

/* Compared against `u(href)`, not the bare href, so the check stays correct if
   the site is ever served under a base path again: `/publications/` would not
   match `/<base>/publications/` and no nav item would read as current. */
const slash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const path = slash(Astro.url.pathname);
const home = slash(u('/'));
const isActive = (href: string) => {
  const target = slash(u(href));
  return target === home ? path === home : path === target || path.startsWith(target);
};
---

<header
  data-pagefind-ignore
  data-site-header
  class="sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300"
  id="site-header"
>
  <div class="shell flex h-14 items-center gap-4 md:h-16">
    <a
      href={u('/')}
      class="group flex min-w-0 items-center gap-2.5"
      aria-label="Noah Weidig — home"
    >
      <Logo class="wordmark-icon h-7 w-auto transition-transform duration-500 group-hover:-rotate-6" />
      <span
        data-text="Noah Weidig"
        class="wordmark-wipe truncate font-display text-[1.3rem] font-bold tracking-tight max-[360px]:hidden md:text-[1.45rem]"
      >
        Noah Weidig
      </span>
      <span
        aria-hidden="true"
        data-text="Nw."
        class="wordmark-wipe hidden font-display text-[1.3rem] font-bold tracking-tight max-[360px]:block"
      >
        Nw.
      </span>
    </a>

    <nav aria-label="Primary" class="ml-auto hidden min-w-0 lg:block">
      <ul class="flex items-center gap-0.5">
        {nav.map((item) => (
          <li>
            <a
              href={u(item.href)}
              data-tip={item.tip}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'nav-link rounded-full px-2.5 py-2 text-sm xl:px-3',
                isActive(item.href) ? 'nav-link-active' : '',
              ]}
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1.5 lg:ml-2">
      <button
        type="button"
        data-search-open
        data-tip="Search — press /"
        class="icon-btn"
        aria-label="Search the site"
      >
        <Icon name="search" size={21} stroke-width={1.8} />
      </button>

      <button
        type="button"
        data-theme-toggle
        data-tip="Switch color theme"
        class="icon-btn"
        aria-label="Switch color theme"
      >
        <span data-theme-icon="light">
          <Icon name="sun" size={21} stroke-width={1.8} />
        </span>
        <span data-theme-icon="dark">
          <Icon name="moon" size={21} stroke-width={1.8} />
        </span>
        <span data-theme-icon="system">
          <Icon name="sunMoon" size={21} stroke-width={1.8} />
        </span>
      </button>

      <a
        class="btn btn-primary ml-1 hidden px-2.5 py-2 text-sm xl:px-3 lg:inline-flex"
        href={site.booking}
        target="_blank"
        rel="noopener"
        data-tip="Book a 30-minute call on Cal.com"
      >
        Book now
        <span class="sr-only-nw"> (opens in a new tab)</span>
        <Icon name="arrow" size={15} />
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="icon-btn lg:hidden"
        aria-label="Open menu"
      >
        <span data-menu-icon-open>
          <Icon name="menu" size={22} stroke-width={1.8} />
        </span>
        <span data-menu-icon-close hidden>
          <Icon name="close" size={22} stroke-width={1.8} />
        </span>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    hidden
    class="mobile-nav absolute inset-x-0 top-full h-[calc(100dvh-3.5rem)] overflow-hidden border-t border-line bg-bg md:h-[calc(100dvh-4rem)] lg:hidden"
  >
    <nav
      aria-label="Mobile"
      class="shell flex h-full flex-col items-center justify-center py-[3dvh]"
    >
      <ul class="flex min-h-0 w-full flex-1 flex-col text-center">
        {nav.map((item, i) => (
          <li
            class="mobile-nav-item flex min-h-0 flex-1 items-center justify-center"
            style={`--i:${i}`}
          >
            <a
              href={u(item.href)}
              class:list={[
                'mobile-nav-link nav-link rounded-full px-6 font-display font-semibold tracking-tight',
                isActive(item.href) ? 'nav-link-active' : '',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
      <a
        class="mobile-nav-item btn btn-primary mt-[2dvh] shrink-0"
        style={`--i:${nav.length}`}
        href={site.booking}
        target="_blank"
        rel="noopener"
      >
        Book a call
        <span class="sr-only-nw"> (opens in a new tab)</span>
        <Icon name="arrow" size={15} />
      </a>
    </nav>
  </div>
</header>

<!-- Outside the header: a stuck header carries `backdrop-filter`, which makes
     it the containing block for fixed descendants and collapses this against
     the bar. Its top edge is set from the header's live bottom in ui.ts. -->
<div
  data-menu-scrim
  hidden
  aria-hidden="true"
  class="fixed inset-x-0 bottom-0 z-40 bg-bg lg:hidden"
></div>

<Search />

<style>
  /* The scrim sits behind the header, so an otherwise transparent bar would
     show it through. */
  #site-header[data-menu-open] {
    background-color: var(--c-bg);
  }
  /* Links split the panel height evenly; type scales with viewport height. */
  .mobile-nav-link {
    font-size: clamp(1.75rem, 5.5dvh, 3.25rem);
    line-height: 1.1;
    padding-block: 0.1em;
  }
  .mobile-nav:not([hidden]) {
    animation: menu-fade 0.35s var(--ease-out-soft) both;
  }
  .mobile-nav:not([hidden]) .mobile-nav-item {
    animation: menu-item 0.55s var(--ease-out-soft) both;
    animation-delay: calc(0.06s + var(--i) * 0.045s);
  }
  @keyframes menu-fade {
    from {
      opacity: 0;
      backdrop-filter: blur(12px);
    }
  }
  @keyframes menu-item {
    from {
      opacity: 0;
      filter: blur(6px);
      transform: translateY(14px) scale(0.97);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav:not([hidden]),
    .mobile-nav:not([hidden]) .mobile-nav-item {
      animation: none;
    }
  }
  #site-header[data-stuck] {
    background-color: color-mix(in oklab, var(--c-bg) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom-color: var(--c-line);
  }
</style>

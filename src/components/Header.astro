---
import { u } from '../lib/url';
import { navGroups, site } from '../lib/site';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import Search from './Search.astro';

/* Compared against `u(href)`, not the bare href, so the check stays correct if
   the site is ever served under a base path again: `/publications/` would not
   match `/<base>/publications/` and no nav item would read as current. */
const slash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const path = slash(Astro.url.pathname);
const home = slash(u('/'));
const isActive = (href: string) => {
  const target = slash(u(href));
  return target === home ? path === home : path === target || path.startsWith(target);
};
---

<header
  data-pagefind-ignore
  data-site-header
  class="sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300"
  id="site-header"
>
  <div class="shell flex h-14 items-center gap-4 md:h-16 lg:grid lg:grid-cols-[1fr_auto_1fr]">
    <a
      href={u('/')}
      class="group flex min-w-0 items-center gap-2.5"
      aria-label="Noah Weidig — home"
    >
      <Wordmark collapse class="text-[1.75rem] max-[389px]:text-[1.5rem] md:text-[2rem]" />
    </a>

    <nav aria-label="Primary" class="mx-auto hidden lg:block">
      <ul class="flex items-center gap-1">
        {navGroups.map((group) => {
          const active = group.items.some((i) => !('external' in i) && isActive(i.href));
          return (
            <li class="nav-group relative">
              <button
                type="button"
                data-nav-trigger
                aria-expanded="false"
                aria-haspopup="true"
                class:list={[
                  'nav-link nav-trigger inline-flex items-center gap-1.5 rounded-full px-4 py-2 font-display text-[0.95rem] font-semibold tracking-tight xl:px-5 xl:text-base',
                  active ? 'nav-link-active' : '',
                ]}
              >
                {group.text}
                <Icon name="chevron" size={14} stroke-width={2.2} class="nav-chevron" />
              </button>
              <ul class="nav-menu card absolute left-1/2 top-full z-10 hidden min-w-52 -translate-x-1/2 p-1.5">
                {group.items.map((item) => (
                  <li>
                    <a
                      href={'external' in item ? item.href : u(item.href)}
                      target={'external' in item ? '_blank' : undefined}
                      rel={'external' in item ? 'noopener' : undefined}
                      data-tip={item.tip}
                      aria-current={
                        !('external' in item) && isActive(item.href) ? 'page' : undefined
                      }
                      class:list={[
                        'nav-link block rounded-lg px-3 py-2 text-sm font-medium',
                        !('external' in item) && isActive(item.href) ? 'nav-link-active' : '',
                      ]}
                    >
                      {item.text}
                      {'external' in item && <span class="sr-only-nw"> (opens in a new tab)</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1.5 lg:justify-self-end">
      <button
        type="button"
        data-search-open
        data-tip="Search — press /"
        class="icon-btn"
        aria-label="Search the site"
      >
        <Icon name="search" size={21} stroke-width={1.8} />
      </button>

      <button
        type="button"
        data-theme-toggle
        data-tip="Switch color theme"
        class="icon-btn"
        aria-label="Switch color theme"
      >
        <span data-theme-icon="light">
          <Icon name="sun" size={21} stroke-width={1.8} />
        </span>
        <span data-theme-icon="dark">
          <Icon name="moon" size={21} stroke-width={1.8} />
        </span>
        <span data-theme-icon="system">
          <Icon name="sunMoon" size={21} stroke-width={1.8} />
        </span>
      </button>

      <a
        class="btn btn-primary ml-1 hidden px-2.5 py-2 text-sm xl:px-3 lg:inline-flex"
        href={u('/contact/')}
        data-tip="Email, booking and the contact form"
      >
        Get in touch
        <Icon name="arrow" size={15} />
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="icon-btn lg:hidden"
        aria-label="Open menu"
      >
        <span class="burger" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    hidden
    class="mobile-nav absolute inset-x-0 top-full h-[calc(100dvh-3.5rem)] overflow-hidden border-t border-line bg-bg md:h-[calc(100dvh-4rem)] lg:hidden"
  >
    <nav aria-label="Mobile" class="shell flex h-full flex-col pb-5 pt-2">
      <ul class="min-h-0 flex-1 overflow-y-auto">
        {navGroups.map((group) => (
          <li class="mobile-group border-b border-line">
            <button
              type="button"
              data-mobile-trigger
              aria-expanded="false"
              class="flex w-full items-center justify-between py-5 text-left font-display text-3xl font-semibold tracking-tight text-ink"
            >
              {group.text}
              <Icon name="chevron" size={26} stroke-width={1.8} class="nav-chevron" />
            </button>
            <ul class="mobile-sub hidden pb-4">
              {group.items.map((item) => (
                <li>
                  <a
                    href={'external' in item ? item.href : u(item.href)}
                    target={'external' in item ? '_blank' : undefined}
                    rel={'external' in item ? 'noopener' : undefined}
                    class:list={[
                      'nav-link block rounded-lg px-3 py-3 font-display text-xl font-medium',
                      !('external' in item) && isActive(item.href) ? 'nav-link-active' : '',
                    ]}
                    aria-current={!('external' in item) && isActive(item.href) ? 'page' : undefined}
                  >
                    {item.text}
                    {'external' in item && <span class="sr-only-nw"> (opens in a new tab)</span>}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <a
        class="btn mt-4 shrink-0 justify-center border border-line py-3.5 text-base font-semibold"
        href={site.booking}
        target="_blank"
        rel="noopener"
      >
        Book a call
        <span class="sr-only-nw"> (opens in a new tab)</span>
      </a>
      <a
        class="btn btn-primary mt-3 shrink-0 justify-center py-3.5 text-base font-semibold"
        href={u('/contact/')}
      >
        Get in touch
        <Icon name="arrow" size={15} />
      </a>
    </nav>
  </div>
</header>

<Search />

<style>
  .nav-menu {
    box-shadow: var(--shadow-lg, 0 12px 32px -8px rgb(0 0 0 / 0.18));
  }
  .nav-group[data-open] > .nav-menu {
    display: block;
    animation: menu-drop 0.18s var(--ease-out-soft, ease-out) both;
  }
  .nav-group[data-open] :global(.nav-chevron),
  .nav-trigger:hover :global(.nav-chevron) {
    rotate: 180deg;
  }
  :global(.nav-chevron) {
    transition: rotate 0.2s ease;
  }
  @keyframes menu-drop {
    from {
      opacity: 0;
      translate: 0 -4px;
    }
  }
  .burger {
    position: relative;
    display: block;
    width: 22px;
    height: 22px;
  }
  .burger i {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 50%;
    height: 2.5px;
    margin-top: -1.25px;
    border-radius: 2px;
    background: currentColor;
    translate: 0 -4.5px;
    transition:
      translate 0.18s ease 0.18s,
      rotate 0.18s ease;
  }
  .burger i:last-child {
    translate: 0 4.5px;
  }
  [aria-expanded='true'] .burger i {
    translate: 0 0;
    transition:
      translate 0.18s ease,
      rotate 0.18s ease 0.18s;
  }
  [aria-expanded='true'] .burger i:first-child {
    rotate: 45deg;
  }
  [aria-expanded='true'] .burger i:last-child {
    rotate: -45deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .burger i,
    [aria-expanded='true'] .burger i {
      transition: none;
    }
  }
  /* Links split the panel height evenly; type scales with viewport height. */
  .mobile-group[data-open] > .mobile-sub {
    display: block;
  }
  .mobile-group[data-open] :global(.nav-chevron) {
    rotate: 180deg;
  }
  .mobile-nav {
    contain: strict;
    touch-action: pan-y;
    overscroll-behavior: contain;
  }
  .mobile-nav:not([hidden]) {
    animation: menu-wipe 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes menu-wipe {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav:not([hidden]) {
      animation: none;
    }
  }
  :global(html[data-menu-open]) {
    overflow: hidden;
  }
  #site-header[data-stuck] {
    background-color: color-mix(in oklab, var(--c-bg) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom-color: var(--c-line);
  }
  /* Opaque while open; a live backdrop blur here repaints every frame. */
  /* After [data-stuck]: same specificity, so order decides. Opaque while open. */
  #site-header[data-menu-open] {
    background-color: var(--c-bg);
    backdrop-filter: none;
  }
</style>

<script>
  const set = () => {
    if (document.documentElement.hasAttribute('data-menu-open')) return;
    document.documentElement.toggleAttribute('data-scrolled', scrollY > 8);
  };
  set();
  addEventListener('scroll', set, { passive: true });
</script>

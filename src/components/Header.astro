---
import { u } from '../lib/url';
import { navGroups, site } from '../lib/site';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import Search from './Search.astro';

/* Compared against `u(href)`, not the bare href, so the check stays correct if
   the site is ever served under a base path again: `/publications/` would not
   match `/<base>/publications/` and no nav item would read as current. */
const slash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const path = slash(Astro.url.pathname);
const home = slash(u('/'));
const isActive = (href: string) => {
  const target = slash(u(href));
  return target === home ? path === home : path === target || path.startsWith(target);
};
---

<header
  data-pagefind-ignore
  data-site-header
  class="nav-glass fixed inset-x-0 top-0 z-50"
  id="site-header"
>
  <div class="shell nav-bar flex h-16 items-center md:h-[4.5rem] gap-4 lg:grid lg:grid-cols-[1fr_auto_1fr]">
    <a
      href={u('/')}
      class="group flex min-w-0 items-center gap-2.5"
      aria-label="Noah Weidig — home"
    >
      <Wordmark collapse class="text-[clamp(1.25rem,calc((100vw-12rem)/5.45),2.25rem)]" />
    </a>

    <nav aria-label="Primary" class="mx-auto hidden lg:block">
      <ul class="flex items-center gap-1">
        {navGroups.map((group) => {
          const active = group.items.some((i) => !('external' in i) && isActive(i.href));
          return (
            <li class="nav-group relative">
              <button
                type="button"
                data-nav-trigger
                aria-expanded="false"
                class:list={[
                  'nav-link nav-trigger inline-flex items-center gap-1.5 rounded-full px-4 py-2 font-display text-[0.95rem] font-semibold tracking-tight xl:px-5 xl:text-base',
                  active ? 'nav-link-active' : '',
                ]}
              >
                {group.text}
                <Icon name="chevron" size={14} class="nav-chevron" />
              </button>
              <ul class="nav-menu card absolute left-1/2 top-full z-10 hidden min-w-52 -translate-x-1/2 p-1.5">
                {group.items.map((item) => (
                  <li>
                    <a
                      href={'external' in item ? item.href : u(item.href)}
                      target={'external' in item ? '_blank' : undefined}
                      rel={'external' in item ? 'noopener' : undefined}
                      data-tip={item.tip}
                      aria-current={
                        !('external' in item) && isActive(item.href) ? 'page' : undefined
                      }
                      class:list={[
                        'nav-link block rounded-lg px-3 py-2 text-sm font-medium',
                        !('external' in item) && isActive(item.href) ? 'nav-link-active' : '',
                      ]}
                    >
                      {item.text}
                      {'external' in item && <span class="sr-only-nw"> (opens in a new tab)</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1.5 lg:justify-self-end">
      <button
        type="button"
        data-search-open
        data-tip="Search — press /"
        class="icon-btn"
        aria-label="Search the site"
      >
        <Icon name="nav-search" size={21} stroke-width={1.8} />
      </button>

      <button
        type="button"
        data-theme-toggle
        data-tip="Switch color theme"
        class="icon-btn"
        aria-label="Switch color theme"
      >
        <span data-theme-icon="light">
          <Icon name="nav-sun" size={21} stroke-width={1.8} />
        </span>
        <span data-theme-icon="dark">
          <Icon name="nav-moon" size={21} stroke-width={1.8} />
        </span>
        <span data-theme-icon="system">
          <Icon name="nav-sunMoon" size={21} stroke-width={1.8} />
        </span>
      </button>

      <a
        class="btn btn-primary ml-1 hidden px-4 py-2.5 text-sm lg:inline-flex"
        href={u('/contact/')}
        data-tip="Email, booking and the contact form"
      >
        Get in touch
        <Icon name="arrow" size={15} />
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="icon-btn lg:hidden"
        aria-label="Open menu"
      >
        <span class="burger" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    hidden
    class="mobile-nav absolute inset-x-0 top-full h-[calc(100dvh-4rem)] md:h-[calc(100dvh-4.5rem)] overflow-hidden bg-bg lg:hidden"
  >
    <nav aria-label="Mobile" class="shell flex h-full flex-col pb-5 pt-2">
      <ul class="min-h-0 flex-1 overflow-y-auto">
        {navGroups.map((group) => (
          <li class="mobile-group border-b border-line">
            <button
              type="button"
              data-mobile-trigger
              aria-expanded="false"
              class="flex w-full items-center justify-between py-5 text-left font-display text-3xl font-semibold tracking-tight text-ink"
            >
              {group.text}
              <Icon name="chevron" size={26} class="nav-chevron" />
            </button>
            <ul class="mobile-sub hidden pb-4">
              {group.items.map((item) => (
                <li>
                  <a
                    href={'external' in item ? item.href : u(item.href)}
                    target={'external' in item ? '_blank' : undefined}
                    rel={'external' in item ? 'noopener' : undefined}
                    class:list={[
                      'nav-link block rounded-lg px-3 py-3 font-display text-xl font-medium',
                      !('external' in item) && isActive(item.href) ? 'nav-link-active' : '',
                    ]}
                    aria-current={!('external' in item) && isActive(item.href) ? 'page' : undefined}
                  >
                    {item.text}
                    {'external' in item && <span class="sr-only-nw"> (opens in a new tab)</span>}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <a
        class="btn mt-4 shrink-0 justify-center border border-line py-3.5 text-base font-semibold"
        href={site.booking}
        target="_blank"
        rel="noopener"
      >
        Book a call
        <span class="sr-only-nw"> (opens in a new tab)</span>
      </a>
      <a
        class="btn btn-primary mt-3 shrink-0 justify-center py-3.5 text-base font-semibold"
        href={u('/contact/')}
      >
        Get in touch
        <Icon name="arrow" size={15} />
      </a>
    </nav>
  </div>
</header>
<!-- The bar is fixed (a sticky bar lags behind touch scrolling on iOS), so this holds its
     place in the flow. Keep it in step with the h- classes on .nav-bar. -->
<div class="h-16 md:h-[4.5rem] print:hidden" aria-hidden="true" data-pagefind-ignore></div>

<Search />

<style>
  .nav-menu {
    box-shadow: var(--shadow-lg, 0 12px 32px -8px rgb(0 0 0 / 0.18));
  }
  .nav-group[data-open] > .nav-menu {
    display: block;
    animation: menu-drop 0.18s var(--ease-out-soft, ease-out) both;
  }
  /* Same flip as the FAQ chevron: about the horizontal axis, toward the viewer. */
  .nav-group[data-open] :global(.nav-chevron),
  .nav-trigger:hover :global(.nav-chevron) {
    transform: perspective(120px) rotateX(180deg);
  }
  :global(.nav-chevron) {
    transition: transform 0.4s var(--ease-out-soft, ease);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.nav-chevron) {
      transition: none;
    }
  }
  @keyframes menu-drop {
    from {
      opacity: 0;
    }
  }
  .burger {
    position: relative;
    display: block;
    width: 22px;
    height: 22px;
  }
  /* Top-level items: no hover pill, the label just brightens. */
  .nav-trigger:not(.nav-link-active):hover {
    background: transparent;
    color: var(--c-ink);
  }
  .burger i {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 50%;
    height: 2.5px;
    margin-top: -1.25px;
    border-radius: 2px;
    background: currentColor;
    translate: 0 -4.5px;
    transition:
      translate 0.18s ease 0.18s,
      rotate 0.18s ease;
  }
  .burger i:last-child {
    translate: 0 4.5px;
  }
  [aria-expanded='true'] .burger i {
    translate: 0 0;
    transition:
      translate 0.18s ease,
      rotate 0.18s ease 0.18s;
  }
  [aria-expanded='true'] .burger i:first-child {
    rotate: 45deg;
  }
  [aria-expanded='true'] .burger i:last-child {
    rotate: -45deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .burger i,
    [aria-expanded='true'] .burger i {
      transition: none;
    }
  }
  /* Links split the panel height evenly; type scales with viewport height. */
  .mobile-group[data-open] > .mobile-sub {
    display: block;
  }
  .mobile-group[data-open] :global(.nav-chevron) {
    transform: perspective(120px) rotateX(180deg);
  }
  .mobile-nav {
    contain: strict;
    touch-action: pan-y;
    overscroll-behavior: contain;
  }
  .mobile-nav:not([hidden]) {
    animation: menu-wipe 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes menu-wipe {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0);
    }
  }
  .mobile-nav[data-closing] {
    animation: menu-wipe-out 0.3s cubic-bezier(0.5, 0, 0.75, 0) both;
    pointer-events: none;
  }
  @keyframes menu-wipe-out {
    from {
      clip-path: inset(0);
    }
    to {
      clip-path: inset(0 0 0 100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav:not([hidden]) {
      animation: none;
    }
  }
  :global(html[data-menu-open]),
  :global(html[data-search-active]) {
    overflow: hidden;
    overscroll-behavior: none;
  }
  /* Transparent at the top of the page; flat glass once scrolled: white in
     light theme, near-black in dark. */
  .nav-glass {
    background-color: transparent;
    transition:
      background-color 0.3s var(--ease-out-soft),
      backdrop-filter 0.3s var(--ease-out-soft);
  }
  .nav-glass::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(rgb(255 255 255 / 0.6), transparent 70%);
    opacity: 0;
    transition: opacity 0.3s var(--ease-out-soft);
  }
  :global(html[data-scrolled]) .nav-glass {
    background-color: rgb(255 255 255 / 0.78);
    backdrop-filter: saturate(1.8) blur(20px);
  }
  :global(html[data-scrolled]) .nav-glass::before {
    opacity: 1;
  }
  :global(html[data-scrolled]:root[data-theme='dark']) .nav-glass {
    background-color: rgb(10 10 12 / 0.8);
  }
  :global(html[data-scrolled]:root[data-theme='dark']) .nav-glass::before {
    background: linear-gradient(rgb(255 255 255 / 0.05), transparent 70%);
  }
  :global(:root) #site-header.nav-glass[data-menu-open] {
    background: var(--c-bg);
    backdrop-filter: none;
  }
  :global(:root) #site-header.nav-glass[data-menu-open]::before {
    opacity: 0;
  }
  /* No hover tile on the bar's icon buttons. Resting is a step off full ink, so
     hover reads lighter in dark theme and darker in light theme. */
  .icon-btn {
    color: color-mix(in oklab, var(--c-ink) 72%, transparent);
    transition: color 0.2s var(--ease-out-soft);
  }
  .icon-btn:hover {
    background: transparent;
    color: var(--c-ink);
  }
</style>

<script>
  const set = () => {
    if (document.documentElement.hasAttribute('data-menu-open')) return;
    document.documentElement.toggleAttribute('data-scrolled', scrollY > 8);
  };
  set();
  addEventListener('scroll', set, { passive: true });
</script>

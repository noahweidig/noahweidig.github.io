---
import { u } from '../lib/url';
import { nav, site } from '../lib/site';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import Logo from './Logo.astro';
import Search from './Search.astro';

/* Compared against `u(href)`, not the bare href, so the check stays correct if
   the site is ever served under a base path again: `/publications/` would not
   match `/<base>/publications/` and no nav item would read as current. */
const slash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const path = slash(Astro.url.pathname);
const home = slash(u('/'));
const isActive = (href: string) => {
  const target = slash(u(href));
  return target === home ? path === home : path === target || path.startsWith(target);
};
---

<header
  data-pagefind-ignore
  data-site-header
  class="sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300"
  id="site-header"
>
  <div class="shell flex h-14 items-center gap-4 md:h-16">
    <a
      href={u('/')}
      class="group flex min-w-0 items-center gap-2.5"
      aria-label="Noah Weidig — home"
    >
      <Logo class="wordmark-icon hidden h-9 md:block w-auto transition-transform duration-500 group-hover:-rotate-6" />
      <Wordmark collapse class="text-[1.75rem] md:text-[2rem]" />
    </a>

    <nav aria-label="Primary" class="mx-4 hidden min-w-0 flex-1 lg:block xl:mx-8">
      <ul class="flex items-center justify-end gap-0.5">
        {nav.map((item) => (
          <li>
            <a
              href={u(item.href)}
              data-tip={item.tip}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'nav-link rounded-full px-2.5 py-2 text-sm xl:px-3',
                isActive(item.href) ? 'nav-link-active' : '',
              ]}
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1.5 lg:ml-0">
      <button
        type="button"
        data-search-open
        data-tip="Search — press /"
        class="icon-btn"
        aria-label="Search the site"
      >
        <Icon name="search" size={21} stroke-width={1.8} />
      </button>

      <button
        type="button"
        data-theme-toggle
        data-tip="Switch color theme"
        class="icon-btn"
        aria-label="Switch color theme"
      >
        <span data-theme-icon="light">
          <Icon name="sun" size={21} stroke-width={1.8} />
        </span>
        <span data-theme-icon="dark">
          <Icon name="moon" size={21} stroke-width={1.8} />
        </span>
        <span data-theme-icon="system">
          <Icon name="sunMoon" size={21} stroke-width={1.8} />
        </span>
      </button>

      <a
        class="btn btn-primary ml-1 hidden px-2.5 py-2 text-sm xl:px-3 lg:inline-flex"
        href={site.booking}
        target="_blank"
        rel="noopener"
        data-tip="Book a 30-minute call on Cal.com"
      >
        Book now
        <span class="sr-only-nw"> (opens in a new tab)</span>
        <Icon name="arrow" size={15} />
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="icon-btn lg:hidden"
        aria-label="Open menu"
      >
        <span data-menu-icon-open>
          <Icon name="menu" size={22} stroke-width={1.8} />
        </span>
        <span data-menu-icon-close hidden>
          <Icon name="close" size={22} stroke-width={1.8} />
        </span>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    hidden
    class="mobile-nav absolute inset-x-0 top-full h-[calc(100dvh-3.5rem)] overflow-hidden border-t border-line bg-bg md:h-[calc(100dvh-4rem)] lg:hidden"
  >
    <nav
      aria-label="Mobile"
      class="shell flex h-full flex-col items-center justify-center py-[3dvh]"
    >
      <ul class="flex min-h-0 w-full flex-1 flex-col text-center">
        {nav.map((item) => (
          <li class="flex min-h-0 flex-1 items-center justify-center">
            <a
              href={u(item.href)}
              class:list={[
                'mobile-nav-link nav-link rounded-full px-6 font-display font-semibold tracking-tight',
                isActive(item.href) ? 'nav-link-active' : '',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
      <a
        class="mobile-nav-cta btn btn-primary mt-[2dvh] shrink-0 font-display font-semibold tracking-tight"
        href={site.booking}
        target="_blank"
        rel="noopener"
      >
        Book a call
        <span class="sr-only-nw"> (opens in a new tab)</span>
        <Icon name="arrow" size={15} />
      </a>
    </nav>
  </div>
</header>

<Search />

<style>
  #site-header[data-menu-open] {
    background-color: var(--c-bg);
  }
  /* Links split the panel height evenly; type scales with viewport height. */
  .mobile-nav-link {
    font-size: clamp(1.75rem, 5.5dvh, 3.25rem);
    line-height: 1.1;
    padding-block: 0.1em;
  }
  .mobile-nav-cta {
    font-size: clamp(1.75rem, 5.5dvh, 3.25rem);
    line-height: 1.1;
    padding: 0.3em 1em;
  }
  .mobile-nav {
    contain: strict;
    touch-action: none;
    overscroll-behavior: contain;
  }
  .mobile-nav:not([hidden]) {
    animation: menu-fade 0.15s ease-out both;
  }
  @keyframes menu-fade {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav:not([hidden]) {
      animation: none;
    }
  }
  :global(html[data-menu-open]) {
    overflow: hidden;
  }
  #site-header[data-stuck] {
    background-color: color-mix(in oklab, var(--c-bg) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom-color: var(--c-line);
  }
  /* Opaque while open; a live backdrop blur here repaints every frame. */
  #site-header[data-menu-open] {
    backdrop-filter: none;
  }
</style>

<script>
  const set = () => {
    if (document.documentElement.hasAttribute('data-menu-open')) return;
    document.documentElement.toggleAttribute('data-scrolled', scrollY > 8);
  };
  set();
  addEventListener('scroll', set, { passive: true });
</script>

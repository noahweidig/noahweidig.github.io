---
import { navGroups, navMeta } from '../lib/site';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import Search from './Search.astro';
import { tintBase } from '../lib/tint';

const slash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const path = slash(Astro.url.pathname);
const isActive = (href: string) => {
  const target = slash(href);
  return target === '/' ? path === '/' : path === target || path.startsWith(target);
};
type MobileItem = { text: string; href: string; external?: true };
const mobileItems: MobileItem[] = [
  ...navGroups.flatMap((g): MobileItem[] => [...g.items]),
  { text: 'Get in touch', href: '/contact/' },
];
---

<header
  data-pagefind-ignore
  data-site-header
  class="nav-glass fixed inset-x-0 top-0 z-50"
  id="site-header"
>
  <div class="shell nav-bar relative z-10 flex h-16 items-center md:h-[4.5rem] gap-4 lg:grid lg:grid-cols-[1fr_auto_1fr]">
    <a
      href="/"
      class="bar-fade group flex min-w-0 items-center gap-2.5"
      aria-label="Noah Weidig — home"
    >
      <Wordmark iconOnlyNarrow class="text-[1.15rem] md:text-[1.25rem]" />
    </a>

    <nav aria-label="Primary" class="mx-auto hidden lg:block">
      <ul class="flex items-center gap-1">
        {navGroups.map((group) => {
          const active = group.items.some((i) => !('external' in i) && isActive(i.href));
          return (
            <li class="nav-group relative">
              <button
                type="button"
                data-nav-trigger
                aria-expanded="false"
                class:list={[
                  'nav-link nav-trigger inline-flex items-center gap-1.5 rounded-full px-4 py-2 font-display text-body-lg font-semibold tracking-tight xl:px-5 xl:text-base',
                  active ? 'nav-link-active' : '',
                ]}
              >
                {group.text}
                <Icon name="nav-chevronRight" size={14} stroke-width={2.6} class="nav-chevron" />
              </button>
              <ul
                class="nav-menu card absolute top-full left-1/2 z-10 hidden -translate-x-1/2 p-2.5"
                style={`--cols:${group.items.length === 4 ? 2 : Math.min(group.items.length, 3)}`}
              >
                {group.items.map((item) => {
                  const external = 'external' in item;
                  const current = !external && isActive(item.href);
                  return (
                    <li>
                      <a
                        href={item.href}
                        target={external ? '_blank' : undefined}
                        rel={external ? 'noopener' : undefined}
                        aria-current={current ? 'page' : undefined}
                        class="nav-card group/card flex h-full flex-col"
                        style={`--tint-base:${tintBase(navMeta[item.text]!.tint)}`}
                      >
                        <span
                          class={`grid h-11 w-11 place-items-center rounded-xl tile-${navMeta[item.text]!.tint}`}
                        >
                          <Icon name={navMeta[item.text]!.icon} size={21} />
                        </span>
                        <span class="mt-4 flex items-center gap-1.5 font-display text-lead font-semibold tracking-tight text-ink">
                          {item.text}
                          <Icon name="arrow" size={14} class="nav-card-arrow" />
                        </span>
                        <span class="mt-1 text-small leading-snug text-dim">{item.tip}</span>
                        {external && <span class="sr-only-nw"> (opens in a new tab)</span>}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1.5 lg:justify-self-end">
      <button
        type="button"
        data-search-open
        data-tip="Search — press /"
        class="icon-btn bar-fade"
        aria-label="Search the site"
      >
        <Icon name="nav-search" size={21} stroke-width={1.8} />
      </button>

      <button
        type="button"
        data-theme-toggle
        data-tip="Switch color theme"
        class="icon-btn bar-fade"
        aria-label="Switch color theme"
      >
        <span data-theme-icon="light">
          <Icon name="nav-sun" size={21} stroke-width={1.8} />
        </span>
        <span data-theme-icon="dark">
          <Icon name="nav-moon" size={21} stroke-width={1.8} />
        </span>
        <span data-theme-icon="system">
          <Icon name="nav-sunMoon" size={21} stroke-width={1.8} />
        </span>
      </button>

      <a
        class="btn btn-primary ml-1 hidden px-4 py-2.5 text-sm lg:inline-flex"
        href="/contact/"
        data-tip="Email, booking and the contact form"
      >
        Get in touch
        <Icon name="arrow" size={15} />
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="icon-btn lg:hidden"
        aria-label="Open menu"
      >
        <span class="burger" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    hidden
    class="mobile-nav fixed inset-0 overflow-hidden bg-bg pt-16 md:pt-[4.5rem] lg:hidden"
  >
    <nav aria-label="Mobile" class="shell flex h-full flex-col pb-5 pt-2">
      <ul class="min-h-0 flex-1 overflow-y-auto">
        {mobileItems.map((item, i) => {
          const external = 'external' in item;
          return (
            <li class="mobile-item" style={`--i:${i}`}>
              <a
                href={item.href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener' : undefined}
                class="mobile-link flex w-full items-center justify-between py-2.5 font-display text-2xl font-semibold tracking-tight text-ink"
                aria-current={!external && isActive(item.href) ? 'page' : undefined}
              >
                {item.text}
                {external && <span class="sr-only-nw"> (opens in a new tab)</span>}
                <Icon
                  name="nav-chevronRight"
                  size={22}
                  stroke-width={1.72}
                  class="mobile-chevron"
                />
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
<!-- The bar is fixed (a sticky bar lags behind touch scrolling on iOS), so this holds its
     place in the flow. Keep it in step with the h- classes on .nav-bar. -->
<div class="h-16 md:h-[4.5rem] print:hidden" aria-hidden="true" data-pagefind-ignore></div>

<Search />

<style>
  .nav-card {
    padding: 1.1rem;
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--tint-base) 7%, var(--c-card));
    transition: background-color 0.2s var(--ease-out-soft);
  }
  .nav-card:hover,
  .nav-card:focus-visible {
    background: color-mix(in oklab, var(--tint-base) 15%, var(--c-card));
  }
  .nav-card[aria-current='page'] {
    box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--tint-base) 50%, transparent);
  }
  :global(.nav-card-arrow) {
    opacity: 0;
    translate: -4px 0;
    transition:
      opacity 0.2s ease,
      translate 0.2s var(--ease-out-soft);
  }
  .nav-card:hover :global(.nav-card-arrow),
  .nav-card:focus-visible :global(.nav-card-arrow) {
    opacity: 1;
    translate: 0 0;
  }
  .nav-menu {
    box-shadow: var(--shadow-lg, 0 12px 32px -8px rgb(0 0 0 / 0.18));
  }
  .nav-group[data-open] > .nav-menu {
    display: grid;
    grid-template-columns: repeat(var(--cols, 2), 14.5rem);
    gap: 0.5rem;
    max-width: calc(100vw - 2rem);
    animation: menu-drop 0.18s var(--ease-out-soft, ease-out) both;
  }
  /* The right-pointing chevron is turned to point down, and up when open. */
  :global(.nav-chevron) {
    rotate: 90deg;
    transition: rotate 0.4s var(--ease-out-soft, ease);
  }
  .nav-group[data-open] :global(.nav-chevron),
  .nav-trigger:hover :global(.nav-chevron) {
    rotate: -90deg;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.nav-chevron) {
      transition: none;
    }
  }
  @keyframes menu-drop {
    from {
      opacity: 0;
    }
  }
  .burger {
    position: relative;
    display: block;
    width: 22px;
    height: 22px;
  }
  /* Top-level items: no hover pill, the label just brightens. */
  .nav-trigger:not(.nav-link-active):hover {
    background: transparent;
    color: var(--c-ink);
  }
  .burger i {
    position: absolute;
    left: 1px;
    right: 1px;
    top: 50%;
    height: 1.6px;
    margin-top: -0.8px;
    border-radius: 2px;
    background: currentColor;
    translate: 0 -4.5px;
    transition:
      translate 0.18s ease 0.18s,
      rotate 0.18s ease;
  }
  .burger i:last-child {
    translate: 0 4.5px;
  }
  [aria-expanded='true'] .burger i {
    translate: 0 0;
    transition:
      translate 0.18s ease,
      rotate 0.18s ease 0.18s;
  }
  [aria-expanded='true'] .burger i:first-child {
    rotate: 45deg;
  }
  [aria-expanded='true'] .burger i:last-child {
    rotate: -45deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .burger i,
    [aria-expanded='true'] .burger i {
      transition: none;
    }
  }
  :global(.mobile-chevron) {
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .mobile-link:hover :global(.mobile-chevron),
  .mobile-link:focus-visible :global(.mobile-chevron) {
    opacity: 1;
  }
  .mobile-nav {
    contain: strict;
    touch-action: pan-y;
    overscroll-behavior: contain;
  }
  .mobile-nav:not([hidden]) {
    animation: menu-fade 0.3s ease-out both;
  }
  @keyframes menu-fade {
    from {
      opacity: 0;
    }
  }
  .mobile-nav[data-closing] {
    animation: menu-fade-out 0.25s ease-in both;
    pointer-events: none;
  }
  @keyframes menu-fade-out {
    to {
      opacity: 0;
    }
  }
  .mobile-nav:not([hidden]):not([data-closing]) .mobile-item {
    animation: menu-item-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(0.05s + var(--i, 0) * 0.05s);
  }
  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .bar-fade {
    transition:
      opacity 0.2s ease,
      visibility 0s 0s;
  }
  :global(#site-header[data-menu-open]) .bar-fade {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      color 0.2s var(--ease-out-soft),
      opacity 0.2s ease,
      visibility 0s 0.2s;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav:not([hidden]),
    .mobile-nav[data-closing],
    .mobile-nav .mobile-item,
    :global(.mobile-chevron),
    .bar-fade {
      animation: none !important;
      transition: none !important;
    }
  }
  :global(html[data-menu-open]),
  :global(html[data-search-active]) {
    overflow: hidden;
    overscroll-behavior: none;
  }
  /* Transparent at the top of the page; a flat bar with a hairline once scrolled. */
  .nav-glass {
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s var(--ease-out-soft),
      border-color 0.3s var(--ease-out-soft);
  }
  :global(html[data-scrolled]) .nav-glass {
    background-color: var(--c-bg);
    border-bottom-color: var(--c-line);
  }
  :global(:root) #site-header.nav-glass[data-menu-open] {
    background: var(--c-bg);
  }
  /* No hover tile on the bar's icon buttons. Resting is a step off full ink, so
     hover reads lighter in dark theme and darker in light theme. */
  .icon-btn {
    color: color-mix(in oklab, var(--c-ink) 72%, transparent);
    transition:
      color 0.2s var(--ease-out-soft),
      opacity 0.2s ease,
      visibility 0s 0s;
  }
  .icon-btn:hover {
    background: transparent;
    color: var(--c-ink);
  }
</style>

<script>
  const set = () => {
    if (document.documentElement.hasAttribute('data-menu-open')) return;
    document.documentElement.toggleAttribute('data-scrolled', scrollY > 8);
  };
  set();
  addEventListener('scroll', set, { passive: true });
</script>

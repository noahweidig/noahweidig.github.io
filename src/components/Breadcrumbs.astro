---
import { site } from '../lib/site';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  /** Ancestors only; the current page's title is passed separately. */
  trail: Crumb[];
  current: string;
  class?: string;
  /** A matte pill, for use on the dark hero band. */
  pill?: boolean;
}
const { trail, current, class: klass, pill = false } = Astro.props;

const items = [{ label: 'Home', href: '/' }, ...trail];

/* Search engines read the trail from JSON-LD rather than the markup. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    ...items.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: new URL(c.href ?? '/', site.url).href,
    })),
    {
      '@type': 'ListItem',
      position: items.length + 1,
      name: current,
      item: new URL(Astro.url.pathname, site.url).href,
    },
  ],
};
---

<nav aria-label="Breadcrumb" class={klass} data-pagefind-ignore>
  <ol
    class:list={[
      'flex max-w-full flex-nowrap items-center gap-x-1.5 overflow-hidden',
      pill
        ? 'crumb-pill rounded-full bg-matte px-3.5 py-1.5 text-xs text-dim'
        : 'font-mono text-caption tracking-[0.1em] text-faint uppercase',
    ]}
  >
    {items.map((c) => (
      <li class="flex shrink-0 items-center gap-1.5 whitespace-nowrap">
        <a href={c.href ?? '/'} class="transition-colors hover:text-accent-ink">
          {c.label}
        </a>
        <span aria-hidden="true" class="text-line-strong">
          /
        </span>
      </li>
    ))}
    <li class="min-w-0">
      {/* The current page is named but not linked, which is what aria-current
          marks; truncating keeps a long title from wrapping the whole trail. */}
      <span
        aria-current="page"
        data-truncate-words
        class:list={['block max-w-full truncate sm:max-w-[34rem]', pill ? 'text-ink' : 'text-dim']}
      >
        {current}
      </span>
    </li>
  </ol>
</nav>

<script>
  import { initTruncateWords } from '../lib/truncate-words';
  document.addEventListener('astro:page-load', initTruncateWords);
</script>

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

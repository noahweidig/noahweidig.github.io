---
interface Props {
  kicker?: string;
  title: string;
  subtitle?: string;
  href?: string;
  linkText?: string;
}
const { kicker, title, subtitle, href, linkText } = Astro.props;
---

<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
  <div>
    {kicker && <p class="kicker">{kicker}</p>}
    <h2 class="section-title">{title}</h2>
    {subtitle && <p class="lede mt-3">{subtitle}</p>}
  </div>
  {
    href && (
      <a
        href={href}
        class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-dim transition-colors hover:text-accent-ink"
      >
        {linkText ?? 'View all'}
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    )
  }
</div>

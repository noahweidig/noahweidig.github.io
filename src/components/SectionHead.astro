---
import Icon from './Icon.astro';

interface Props {
  kicker?: string;
  title: string;
  subtitle?: string;
  href?: string;
  linkText?: string;
}
const { kicker, title, subtitle, href, linkText } = Astro.props;
---

<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
  <div>
    {kicker && <p class="kicker">{kicker}</p>}
    <h2 class="section-title">{title}</h2>
    {subtitle && <p class="lede mt-3">{subtitle}</p>}
  </div>
  {
    href && (
      <a href={href} class="btn btn-ghost btn-sm group shrink-0 self-end">
        {linkText ?? 'View all'}
        <Icon
          name="arrow"
          size={15}
          class="transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    )
  }
</div>

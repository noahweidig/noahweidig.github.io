---
interface Props {
  kicker?: string;
  title: string;
  subtitle?: string;
  href?: string;
  linkLabel?: string;
}
const { kicker, title, subtitle, href, linkLabel } = Astro.props;
---

<header class="sh">
  {(kicker || href) && (
    <div class="sh-top xw">
      <span>{kicker}</span>
      {href && (
        <a href={href} class="sh-more">
          All {linkLabel ?? 'items'}
          <span aria-hidden="true"> →</span>
        </a>
      )}
    </div>
  )}
  <h2 class="sh-title xc">{title}</h2>
  {subtitle && <p class="sh-sub">{subtitle}</p>}
</header>

<style>
  .sh {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }
  .sh-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    color: var(--c-ink);
  }
  .sh-more {
    text-underline-offset: 4px;
  }
  .sh-more:hover {
    text-decoration: underline;
  }
  .sh-title {
    margin: 0;
    font-size: clamp(3rem, 10vw, 8.5rem);
    text-wrap: balance;
  }
  .sh-sub {
    max-width: 40rem;
    color: var(--c-dim);
    font-size: var(--text-lead);
  }
</style>

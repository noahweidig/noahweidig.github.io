---
/* Shared colour field behind hero sections (home, about). */
---

{/* Large, heavily blurred fields: overlapping blurs give the soft mesh falloff.
    Sized in vw so the composition holds at any width. */}
<div class="hero-mesh" aria-hidden="true">
  <span class="hero-blob hero-blob-1"></span>
  <span class="hero-blob hero-blob-2"></span>
  <span class="hero-blob hero-blob-3"></span>
  <span class="hero-blob hero-blob-4"></span>
  <span class="hero-blob hero-blob-5"></span>
  <span class="hero-blob hero-blob-6"></span>
</div>
{/* Readability scrim: pulls the area behind the copy back toward the page
    ground so body text clears AA, leaving the bloom around it. */}
<div class="hero-scrim" aria-hidden="true"></div>

<style>
  .hero-mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    filter: blur(var(--hero-blur));
    opacity: var(--hero-opacity);
    contain: strict;
    clip-path: inset(0);
  }

  /* Positioned by centre and pulled back half its own size, so the bright core
     of each field lands inside the frame. Anchoring by edge put the cores off
     canvas and left only the falloff showing. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        100% 70% at 26% 58%,
        var(--c-bg) 0%,
        color-mix(in oklab, var(--c-bg) 62%, transparent) 36%,
        transparent 72%
      ),
      linear-gradient(to bottom, transparent 55%, var(--c-bg) 100%);
  }

  .hero-blob {
    position: absolute;
    display: block;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    /* Screen over the near-black ground is what makes these read as light rather than paint — overlapping fields add up instead of occluding. */
    mix-blend-mode: var(--hero-blend);
  }

  /* A plateau before the falloff: a bare closest-side gradient peaks at a
     single point and reads as a spotlight rather than a field of colour. */
  .hero-blob-1 {
    top: 26%;
    left: 14%;
    width: 92vw;
    height: 92vw;
    background: radial-gradient(
      circle at center,
      var(--hero-1) 0%,
      var(--hero-1) 30%,
      transparent 68%
    );
  }

  .hero-blob-2 {
    top: 16%;
    left: 88%;
    width: 86vw;
    height: 86vw;
    background: radial-gradient(
      circle at center,
      var(--hero-2) 0%,
      var(--hero-2) 28%,
      transparent 66%
    );
  }

  /* The seam between the two: without it they read as two separate lights
     rather than one field that changes hue across the section. */
  .hero-blob-3 {
    top: 92%;
    left: 52%;
    width: 88vw;
    height: 70vw;
    background: radial-gradient(
      circle at center,
      color-mix(in oklab, var(--hero-1) 55%, var(--hero-2)) 0%,
      color-mix(in oklab, var(--hero-1) 55%, var(--hero-2)) 26%,
      transparent 66%
    );
  }

  .hero-blob-4 {
    top: 78%;
    left: 84%;
    width: 70vw;
    height: 70vw;
    background: radial-gradient(
      circle at center,
      var(--hero-3) 0%,
      var(--hero-3) 26%,
      transparent 64%
    );
  }

  .hero-blob-5 {
    top: 50%;
    left: 55%;
    width: 60vw;
    height: 60vw;
    opacity: 0.55;
    background: radial-gradient(
      circle at center,
      var(--hero-4) 0%,
      var(--hero-4) 22%,
      transparent 62%
    );
  }

  .hero-blob-6 {
    top: 8%;
    left: 50%;
    width: 60vw;
    height: 50vw;
    opacity: 0.8;
    background: radial-gradient(
      circle at center,
      var(--hero-5) 0%,
      var(--hero-5) 24%,
      transparent 64%
    );
  }

  /* Mobile: a static field. Animating blobs under a 70px filter re-blurs the
     whole layer every frame, which is the bulk of the page's GPU memory. */
  @media (max-width: 1023px) {
    .hero-blob {
      animation: none !important;
    }
  }

  @media (min-width: 1024px) {
    .hero-blob-5 {
      width: 38vw;
      height: 38vw;
    }
    .hero-blob-4 {
      width: 44vw;
      height: 44vw;
    }
    .hero-blob-1 {
      width: 62vw;
      height: 62vw;
    }
    .hero-blob-2 {
      width: 58vw;
      height: 58vw;
    }
    .hero-blob-3 {
      width: 60vw;
      height: 46vw;
    }
    .hero-blob-6 {
      width: 40vw;
      height: 32vw;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-blob-1 {
      animation: drift-a 26s var(--ease-in-out-soft) infinite alternate;
    }
    .hero-blob-2 {
      animation: drift-b 32s var(--ease-in-out-soft) infinite alternate;
    }
    .hero-blob-3 {
      animation: drift-c 38s var(--ease-in-out-soft) infinite alternate;
    }
    .hero-blob-5 {
      animation: drift-c 30s var(--ease-in-out-soft) infinite alternate-reverse;
    }
    .hero-blob-6 {
      animation: drift-b 36s var(--ease-in-out-soft) infinite alternate-reverse;
    }
    .hero-blob-4 {
      animation: drift-a 34s var(--ease-in-out-soft) infinite alternate-reverse;
    }
  }

  /* Transform only — animating the blur or the gradient would repaint the
     whole field every frame. The translate(-50%, -50%) has to be repeated in
     every keyframe or the blob snaps back to corner anchoring. */
  @keyframes drift-a {
    to {
      transform: translate(-50%, -50%) translate3d(5%, 7%, 0) scale(1.12);
    }
  }
  @keyframes drift-b {
    to {
      transform: translate(-50%, -50%) translate3d(-7%, 5%, 0) scale(1.08);
    }
  }
  @keyframes drift-c {
    to {
      transform: translate(-50%, -50%) translate3d(4%, -6%, 0) scale(1.14);
    }
  }
</style>

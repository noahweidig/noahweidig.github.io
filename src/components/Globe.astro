---
/** Interactive MapLibre map centred on Orlando. Loaded lazily by src/scripts/globe.ts. */
interface Props {
  class?: string;
}
const { class: klass = '' } = Astro.props;
---

<figure class:list={['card relative aspect-square w-full overflow-hidden', klass]}>
  <div class="absolute inset-0">
    <div
      class="h-full w-full"
      data-map-mount
      role="region"
      aria-label="Map of Orlando, Florida"
    ></div>
  </div>
</figure>

<style is:global>
  [data-theme='dark'] .maplibregl-ctrl-group {
    background: var(--c-surface);
    box-shadow: 0 0 0 1px var(--c-line);
  }
  [data-theme='dark'] .maplibregl-ctrl-group button + button {
    border-top-color: var(--c-line);
  }
  [data-theme='dark'] .maplibregl-ctrl-group .maplibregl-ctrl-icon {
    filter: invert(1);
  }
  .maplibregl-popup-content {
    color: #111;
  }
  [data-theme='dark'] .maplibregl-popup-content {
    background: var(--c-surface);
    color: var(--c-ink);
  }
  [data-theme='dark'] .maplibregl-popup-anchor-bottom .maplibregl-popup-tip {
    border-top-color: var(--c-surface);
  }
</style>

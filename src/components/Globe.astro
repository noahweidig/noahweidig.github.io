---
/** Interactive MapLibre map centred on Orlando. Loaded lazily by src/scripts/globe.ts. */
interface Props {
  class?: string;
}
const { class: klass = '' } = Astro.props;
---

<figure class:list={['card relative aspect-square w-full overflow-hidden', klass]}>
  <div class="absolute inset-0" data-map-mount role="region" aria-label="Map of Orlando, Florida">
  </div>
</figure>

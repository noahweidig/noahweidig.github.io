---
import Icon from './Icon.astro';
---

<dialog
  data-pagefind-ignore
  id="site-search"
  class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm"
  aria-label="Search"
>
  {/* Phone: the dialog is the page — a 3-inch-wide popup with a scrolling list
      inside it wastes most of the screen. From `sm` up it returns to a panel. */}
  <div
    class="flex min-h-full items-stretch justify-center p-0 sm:items-start sm:p-4 sm:pt-[10vh]"
    data-search-backdrop
  >
    <div
      class="card flex w-full max-w-none flex-col overflow-hidden rounded-none border-0 sm:max-w-3xl sm:rounded-[14px] sm:border"
      data-search-panel
    >
      <!-- query row -->
      {/* Phone: a pill-shaped field (icon, input, filter toggle) with a text
          Cancel beside it. `sm:contents` dissolves the pill wrapper so the
          desktop row is exactly what it was. */}
      <div class="flex items-center gap-2 border-b border-line px-3 py-2.5 sm:gap-3 sm:px-4 sm:py-0">
        <div class="flex min-w-0 flex-1 items-center gap-2 rounded-xl bg-raised px-3 sm:contents">
          <Icon name="search" size={18} class="shrink-0 text-faint" />
          <input
            type="text"
            id="search-input"
            role="combobox"
            aria-expanded="true"
            aria-controls="search-results"
            aria-autocomplete="list"
            placeholder="Search projects, papers, posts…"
            autocomplete="off"
            spellcheck="false"
            class="w-full bg-transparent py-3 text-base text-ellipsis text-ink placeholder:text-faint focus-visible:rounded-none focus-visible:outline-none sm:py-4 sm:text-body-lg"
          />
          <button
            type="button"
            data-filter-toggle
            aria-expanded="false"
            aria-controls="search-filters"
            class="relative grid h-8 w-8 shrink-0 place-items-center rounded-md text-faint transition-colors hover:bg-raised hover:text-ink aria-expanded:bg-line/70 aria-expanded:text-accent-ink sm:aria-expanded:bg-raised"
            title="Filters"
          >
            <Icon name="filter" size={17} />
            <span class="sr-only-nw">Toggle filters</span>
            <span
              data-filter-count
              hidden
              class="absolute -top-1 -right-1 grid h-4 min-w-4 place-items-center rounded-full bg-accent px-1 text-[0.6rem] font-semibold text-accent-contrast"
            ></span>
          </button>
        </div>
        <button
          type="button"
          data-search-close
          class="shrink-0 rounded-md px-1 py-2 text-[0.95rem] font-medium text-accent-ink sm:hidden"
        >
          Cancel
        </button>
        <kbd class="hidden shrink-0 rounded border border-line px-1.5 py-0.5 font-mono text-[0.65rem] text-faint sm:block">
          esc
        </kbd>
      </div>

      <!-- body: results + filter rail -->
      <div class="relative flex min-h-[16rem] flex-1 sm:max-h-[62vh] sm:flex-none" data-search-body>
        <div
          class="min-w-0 flex-1 overflow-y-auto p-2"
          id="search-results"
          role="listbox"
          aria-label="Search results"
        >
          <p class="px-3 py-10 text-center text-sm text-faint" data-search-empty>
            Type to search, or pick a filter.
          </p>
        </div>

        <aside
          id="search-filters"
          hidden
          class="w-44 shrink-0 overflow-y-auto border-l border-line bg-raised/60 p-4 sm:w-56"
          aria-label="Filters"
        >
          <div class="flex items-center justify-between">
            <h2 class="font-mono text-micro tracking-[0.16em] text-faint uppercase">Filters</h2>
            <button
              type="button"
              data-filter-clear
              hidden
              class="text-caption text-accent-ink hover:underline"
            >
              Clear
            </button>
          </div>
          <div class="mt-4 grid gap-5" data-filter-groups></div>
        </aside>
      </div>

      <!-- hint bar -->
      <div class="flex items-center gap-4 border-t border-line px-4 py-2.5 font-mono text-[0.65rem] text-faint">
        <span class="hidden items-center gap-1.5 sm:flex">
          <kbd class="rounded border border-line px-1">↑</kbd>
          <kbd class="rounded border border-line px-1">↓</kbd> navigate
        </span>
        <span class="hidden items-center gap-1.5 sm:flex">
          <kbd class="rounded border border-line px-1">↵</kbd> open
        </span>
        <span class="ml-auto" data-search-status aria-live="polite"></span>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* Phone: the filter rail drops down from the top of the results as a row of
     chips, instead of a sheet that hides half the list. The filter button
     closes it again. */
  @media (max-width: 39.99rem) {
    [data-search-body] {
      flex-direction: column;
    }
    #search-filters:not([hidden]) {
      order: -1;
      width: auto;
      max-height: 40vh;
      border-left: 0;
      border-bottom: 1px solid var(--c-line);
      background: var(--c-surface);
    }
    #search-filters :global(ul) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    #search-filters :global(button[data-filter-key]) {
      width: auto;
      gap: 0.4rem;
      padding: 0.4rem 0.8rem;
      border: 1px solid var(--c-line-strong);
      border-radius: 9999px;
      font-size: 0.85rem;
    }
    #search-filters :global(button[data-filter-key] > span:first-child) {
      display: none;
    }
    #search-filters :global(button[aria-pressed='true']) {
      border-color: var(--c-accent);
      background: color-mix(in oklab, var(--c-accent) 12%, var(--c-surface));
    }
  }
</style>

---
import Icon from './Icon.astro';
---

<dialog
  data-pagefind-ignore
  id="site-search"
  class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-black/40 backdrop:backdrop-blur-md"
  aria-label="Search"
>
  {/* Phone: the dialog is the page — a 3-inch-wide popup with a scrolling list
      inside it wastes most of the screen. From `sm` up it returns to a panel. */}
  <div
    class="flex min-h-full items-stretch justify-center p-0 sm:items-start sm:p-6 sm:pt-[9vh]"
    data-search-backdrop
  >
    <div
      class="card flex w-full max-w-none flex-col overflow-hidden rounded-none border-0 sm:max-w-[42.5rem] sm:rounded-2xl sm:border sm:border-line-strong sm:shadow-2xl"
      data-search-panel
    >
      <!-- query row -->
      {/* Phone: a pill-shaped field (icon, input, filter toggle) with a text
          close circle beside it. `sm:contents` dissolves the pill wrapper so the
          desktop row is exactly what it was. */}
      <div class="flex h-16 items-center gap-2 border-b border-line px-5 sm:h-auto sm:gap-3.5 sm:bg-raised/40 sm:px-6 sm:py-1">
        <div class="flex min-w-0 flex-1 items-center gap-2 rounded-full bg-raised px-4 sm:contents">
          <Icon
            name="nav-search"
            size={21}
            stroke-width={1.8}
            class="shrink-0 text-faint sm:text-accent-ink"
          />
          <input
            type="text"
            id="search-input"
            aria-label="Search the site"
            role="combobox"
            aria-expanded="true"
            aria-controls="search-results"
            aria-autocomplete="list"
            placeholder="Search projects, papers, posts…"
            autocomplete="off"
            spellcheck="false"
            class="w-full bg-transparent py-3 text-base text-ellipsis text-ink placeholder:text-faint focus-visible:rounded-none focus-visible:outline-none sm:py-5 sm:text-xl sm:tracking-tight"
          />
          <button
            type="button"
            data-search-clear
            hidden
            class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-faint text-bg"
            aria-label="Clear search"
          >
            <Icon name="nav-x" size={12} stroke-width={3} />
          </button>
          <button
            type="button"
            data-filter-toggle
            aria-expanded="false"
            aria-controls="search-filters"
            class="icon-tile icon-bare relative h-8 w-8 shrink-0 rounded-full max-sm:-mr-1 text-faint hover:transform-none! aria-expanded:bg-accent aria-expanded:text-accent-contrast sm:hidden"
            data-tip="Filters"
          >
            <Icon name="nav-listFilter" size={17} stroke-width={2.2} />
            <span class="sr-only-nw">Toggle filters</span>
            <span
              data-filter-count
              hidden
              class="absolute -top-1 -right-1 grid h-4 min-w-4 place-items-center rounded-full bg-accent px-1 ring-2 ring-raised text-micro font-semibold text-accent-contrast"
            ></span>
          </button>
        </div>
        <button
          type="button"
          data-search-close
          class="icon-tile icon-bare h-10 w-10 shrink-0 hover:transform-none! sm:h-9 sm:w-9"
          aria-label="Close search"
        >
          <Icon name="nav-x" size={22} stroke-width={1.8} class="sm:hidden" />
          <Icon name="nav-x" size={17} stroke-width={2.2} class="hidden sm:block" />
        </button>
      </div>

      {/* Desktop: section/tag chips replace the filter rail and its toggle. Empty
          until Pagefind reports counts, hence the inline display:none. */}
      <div
        data-search-chips
        style="display:none"
        class="hidden gap-1.5 overflow-x-auto border-b border-line px-6 py-2.5 [scrollbar-width:none] sm:flex"
        aria-label="Filters"
      ></div>

      <!-- body: results (+ filter rail on phone) -->
      {/* Desktop: height is set from the content in search.ts and animates. */}
      <div
        class="relative flex min-h-[16rem] flex-1 sm:h-0 sm:min-h-0 sm:flex-none sm:overflow-hidden sm:transition-[height] sm:duration-300 sm:ease-out"
        data-search-body
      >
        <div
          class="relative min-w-0 flex-1 overflow-y-auto p-2 sm:p-3"
          id="search-results"
          role="listbox"
          aria-label="Search results"
        >
          <p
            role="presentation"
            class="px-3 py-10 text-center text-sm text-faint"
            data-search-empty
          >
            Type to search, or pick a filter.
          </p>
        </div>

        <aside
          id="search-filters"
          hidden
          class="w-44 shrink-0 overflow-y-auto border-l border-line bg-raised/60 p-4 sm:hidden"
          aria-label="Filters"
        >
          <div class="grid gap-5" data-filter-groups></div>
        </aside>
      </div>

      <!-- hint bar -->
      <div class="flex items-center gap-4 border-t border-line px-4 py-2.5 font-mono text-micro text-faint sm:bg-raised/40 sm:px-6 sm:py-3">
        <span class="hidden items-center gap-1.5 sm:flex">
          <kbd class="grid size-6 place-items-center rounded border border-line-strong bg-surface">
            <Icon name="arrowUp" size={14} />
          </kbd>
          <kbd class="grid size-6 place-items-center rounded border border-line-strong bg-surface">
            <Icon name="arrowDown" size={14} />
          </kbd>{' '}
          navigate
        </span>
        <span class="hidden items-center gap-1.5 sm:flex">
          <kbd class="grid size-6 place-items-center rounded border border-line-strong bg-surface">
            <Icon name="cornerDownLeft" size={14} />
          </kbd>{' '}
          open
        </span>
        <span class="ml-auto" data-search-status aria-live="polite"></span>
      </div>
    </div>
  </div>
</dialog>

<style is:global>
  @media (min-width: 40rem) {
    /* Same glass as the scrolled nav bar: translucent bg, blur, hairline. */
    #site-search [data-search-panel] {
      background-color: color-mix(in oklab, var(--c-bg) 68%, transparent);
      border-color: color-mix(in oklab, var(--c-line-strong) 70%, transparent);
      -webkit-backdrop-filter: blur(18px) saturate(1.6);
      backdrop-filter: blur(18px) saturate(1.6);
      box-shadow:
        inset 0 1px 0 color-mix(in oklab, var(--c-ink) 8%, transparent),
        0 24px 64px -12px color-mix(in oklab, var(--c-bg-deep) 75%, transparent);
    }
    /* A lighter scrim so the panel has something to frost. */
    #site-search::backdrop {
      background-color: color-mix(in oklab, var(--c-bg-deep) 30%, transparent);
      -webkit-backdrop-filter: blur(3px);
      backdrop-filter: blur(3px);
    }
    #site-search[open] [data-search-panel] {
      transform-origin: 50% 0;
      animation: search-pop 0.38s cubic-bezier(0.2, 1.1, 0.3, 1) both;
    }
    .search-row {
      animation: search-row-in 0.32s cubic-bezier(0.2, 1, 0.3, 1) both;
      animation-delay: calc(var(--i, 0) * 22ms);
    }
    .search-go {
      opacity: 0;
      transform: translateX(-4px);
      transition:
        opacity 0.2s,
        transform 0.2s;
    }
    .search-row[aria-selected='true'] .search-go {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes search-pop {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.965);
    }
  }
  @keyframes search-row-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #site-search [data-search-panel],
    .search-row {
      animation: none !important;
    }
  }
</style>

<style>
  /* Phone: the filter rail drops down from the top of the results as a row of
     chips, instead of a sheet that hides half the list. The filter button
     closes it again. */
  @media (max-width: 39.99rem) {
    :global(html[data-search-lock] body) {
      position: fixed;
      inset-inline: 0;
      top: var(--search-lock-y, 0);
      width: 100%;
    }
    /* The dialog never scrolls: the query row and filter row stay put and only
       the results list scrolls. Same background as the mobile menu. */
    #site-search {
      height: 100dvh;
      overflow: hidden;
    }
    [data-search-backdrop] {
      height: 100%;
      min-height: 0;
    }
    [data-search-panel] {
      height: 100%;
      min-height: 0;
      background: var(--c-bg);
    }
    [data-search-body] {
      flex-direction: column;
      min-height: 0;
    }
    #search-results {
      min-height: 0;
      overscroll-behavior: contain;
    }
    #search-filters:not([hidden]) {
      order: -1;
      width: auto;
      max-height: 40vh;
      padding: 0.75rem 1.25rem;
      border-left: 0;
      border-bottom: 1px solid var(--c-line);
      background: var(--c-bg);
    }
    #search-filters {
      overflow: hidden;
    }
    /* One swipeable row that runs off the right edge of the screen. */
    #search-filters [data-filter-groups] {
      display: flex;
      gap: 0.5rem;
      margin-inline: -1.25rem;
      padding-inline: 1.25rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    #search-filters [data-filter-groups]::-webkit-scrollbar {
      display: none;
    }
    #search-filters [data-filter-groups] :global(div),
    #search-filters [data-filter-groups] :global(ul) {
      display: contents;
    }
    #search-filters [data-filter-groups] :global(h3) {
      display: none;
    }
    #search-filters [data-filter-groups] :global(li) {
      flex: none;
    }
    #search-filters :global(button[data-filter-key]) {
      white-space: nowrap;
    }
    #search-filters :global(button[data-filter-key]) {
      width: auto;
      gap: 0.4rem;
      padding: 0.25rem 0.75rem;
      border: 1px solid var(--c-line-strong);
      border-radius: 9999px;
      font-size: var(--text-small);
      color: var(--c-dim);
    }
    #search-filters :global(button[data-filter-key] > span:last-child) {
      color: inherit;
      opacity: 0.7;
    }
    #search-filters :global(button[data-filter-key] > span:first-child) {
      display: none;
    }
  }
  /* Selected filters: solid accent fill, white text. */
  #search-filters :global(button[aria-pressed='true']) {
    border-color: var(--c-accent);
    background: var(--c-accent);
    color: var(--c-accent-contrast);
  }
  #search-filters :global(button[aria-pressed='true'] span) {
    color: inherit;
  }
  #search-filters :global(button[aria-pressed='true'] > span:first-child) {
    border-color: currentColor;
    background: transparent;
  }
</style>

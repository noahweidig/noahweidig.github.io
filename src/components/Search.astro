---
import Icon from './Icon.astro';
---

<dialog
  data-pagefind-ignore
  id="site-search"
  class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm"
  aria-label="Search"
>
  {/* Phone: the dialog is the page — a 3-inch-wide popup with a scrolling list
      inside it wastes most of the screen. From `sm` up it returns to a panel. */}
  <div
    class="flex min-h-full items-stretch justify-center p-0 sm:items-start sm:p-6 sm:pt-[9vh]"
    data-search-backdrop
  >
    <div
      class="card flex w-full max-w-none flex-col overflow-hidden rounded-none border-0 sm:max-w-4xl sm:rounded-2xl sm:border sm:border-line-strong sm:shadow-[0_32px_80px_-20px_rgb(0_0_0/0.55),0_0_0_1px_rgb(255_255_255/0.04)]"
      data-search-panel
    >
      <!-- query row -->
      {/* Phone: a pill-shaped field (icon, input, filter toggle) with a text
          close circle beside it. `sm:contents` dissolves the pill wrapper so the
          desktop row is exactly what it was. */}
      <div class="flex h-16 items-center gap-2 border-b border-line px-5 sm:h-auto sm:gap-3.5 sm:bg-raised/40 sm:px-6 sm:py-1">
        <div class="flex min-w-0 flex-1 items-center gap-2 rounded-xl bg-raised px-3 sm:contents">
          <Icon
            name="nav-search"
            size={21}
            stroke-width={1.8}
            class="shrink-0 text-faint sm:text-accent-ink"
          />
          <input
            type="text"
            id="search-input"
            aria-label="Search the site"
            role="combobox"
            aria-expanded="true"
            aria-controls="search-results"
            aria-autocomplete="list"
            placeholder="Search projects, papers, posts…"
            autocomplete="off"
            spellcheck="false"
            class="w-full bg-transparent py-3 text-base text-ellipsis text-ink placeholder:text-faint focus-visible:rounded-none focus-visible:outline-none sm:py-5 sm:text-xl sm:tracking-tight"
          />
          <button
            type="button"
            data-filter-toggle
            aria-expanded="false"
            aria-controls="search-filters"
            class="icon-tile icon-bare relative h-8 w-8 shrink-0 text-faint hover:transform-none! aria-expanded:bg-accent aria-expanded:text-accent-contrast sm:h-9 sm:w-9"
            title="Filters"
          >
            <Icon name="nav-listFilter" size={17} stroke-width={2.2} />
            <span class="sr-only-nw">Toggle filters</span>
            <span
              data-filter-count
              hidden
              class="absolute -top-1 -right-1 grid h-4 min-w-4 place-items-center rounded-full bg-accent px-1 text-[0.6rem] font-semibold text-accent-contrast"
            ></span>
          </button>
        </div>
        <button
          type="button"
          data-search-close
          class="icon-tile icon-bare h-10 w-10 shrink-0 hover:transform-none! sm:h-9 sm:w-9"
          aria-label="Close search"
        >
          <Icon name="nav-x" size={28} stroke-width={1.36} class="sm:hidden" />
          <Icon name="nav-x" size={17} stroke-width={2.2} class="hidden sm:block" />
        </button>
      </div>

      <!-- body: results + filter rail -->
      <div
        class="relative flex min-h-[16rem] flex-1 sm:h-[min(36rem,68vh)] sm:flex-none"
        data-search-body
      >
        <div
          class="min-w-0 flex-1 overflow-y-auto p-2 sm:p-3"
          id="search-results"
          role="listbox"
          aria-label="Search results"
        >
          <p
            role="presentation"
            class="px-3 py-10 text-center text-sm text-faint sm:py-24"
            data-search-empty
          >
            Type to search, or pick a filter.
          </p>
        </div>

        <aside
          id="search-filters"
          hidden
          class="w-44 shrink-0 overflow-y-auto border-l border-line bg-raised/60 p-4 sm:w-64 sm:p-6"
          aria-label="Filters"
        >
          <div class="grid gap-5" data-filter-groups></div>
        </aside>
      </div>

      <!-- hint bar -->
      <div class="flex items-center gap-4 border-t border-line px-4 py-2.5 font-mono text-[0.65rem] text-faint sm:bg-raised/40 sm:px-6 sm:py-3">
        <span class="hidden items-center gap-1.5 sm:flex">
          <kbd class="rounded border border-line-strong bg-surface px-1.5 py-0.5">↑</kbd>
          <kbd class="rounded border border-line-strong bg-surface px-1.5 py-0.5">↓</kbd> navigate
        </span>
        <span class="hidden items-center gap-1.5 sm:flex">
          <kbd class="rounded border border-line-strong bg-surface px-1.5 py-0.5">↵</kbd> open
        </span>
        <span class="ml-auto" data-search-status aria-live="polite"></span>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* Phone: the filter rail drops down from the top of the results as a row of
     chips, instead of a sheet that hides half the list. The filter button
     closes it again. */
  @media (max-width: 39.99rem) {
    [data-search-body] {
      flex-direction: column;
    }
    #search-filters:not([hidden]) {
      order: -1;
      width: auto;
      max-height: 40vh;
      padding: 0.5rem 1.25rem 1rem;
      border-left: 0;
      border-bottom: 1px solid var(--c-line);
      background: var(--c-surface);
    }
    #search-filters {
      overflow: hidden;
    }
    /* One swipeable row that runs off the right edge of the screen. */
    #search-filters [data-filter-groups] {
      display: flex;
      gap: 0.5rem;
      margin-inline: -1.25rem;
      padding-inline: 1.25rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    #search-filters [data-filter-groups]::-webkit-scrollbar {
      display: none;
    }
    #search-filters [data-filter-groups] :global(div),
    #search-filters [data-filter-groups] :global(ul) {
      display: contents;
    }
    #search-filters [data-filter-groups] :global(h3) {
      display: none;
    }
    #search-filters [data-filter-groups] :global(li) {
      flex: none;
    }
    #search-filters :global(button[data-filter-key]) {
      white-space: nowrap;
    }
    #search-filters :global(button[data-filter-key]) {
      width: auto;
      gap: 0.4rem;
      padding: 0.4rem 0.8rem;
      border: 1px solid var(--c-line-strong);
      border-radius: 9999px;
      font-size: 0.85rem;
    }
    #search-filters :global(button[data-filter-key] > span:first-child) {
      display: none;
    }
  }
  /* Selected filters: solid accent fill, white text. */
  #search-filters :global(button[aria-pressed='true']) {
    border-color: var(--c-accent);
    background: var(--c-accent);
    color: var(--c-accent-contrast);
  }
  #search-filters :global(button[aria-pressed='true'] span) {
    color: inherit;
  }
  #search-filters :global(button[aria-pressed='true'] > span:first-child) {
    border-color: currentColor;
    background: transparent;
  }
</style>

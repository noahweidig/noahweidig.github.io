---
import Icon from './Icon.astro';
---

<dialog
  data-pagefind-ignore
  id="site-search"
  class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm"
  aria-label="Search"
>
  {
    /* Phone: the dialog is the page — a 3-inch-wide popup with a scrolling list
      inside it wastes most of the screen. From `sm` up it returns to a panel. */
  }
  <div
    class="flex min-h-full items-stretch justify-center p-0 sm:items-start sm:p-4 sm:pt-[10vh]"
    data-search-backdrop
  >
    <div
      class="card flex w-full max-w-none flex-col overflow-hidden rounded-none border-0 sm:max-w-3xl sm:rounded-[14px] sm:border"
      data-search-panel
    >
      <!-- query row -->
      <div class="flex items-center gap-3 border-b border-line px-4">
        {/* Phone: no esc key, so the leading icon doubles as the way out. */}
        <button
          type="button"
          data-search-close
          class="-ml-1 grid h-8 w-8 shrink-0 place-items-center rounded-md text-faint transition-colors hover:bg-raised hover:text-ink sm:hidden"
        >
          <Icon name="search" size={18} />
          <span class="sr-only-nw">Close search</span>
        </button>
        <Icon name="search" size={18} class="hidden shrink-0 text-faint sm:block" />
        <input
          type="text"
          id="search-input"
          role="combobox"
          aria-expanded="true"
          aria-controls="search-results"
          aria-autocomplete="list"
          placeholder="Search projects, papers, posts…"
          autocomplete="off"
          spellcheck="false"
          class="w-full bg-transparent py-4 text-base text-ink placeholder:text-faint sm:text-[0.95rem]"
        />
        <button
          type="button"
          data-filter-toggle
          aria-expanded="false"
          aria-controls="search-filters"
          class="relative grid h-8 w-8 shrink-0 place-items-center rounded-md text-faint transition-colors hover:bg-raised hover:text-ink aria-expanded:bg-raised aria-expanded:text-accent-ink"
          title="Filters"
        >
          <Icon name="filter" size={17} />
          <span class="sr-only-nw">Toggle filters</span>
          <span
            data-filter-count
            hidden
            class="absolute -top-1 -right-1 grid h-4 min-w-4 place-items-center rounded-full bg-accent px-1 text-[0.6rem] font-semibold text-accent-contrast"
          ></span>
        </button>
        <kbd
          class="hidden shrink-0 rounded border border-line px-1.5 py-0.5 font-mono text-[0.65rem] text-faint sm:block"
          >esc</kbd
        >
      </div>

      <!-- body: results + filter rail -->
      <div class="relative flex min-h-[16rem] flex-1 sm:max-h-[62vh] sm:flex-none" data-search-body>
        <div
          class="min-w-0 flex-1 overflow-y-auto p-2"
          id="search-results"
          role="listbox"
          aria-label="Search results"
        >
          <p class="px-3 py-10 text-center text-sm text-faint" data-search-empty>
            Type to search, or pick a filter.
          </p>
        </div>

        <aside
          id="search-filters"
          hidden
          class="w-44 shrink-0 overflow-y-auto border-l border-line bg-raised/60 p-4 sm:w-56"
          aria-label="Filters"
        >
          <div class="flex items-center justify-between">
            <h2 class="font-mono text-[0.68rem] tracking-[0.16em] text-faint uppercase">Filters</h2>
            <button
              type="button"
              data-filter-clear
              hidden
              class="text-[0.72rem] text-accent-ink hover:underline">Clear</button
            >
          </div>
          <div class="mt-4 grid gap-5" data-filter-groups></div>
        </aside>
      </div>

      <!-- hint bar -->
      <div
        class="flex items-center gap-4 border-t border-line px-4 py-2.5 font-mono text-[0.65rem] text-faint"
      >
        <span class="flex items-center gap-1.5"
          ><kbd class="rounded border border-line px-1">↑</kbd><kbd
            class="rounded border border-line px-1">↓</kbd
          > navigate</span
        >
        <span class="flex items-center gap-1.5"
          ><kbd class="rounded border border-line px-1">↵</kbd> open</span
        >
        <span class="ml-auto" data-search-status aria-live="polite"></span>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* Phone: the rail slides over the results rather than squeezing them into a
     column two words wide. The filter button closes it again. */
  @media (max-width: 39.99rem) {
    #search-filters:not([hidden]) {
      position: absolute;
      inset-block: 0;
      right: 0;
      z-index: 2;
      width: min(13.5rem, 58%);
      background: var(--c-surface);
      /* Only along the left edge, and only enough to lift the panel off the
         list behind it. */
      box-shadow: -6px 0 10px -8px rgb(0 0 0 / 0.45);
    }
  }
</style>

---
import { u } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Detail from '../../layouts/Detail.astro';
import { fullDate } from '../../lib/format';

export async function getStaticPaths() {
  // Sorted the way the listing is, so "previous" and "next" mean what a reader
  // saw there rather than an arbitrary collection order.
  const items = (await getCollection('awards')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  const sibling = (entry: (typeof items)[number] | undefined) =>
    entry ? { href: `/awards/${entry.id}/`, title: entry.data.title } : null;

  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sibling(items[i - 1]), next: sibling(items[i + 1]) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
// The award's own cover, sized for og:image/twitter:image, so a shared link
// shows this award's art instead of the sitewide default (site.ogImage).
const ogImage = d.image ? (await getImage({ src: d.image, width: 1200 })).src : undefined;
---

<Detail
  title={d.title}
  description={d.description}
  kicker="Award"
  meta={`${d.description ?? ''}${d.description ? ' · ' : ''}${fullDate(d.date)}`}
  section="Awards"
  prev={prev}
  next={next}
  backHref={u('/awards/')}
  backLabel="All awards"
  image={ogImage}
  publishedTime={d.date}
>
  <Content />
</Detail>

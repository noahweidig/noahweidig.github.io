---
import { u } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Detail from '../../layouts/Detail.astro';
import { fullDate } from '../../lib/format';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  // Sorted the way the listing is, so "previous" and "next" mean what a reader
  // saw there rather than an arbitrary collection order.
  const items = (await getCollection('awards')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  const sibling = (entry: (typeof items)[number] | undefined) =>
    entry ? { href: `/awards/${entry.id}/`, title: entry.data.title } : null;

  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sibling(items[i - 1]), next: sibling(items[i + 1]) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
// The award's own cover, sized for og:image/twitter:image, so a shared link
// shows this award's art instead of the sitewide default (site.ogImage).
const ogImageResult = d.image ? await getImage({ src: d.image, width: 1200 }) : undefined;
const ogImage = ogImageResult?.src;
const ogImageWidth = ogImageResult?.attributes.width;
const ogImageHeight = ogImageResult?.attributes.height;

// Same generic CreativeWork shape the Projects detail page uses — schema.org
// has no dedicated "Award" entity, so this keeps the page's structured data
// consistent with the rest of the site rather than inventing a type Google's
// Rich Results Test wouldn't recognize.
const awardLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.description,
  dateCreated: d.date.toISOString(),
  url: new URL(Astro.url.pathname, Astro.site).href,
  author: { '@id': `${site.url}/#person` },
};
---

<Detail
  title={d.title}
  description={d.description}
  kicker="Award"
  meta={`${d.description ?? ''}${d.description ? ' · ' : ''}${fullDate(d.date)}`}
  section="Awards"
  prev={prev}
  next={next}
  backHref={u('/awards/')}
  backLabel="All awards"
  image={ogImage}
  imageAlt={d['image-alt']}
  imageWidth={ogImageWidth}
  imageHeight={ogImageHeight}
  publishedTime={d.date}
>
  <Content />
</Detail>

<script type="application/ld+json" is:inline set:html={JSON.stringify(awardLd)} />

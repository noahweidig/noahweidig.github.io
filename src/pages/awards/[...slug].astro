---
import { u } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import Detail from '../../layouts/Detail.astro';
import { fullDate } from '../../lib/format';

export async function getStaticPaths() {
  const awards = await getCollection('awards');
  return awards.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Detail
  title={d.title}
  description={d.description}
  kicker="Award"
  meta={`${d.description ?? ''}${d.description ? ' · ' : ''}${fullDate(d.date)}`}
  backHref={u('/awards/')}
  backLabel="All awards"
  publishedTime={d.date}
>
  <Content />
</Detail>

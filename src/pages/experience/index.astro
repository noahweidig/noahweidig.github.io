---
import { getCollection } from 'astro:content';
import { u } from '../../lib/url';
import Page from '../../layouts/Page.astro';
import TimelineItem from '../../components/TimelineItem.astro';

const items = (await getCollection('experience')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Page
  section="Experience"
  title="Experience"
  kicker="Background"
  description="Roles and internships across GIS, remote sensing, and ecological research."
  intro="Roles and internships across GIS, remote sensing, and ecological research."
  wide={false}
  image={u('/media/og/experience.webp')}
>
  <h2 class="sr-only-nw">All experience</h2>
  <ul class="ml-1">
    {
      items.map((entry, i) => (
        <li>
          <TimelineItem entry={entry} base="experience" current={i === 0} />
        </li>
      ))
    }
  </ul>
</Page>

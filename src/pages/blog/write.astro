---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---

<Base title="Write a post" description="Draft and publish a new blog post." noindex>
  <section class="relative overflow-hidden border-b border-line bg-bg-deep">
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="shell relative py-12 text-center md:py-16">
      <p class="kicker justify-center">Blog</p>
      <h1 class="display-2 mt-4 font-display font-bold">Write a post</h1>
      <p class="lede mx-auto mt-5 text-balance">
        Sign in with GitHub, write the post, publish to open a pull request. Nothing goes live until
        the PR is merged.
      </p>
    </div>
  </section>

  <div class="shell py-10 md:py-14">
    <div data-write-app>
      <div class="card flex flex-wrap items-center justify-between gap-3 p-4">
        <span class="min-w-0 truncate text-sm text-dim">
          <span data-write-signed-out-status>Sign in with GitHub to write a post.</span>
          <span data-write-signed-in-status class="hidden">
            Signed in as <strong data-write-user class="text-body font-medium"></strong>
          </span>
        </span>
        <div class="flex shrink-0 items-center gap-2">
          <button type="button" data-write-login class="btn btn-primary btn-sm gap-2">
            <Icon name="github" size={16} />
            Login with GitHub
          </button>
          <button type="button" data-write-logout class="btn btn-ghost btn-sm" hidden>
            Sign out
          </button>
        </div>
      </div>

      <p
        data-write-auth-error
        class="mt-4 rounded-md border px-3.5 py-2.5 text-sm data-[state=error]:border-ember/50 data-[state=error]:text-ember"
        role="status"
        aria-live="polite"
        hidden
      ></p>

      <div data-write-workspace class="hidden mt-8 gap-8 lg:grid lg:grid-cols-[1.1fr_1.6fr]">
        <div class="grid gap-6 [&>*]:min-w-0">
          <div class="card grid gap-5 p-6 [&>*]:min-w-0">
            <div class="grid gap-2">
              <label for="write-title" class="text-sm font-medium">
                Title
              </label>
              <input
                id="write-title"
                type="text"
                data-write-title
                placeholder="A post about something"
                required
                class="w-full rounded-md border border-line bg-raised px-3.5 py-2.5 text-body-lg transition-colors focus:border-accent"
              />
            </div>

            <div class="grid gap-2">
              <label for="write-slug" class="text-sm font-medium">
                Slug
              </label>
              <input
                id="write-slug"
                type="text"
                data-write-slug
                placeholder="a-post-about-something"
                pattern="[a-z0-9]+(-[a-z0-9]+)*"
                required
                class="w-full rounded-md border border-line bg-raised px-3.5 py-2.5 font-mono text-sm transition-colors focus:border-accent"
              />
              <p class="text-xs text-faint">
                src/content/blog/<span data-write-slug-preview>&lt;slug&gt;</span>/index.md
              </p>
            </div>

            <div class="grid gap-2">
              <label for="write-description" class="text-sm font-medium">
                Description
              </label>
              <textarea
                id="write-description"
                data-write-description
                rows="3"
                required
                placeholder="One or two sentences for the post card and meta description."
                class="w-full resize-y rounded-md border border-line bg-raised px-3.5 py-2.5 text-body-lg transition-colors focus:border-accent"
              ></textarea>
            </div>

            <div class="grid gap-2">
              <label for="write-categories" class="text-sm font-medium">
                Categories
              </label>
              <input
                id="write-categories"
                type="text"
                data-write-categories
                placeholder="Thoughts, R, GIS"
                class="w-full rounded-md border border-line bg-raised px-3.5 py-2.5 text-body-lg transition-colors focus:border-accent"
              />
              <p class="text-xs text-faint">Comma-separated. Optional.</p>
            </div>

            <div class="grid gap-2">
              <label for="write-date" class="text-sm font-medium">
                Date
              </label>
              <input
                id="write-date"
                type="date"
                data-write-date
                required
                class="w-full rounded-md border border-line bg-raised px-3.5 py-2.5 text-body-lg transition-colors focus:border-accent"
              />
            </div>

            <label class="flex items-center gap-2 text-sm">
              <input type="checkbox" data-write-draft class="h-4 w-4 rounded border-line" />
              Mark as draft (hidden from the blog index once merged)
            </label>
          </div>

          <button type="button" data-write-publish class="btn btn-primary w-full gap-2">
            <Icon name="check" size={18} />
            <span data-write-publish-label>Publish</span>
          </button>

          <p
            data-write-status
            class="rounded-md border px-3.5 py-2.5 text-sm data-[state=error]:border-ember/50 data-[state=error]:text-ember data-[state=ok]:border-moss/50 data-[state=ok]:text-moss"
            role="status"
            aria-live="polite"
            hidden
          ></p>
        </div>

        <div class="card min-w-0 overflow-hidden p-0">
          <div
            role="tablist"
            aria-label="Editor"
            class="flex gap-1 border-b border-line bg-raised p-1.5"
          >
            <button
              type="button"
              role="tab"
              aria-selected="true"
              data-write-tab="write"
              class="write-tab"
            >
              Write
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-write-tab="preview"
              class="write-tab"
            >
              Preview
            </button>
          </div>
          <textarea
            data-write-body
            aria-label="Post body (Markdown)"
            placeholder="Write your post in Markdown…"
            class="block h-[70vh] min-h-[420px] w-full resize-none bg-transparent p-4 font-mono text-sm leading-relaxed"
          ></textarea>
          <div
            data-write-preview
            class="prose-nw h-[70vh] min-h-[420px] overflow-y-auto p-6"
            hidden
          ></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import '../../scripts/blog-write';
  </script>
</Base>

<style>
  .write-tab {
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--c-dim);
  }
  .write-tab[aria-selected='true'] {
    background-color: var(--c-surface);
    color: var(--c-ink);
  }
</style>

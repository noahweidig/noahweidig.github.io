---
import { getCollection } from 'astro:content';
import { u } from '../../lib/url';
import Page from '../../layouts/Page.astro';
import PostCard from '../../components/PostCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { readingTime } from '../../lib/format';
import { site } from '../../lib/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const categories = [...new Set(posts.flatMap((p) => p.data.categories))].sort();

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${site.url}/blog/#blog`,
  name: `${site.name} — Blog`,
  description: 'Notes on science, data, maps, and the landscapes we live in.',
  url: `${site.url}/blog/`,
  publisher: { '@id': `${site.url}/#person` },
  // Capped the same way rss.xml.ts caps its <item> list: search engines only
  // ever use a handful of these, and an unbounded array would grow the page's
  // inline JSON-LD forever as the blog does.
  blogPost: posts.slice(0, 20).map((p) => ({
    '@type': 'BlogPosting',
    '@id': `${site.url}/blog/${p.id}/`,
    headline: p.data.title,
    description: p.data.description,
    datePublished: p.data.date.toISOString(),
    url: `${site.url}/blog/${p.id}/`,
  })),
};
---

<Page
  section="Blog"
  title="Blog"
  kicker="Writing"
  description="Notes on science, data, maps, and the landscapes we live in."
  intro="Notes on science, data, maps, and the landscapes we live in."
  image={u('/media/og/blog.webp')}
>
  <FilterBar categories={categories} target="#post-grid" noun="posts" total={posts.length} />

  <h2 class="sr-only-nw">All posts</h2>
  <div id="post-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      posts.map((entry, i) => (
        <PostCard entry={entry} index={i} readingTime={readingTime(entry.body)} />
      ))
    }
  </div>
</Page>

<script type="application/ld+json" is:inline set:html={JSON.stringify(blogLd)} />

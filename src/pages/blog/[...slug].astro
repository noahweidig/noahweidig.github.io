---
import { u } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Detail from '../../layouts/Detail.astro';
import { fullDate, readingTime } from '../../lib/format';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  // Sorted the way the listing is, so "previous" and "next" mean what a reader
  // saw there rather than an arbitrary collection order.
  const items = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  const sibling = (entry: (typeof items)[number] | undefined) =>
    entry ? { href: `/blog/${entry.id}/`, title: entry.data.title } : null;

  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sibling(items[i - 1]), next: sibling(items[i + 1]) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const meta = `${fullDate(d.date)} · ${readingTime(entry.body)}`;
---

<Detail
  title={d.title}
  description={d.description}
  headings={headings}
  kicker="Blog"
  meta={meta}
  section="Blog"
  prev={prev}
  next={next}
  backHref={u('/blog/')}
  backLabel="All posts"
  chips={d.categories}
  publishedTime={d.date}
>
  {
    d.image && (
      <Image
        src={d.image}
        alt={d['image-alt'] ?? ''}
        widths={[600, 1000, 1600]}
        sizes="(min-width: 768px) 720px, 92vw"
        loading="eager"
        class="mb-10 w-full rounded-lg border border-line"
      />
    )
  }
  <Content />

  <Fragment slot="after">
    <div class="shell-narrow pb-16">
      <Comments />
    </div>
  </Fragment>
</Detail>

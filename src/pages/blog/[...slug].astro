---
import { u } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Detail from '../../layouts/Detail.astro';
import { fullDate, readingTime } from '../../lib/format';
import { IMAGE_WIDTHS } from '../../lib/images';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  // Sorted the way the listing is, so "previous" and "next" mean what a reader
  // saw there rather than an arbitrary collection order.
  const items = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  const sibling = (entry: (typeof items)[number] | undefined) =>
    entry ? { href: `/blog/${entry.id}/`, title: entry.data.title } : null;

  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sibling(items[i - 1]), next: sibling(items[i + 1]) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const meta = `${fullDate(d.date)} · ${readingTime(entry.body)}`;
// The post's own cover, sized for og:image/twitter:image, so a shared link
// shows this post's art instead of the sitewide default (site.ogImage).
const ogImage = d.image ? (await getImage({ src: d.image, width: 1200 })).src : undefined;
---

<Detail
  title={d.title}
  description={d.description}
  headings={headings}
  kicker="Blog"
  meta={meta}
  section="Blog"
  prev={prev}
  next={next}
  backHref={u('/blog/')}
  backLabel="All posts"
  chips={d.categories}
  image={ogImage}
  publishedTime={d.date}
>
  {
    d.image && (
      <>
        <Image
          src={d.image}
          alt={d['image-alt'] ?? ''}
          widths={IMAGE_WIDTHS.hero}
          sizes="(min-width: 768px) 720px, 92vw"
          loading="eager"
          class="mb-10 hidden w-full rounded-lg border border-line dark:block"
        />
        <Image
          src={d['image-light'] ?? d.image}
          alt={d['image-alt'] ?? ''}
          widths={IMAGE_WIDTHS.hero}
          sizes="(min-width: 768px) 720px, 92vw"
          loading="eager"
          class="mb-10 block w-full rounded-lg border border-line dark:hidden"
        />
      </>
    )
  }
  <Content />

  <Fragment slot="after">
    <div class="shell-narrow pb-16">
      <Comments />
    </div>
  </Fragment>
</Detail>

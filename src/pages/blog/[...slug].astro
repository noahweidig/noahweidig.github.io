---
import { getCollection, render } from 'astro:content';
import Detail from '../../layouts/Detail.astro';
import { byDate, firstSentence, fullDate, readingTime, siblingLink } from '../../lib/format';
import Comments from '../../components/Comments.astro';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  // Sorted the way the listing is, so "previous" and "next" mean what a reader
  // saw there rather than an arbitrary collection order.
  const items = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDate);
  const sibling = siblingLink('blog');

  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sibling(items[i - 1]), next: sibling(items[i + 1]) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const rt = readingTime(entry.body);
const meta = `${fullDate(d.date)} · ${rt}`;
const metaDescription = firstSentence(d.description, 155);
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  inLanguage: 'en-US',
  author: { '@id': `${site.url}/#person` },
  publisher: { '@id': `${site.url}/#person` },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Detail
  title={d.title}
  description={metaDescription}
  headings={headings}
  readingTime={rt}
  kicker="Blog"
  meta={meta}
  author={d.author}
  authorImage={d['author-image']}
  section="Blog"
  prev={prev}
  next={next}
  backHref="/blog/"
  backLabel="All posts"
  chips={d.categories}
  publishedTime={d.date}
>
  <Content />

  <Fragment slot="after">
    <div class="shell-body pb-16">
      <Comments />
    </div>
  </Fragment>
</Detail>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)}></script>

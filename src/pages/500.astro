---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { nav } from '../lib/site';

const blurbs: Record<string, string> = {
  Projects: 'Geospatial analysis, R packages, and data tools.',
  Publications: 'Papers, presentations, and media coverage.',
  Experience: 'Roles across GIS, remote sensing, and research.',
  Awards: 'Scholarships, grants, and honors.',
  Blog: 'Notes on R, spatial data, and working reproducibly.',
  CV: 'The full record, in one page.',
  Contact: 'Email, book a call, or send a message.',
};
const destinations = nav.filter((n) => ['Projects', 'Publications', 'Blog'].includes(n.text));
---

<Base
  title="Something Went Wrong"
  description="A server error occurred while loading this page."
  noindex
>
  <section class="relative overflow-hidden">
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="shell relative py-20 text-center md:py-28">
      <p class="kicker justify-center">Error 500</p>
      <h1 class="display-2 mt-4 font-display font-medium">Something went wrong</h1>
      <p class="lede mx-auto mt-5">
        The server hit an unexpected error loading this page. Try again in a moment, search the site
        for what you were after, or pick a section below.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <button type="button" class="btn btn-primary" data-search-open>
          <Icon name="search" size={15} />Search the site
        </button>
        <a class="btn btn-ghost" href={u('/')}>Go home</a>
      </div>

      <div class="mt-14 grid gap-5 text-left md:grid-cols-3">
        {
          destinations.map((d) => (
            <a href={u(d.href)} class="card card-hover group p-6">
              <h2 class="text-xl">{d.text}</h2>
              <p class="mt-2 text-sm text-dim">{blurbs[d.text]}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent-ink">
                Go to this section
                <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

---
import { u } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import Detail from '../../layouts/Detail.astro';
import { fullDate } from '../../lib/format';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  // Sorted the way the listing is, so "previous" and "next" mean what a reader
  // saw there rather than an arbitrary collection order.
  const items = (await getCollection('projects')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  const sibling = (entry: (typeof items)[number] | undefined) =>
    entry ? { href: `/projects/${entry.id}/`, title: entry.data.title } : null;

  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sibling(items[i - 1]), next: sibling(items[i + 1]) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const repoLink = d.links.find((l) => /github|repo/i.test(l.label))?.href;
const projectLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.description,
  dateCreated: d.date.toISOString(),
  url: new URL(Astro.url.pathname, Astro.site).href,
  codeRepository: repoLink,
  keywords: d.categories.length ? d.categories.join(', ') : undefined,
  author: { '@id': `${site.url}/#person` },
};
---

<Detail
  title={d.title}
  description={d.description}
  kicker={d.featured ? 'Featured project' : 'Project'}
  meta={fullDate(d.date)}
  section="Projects"
  prev={prev}
  next={next}
  backHref={u('/projects/')}
  backLabel="All projects"
  chips={d.categories}
  links={d.links}
  image={u(`/media/og/projects/${entry.id}.webp`)}
  publishedTime={d.date}
>
  <Content />
</Detail>

<script type="application/ld+json" is:inline set:html={JSON.stringify(projectLd)} />

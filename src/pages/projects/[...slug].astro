---
import { u } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Detail from '../../layouts/Detail.astro';
import { IMAGE_WIDTHS, shotFor } from '../../lib/images';
import { byDate, fullDate, truncateTitle, siblingLink } from '../../lib/format';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  // Sorted the way the listing is, so "previous" and "next" mean what a reader
  // saw there rather than an arbitrary collection order.
  const items = (await getCollection('projects')).sort(byDate);
  const sibling = siblingLink('projects');

  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sibling(items[i - 1]), next: sibling(items[i + 1]) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const shot = shotFor(entry.id);
const SHOT_SIZES = '(min-width: 832px) 40vw, 92vw';

const repoLink = d.links.find((l) => /github|repo/i.test(l.label))?.href;
const kindText = d.categories.length ? `${d.categories.join(' / ')} project` : 'project';
const metaDescription = truncateTitle(
  `${d.description.replace(/[.\s]+$/, '')}. ${d.title} is a ${kindText} by ${site.name}${repoLink ? ', open source on GitHub' : ''}.`,
  158,
).replace(/…$/, '');
const projectLd = {
  '@context': 'https://schema.org',
  '@type': repoLink ? 'SoftwareSourceCode' : 'CreativeWork',
  name: d.title,
  description: metaDescription,
  dateCreated: d.date.toISOString(),
  url: new URL(Astro.url.pathname, Astro.site).href,
  codeRepository: repoLink,
  keywords: d.categories.length ? d.categories.join(', ') : undefined,
  author: { '@id': `${site.url}/#person` },
};
---

<Detail
  title={d.title}
  description={metaDescription}
  kicker={d.featured ? 'Featured project' : 'Project'}
  meta={fullDate(d.date)}
  section="Projects"
  prev={prev}
  next={next}
  backHref={u('/projects/')}
  backLabel="All projects"
  chips={d.categories}
  links={d.links}
  image={u(`/media/og/projects/${entry.id}.webp`)}
  imageAlt={`${d.title} project preview`}
  publishedTime={d.date}
>
  {shot && (
    <Image
      slot="hero-image"
      src={shot}
      alt={d['image-alt'] ?? `${d.title} project preview`}
      widths={IMAGE_WIDTHS.hero}
      sizes={SHOT_SIZES}
      loading="eager"
    />
  )}
  <Content />
</Detail>

<script type="application/ld+json" is:inline set:html={JSON.stringify(projectLd)}></script>

---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { u } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import Detail from '../../layouts/Detail.astro';
import { firstSentence, fullDate, inlineMarkup, splitAuthors } from '../../lib/format';
import { site } from '../../lib/site';
import { citationStatsFor } from '../../lib/citation-stats';

export async function getStaticPaths() {
  // Sorted the way the listing is, so "previous" and "next" mean what a reader
  // saw there rather than an arbitrary collection order.
  const items = (await getCollection('publications')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  const sibling = (entry: (typeof items)[number] | undefined) =>
    entry ? { href: `/publications/${entry.id}/`, title: entry.data.title } : null;

  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sibling(items[i - 1]), next: sibling(items[i + 1]) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const authors = d['pub-authors'] ? splitAuthors(d['pub-authors']) : [];
const pdfUrl = d['pub-pdf'] ? new URL(u(d['pub-pdf']), Astro.site).href : undefined;

const stats = citationStatsFor(d['pub-doi']);
const dimensions = stats?.dimensions && stats.dimensions.timesCited > 0 ? stats.dimensions : null;
const altmetric = stats?.altmetric && stats.altmetric.score > 0 ? stats.altmetric : null;
const dimensionsTip = dimensions
  ? [
      `${dimensions.timesCited} total citation${dimensions.timesCited === 1 ? '' : 's'}`,
      dimensions.fieldCitationRatio != null
        ? `Field Citation Ratio ${dimensions.fieldCitationRatio.toFixed(2)}`
        : '',
    ]
      .filter(Boolean)
      .join(' · ')
  : '';
const altmetricTip = altmetric
  ? `Attention score ${Math.round(altmetric.score)} from ${altmetric.postsCount} mention${altmetric.postsCount === 1 ? '' : 's'}`
  : '';

// Generated by `npm run covers`, keyed by the current slug — falls back to
// the sitewide OG image (via Detail -> Base) if a slug was ever renamed
// without regenerating its card, rather than shipping a 404'd og:image.
const ogImagePath = `/media/og/publications/${entry.id}.webp`;
const ogImageExists = existsSync(
  fileURLToPath(new URL(`../../../public${ogImagePath}`, import.meta.url)),
);

const pubLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  url: new URL(Astro.url.pathname, Astro.site).href,
  identifier: d['pub-doi']
    ? {
        '@type': 'PropertyValue',
        propertyID: 'https://registry.identifiers.org/registry/doi',
        value: d['pub-doi'],
      }
    : undefined,
  isPartOf: d['pub-venue'] ? { '@type': 'CreativeWork', name: d['pub-venue'] } : undefined,
  author: authors.length
    ? authors.map((name) => ({ '@type': 'Person', name }))
    : { '@id': `${site.url}/#person` },
  publisher: { '@id': `${site.url}/#person` },
};
---

<Detail
  title={d.title}
  description={firstSentence(d.description, 155)}
  kicker={d.categories[0] ?? 'Publication'}
  meta={fullDate(d.date)}
  section="Publications"
  prev={prev}
  next={next}
  backHref={u('/publications/')}
  backLabel="All publications"
  chips={d.categories}
  links={d.links}
  image={ogImageExists ? u(ogImagePath) : undefined}
  imageAlt={`Citation card for “${d.title}”`}
  publishedTime={d.date}
  noindex={Boolean(d['pub-appearance-of'])}
>
  <Fragment slot="head">
    {
      /* Highwire Press tags: Google Scholar and reference managers (Zotero,
        Mendeley) read these, not the ScholarlyArticle JSON-LD below. */
    }
    <meta name="citation_title" content={d.title} />
    {authors.map((name) => <meta name="citation_author" content={name} />)}
    <meta name="citation_publication_date" content={d.date.toISOString().slice(0, 10)} />
    {d['pub-venue'] && <meta name="citation_journal_title" content={d['pub-venue']} />}
    {d['pub-doi'] && <meta name="citation_doi" content={d['pub-doi']} />}
    {pdfUrl && <meta name="citation_pdf_url" content={pdfUrl} />}
  </Fragment>
  {
    d.citation && (
      <p class="mb-8 rounded-md border-l-2 border-accent bg-raised px-4 py-3 text-sm leading-relaxed text-dim">
        <Fragment set:html={inlineMarkup(d.citation)} />
      </p>
    )
  }
  <Content />

  <Fragment slot="badges">
    {
      (dimensions || altmetric) && (
        <div class="badge-pair">
          {dimensions && (
            <a
              href={dimensions.url}
              target="_blank"
              rel="noopener"
              class="chip transition-colors hover:border-accent hover:text-accent-ink"
              data-tip-title="Dimensions"
              data-tip={dimensionsTip}
            >
              {dimensions.timesCited} citation{dimensions.timesCited === 1 ? '' : 's'}
            </a>
          )}
          {altmetric && (
            <a
              href={altmetric.detailsUrl}
              target="_blank"
              rel="noopener"
              class="chip chip-accent transition-colors hover:border-accent"
              data-tip-title="Altmetric Attention Score"
              data-tip={altmetricTip}
            >
              {altmetric.imageUrl && (
                <img
                  src={altmetric.imageUrl}
                  alt=""
                  width="16"
                  height="16"
                  loading="lazy"
                  decoding="async"
                />
              )}
              {Math.round(altmetric.score)}
            </a>
          )}
        </div>
      )
    }
  </Fragment>
</Detail>

<script type="application/ld+json" is:inline set:html={JSON.stringify(pubLd)} />

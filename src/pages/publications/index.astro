---
import { getCollection } from 'astro:content';
import { u } from '../../lib/url';
import Page from '../../layouts/Page.astro';
import CitationRow from '../../components/CitationRow.astro';
import FilterBar from '../../components/FilterBar.astro';
import StatStrip from '../../components/StatStrip.astro';

const all = (await getCollection('publications')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
/* Zotero exports one record per appearance; only the flagged record is listed
   so a talk given four times reads as one work, not four near-identical rows. */
const listed = all.filter((p) => p.data['pub-listed'] === 'yes');
const journal = listed.filter((p) => p.data.categories.includes('Journal Article'));
const other = listed.filter((p) => !p.data.categories.includes('Journal Article'));

const categories = [...new Set(listed.flatMap((p) => p.data.categories))].sort();
const firstAuthor = all.filter((p) =>
  /^\*\*Weidig/.test((p.data['pub-authors'] ?? '').trim()),
).length;
const citations = all.reduce((n, p) => n + (p.data['pub-citations'] ?? 0), 0);

const stats = [
  { value: listed.length, label: 'Publications & Talks' },
  { value: journal.length, label: 'Journal Articles' },
  { value: firstAuthor, label: 'First-Author Works' },
  { value: citations, label: 'Citations' },
];
---

<Page
  section="Publications"
  title="Publications"
  kicker="Research output"
  description="A live feed of my research output, pulled automatically from Zotero."
  intro="A live feed of my research output, pulled automatically from Zotero. Updated on the 1st and 15th of each month."
  image={u('/media/og/publications.webp')}
  imageAlt="Noah Weidig's publications and research output"
>
  <StatStrip stats={stats} />

  <div class="mt-10">
    <FilterBar
      categories={categories}
      target="#pubs-journal, #pubs-other"
      noun="publications"
      total={listed.length}
    />
  </div>

  <section class="mt-12" data-filter-section>
    <h2 class="font-display text-2xl">Peer-Reviewed Journal Articles</h2>
    <div id="pubs-journal" class="mt-4">
      {journal.map((entry) => <CitationRow entry={entry} />)}
    </div>
  </section>

  <section class="mt-14" data-filter-section>
    <h2 class="font-display text-2xl">Other Research Output</h2>
    <div id="pubs-other" class="mt-4">
      {other.map((entry) => <CitationRow entry={entry} />)}
    </div>
  </section>
</Page>

<script is:inline>
  // A DOI with no attention data yet leaves Altmetric's badge empty (and,
  // worse, an <a> with no accessible name) instead of not rendering at
  // all. Hiding the empty ones fixes both the blank badge and the a11y
  // gap in one pass; collapse the badge pair too if Dimensions came up
  // empty as well, so no dangling gap is left behind.
  new MutationObserver(() => {
    document.querySelectorAll('[data-badges]').forEach((wrap) => {
      const alt = wrap.querySelector('.altmetric-embed');
      if (alt) alt.hidden = !alt.querySelector('img');
      const dim = wrap.querySelector('.__dimensions_badge_embed__');
      if (dim) dim.hidden = dim.childElementCount === 0;
      const pair = wrap.classList.contains('badge-pair') ? wrap : wrap.querySelector('.badge-pair');
      if (pair) pair.hidden = [...pair.children].every((c) => c.hidden);
    });
  }).observe(document.body, { childList: true, subtree: true });
</script>

---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Detail from '../../layouts/Detail.astro';
import { site } from '../../lib/site';
import { byDate, truncateTitle, siblingLink } from '../../lib/format';

export async function getStaticPaths() {
  // Sorted the way the listing is, so "previous" and "next" mean what a reader
  // saw there rather than an arbitrary collection order.
  const items = (await getCollection('education')).sort(byDate);
  const sibling = siblingLink('education');

  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sibling(items[i - 1]), next: sibling(items[i + 1]) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const HERO_SIZES = '(min-width: 832px) 40vw, 92vw';
const meta = [d.org, d.dates, d.location].filter(Boolean).join(' · ');

// EducationalOccupationalCredential is the schema.org type for a degree —
// more precise than the generic CreativeWork used on Projects/Experience,
// since Google does define real properties for it.
const educationLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOccupationalCredential',
  name: d.title,
  description: d.description,
  dateCreated: d.date.toISOString(),
  url: new URL(Astro.url.pathname, Astro.site).href,
  recognizedBy: d['org-url']
    ? { '@type': 'CollegeOrUniversity', name: d.org, url: d['org-url'] }
    : d.org
      ? { '@type': 'CollegeOrUniversity', name: d.org }
      : undefined,
  about: { '@id': `${site.url}/#person` },
};
---

<Detail
  title={d.title}
  metaTitle={truncateTitle(d.title, 45)}
  description={d.description}
  kicker="Education"
  meta={meta}
  section="Education"
  prev={prev}
  next={next}
  backHref="/education/"
  backLabel="All education"
  links={[
    ...d.links,
    ...(d['org-url']
      ? [
          {
            label: d.org ?? 'Organisation',
            href: d['org-url'],
            variant: 'ghost' as const,
            external: true,
          },
        ]
      : []),
  ]}
  publishedTime={d.date}
>
  {d.image && (
    <Image
      slot="hero-image"
      src={d.image}
      alt={d['image-alt'] ?? ''}
      widths={[600, 1000, 1200]}
      sizes={HERO_SIZES}
      loading="eager"
    />
  )}
  <Content />
  {d['image-credit'] && <p class="mt-8 text-xs text-faint">{d['image-credit']}</p>}
</Detail>

<script type="application/ld+json" is:inline set:html={JSON.stringify(educationLd)}></script>

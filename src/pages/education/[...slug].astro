---
import { u } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import Detail from '../../layouts/Detail.astro';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  // Sorted the way the listing is, so "previous" and "next" mean what a reader
  // saw there rather than an arbitrary collection order.
  const items = (await getCollection('education')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  const sibling = (entry: (typeof items)[number] | undefined) =>
    entry ? { href: `/education/${entry.id}/`, title: entry.data.title } : null;

  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sibling(items[i - 1]), next: sibling(items[i + 1]) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const meta = [d.org, d.dates, d.location].filter(Boolean).join(' · ');

// EducationalOccupationalCredential is the schema.org type for a degree —
// more precise than the generic CreativeWork used on Projects/Experience,
// since Google does define real properties for it.
const educationLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOccupationalCredential',
  name: d.title,
  description: d.description,
  dateCreated: d.date.toISOString(),
  url: new URL(Astro.url.pathname, Astro.site).href,
  recognizedBy: d['org-url']
    ? { '@type': 'CollegeOrUniversity', name: d.org, url: d['org-url'] }
    : d.org
      ? { '@type': 'CollegeOrUniversity', name: d.org }
      : undefined,
  about: { '@id': `${site.url}/#person` },
};
---

<Detail
  title={d.title}
  description={d.description}
  kicker="Education"
  meta={meta}
  section="Education"
  prev={prev}
  next={next}
  backHref={u('/education/')}
  backLabel="All education"
  links={d['org-url']
    ? [{ label: d.org ?? 'Organisation', href: d['org-url'], variant: 'ghost', external: true }]
    : []}
  image={u(`/media/og/education/${entry.id}.webp`)}
  publishedTime={d.date}
>
  <Content />
</Detail>

<script type="application/ld+json" is:inline set:html={JSON.stringify(educationLd)} />

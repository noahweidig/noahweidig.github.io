---
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
import { u } from '../../lib/url';
import { tagGroups, tagIcon } from '../../lib/tags';

const groups = await tagGroups();
---

<Page
  title="Tags"
  kicker="Index"
  section="Tags"
  description="Every topic used across projects, publications and writing, with the work filed under each."
  intro="Every topic used across projects, publications and writing, with the work filed under each."
  wide={false}
  image={u('/media/og/tags.webp')}
  imageAlt="Index of every topic tag used across the site"
>
  <ul class="flex flex-wrap gap-2">
    {
      groups.map((g) => (
        <li>
          <a
            href={u(`/tags/${g.slug}/`)}
            class="chip transition-colors hover:border-accent hover:text-accent-ink"
          >
            {tagIcon(g.name) && <Icon name={tagIcon(g.name)!} size={12} />}
            {g.name}
            <span class="text-faint">{g.items.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Page>

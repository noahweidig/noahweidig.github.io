---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import HeroMesh from '../components/HeroMesh.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/me.webp';
import { PORTRAIT_SIZES, PORTRAIT_WIDTHS } from '../lib/portrait';
import { site } from '../lib/site';
import { getCollection } from 'astro:content';

const [latest] = (await getCollection('experience')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const glance = [
  { icon: 'pin', label: 'Based in', value: site.location },
  {
    icon: 'briefcase',
    label: 'Currently',
    value: `${latest!.data.title}, ${latest!.data.org}`,
  },
  { icon: 'flame', label: 'Focus', value: 'Wildfire risk in the wildland-urban interface' },
  {
    icon: 'school',
    label: 'Education',
    value: 'M.S. Forest Resources & Conservation, University of Florida',
  },
];

const beyondWork = [
  {
    icon: 'earth',
    title: 'Outside',
    body: 'Most weekends I am hiking, camping, or just finding an excuse to be outdoors — it is a lot of why I ended up studying landscapes for a living.',
  },
  {
    icon: 'flame',
    title: 'Coffee & cooking',
    body: 'I take coffee too seriously and cook most nights. Both scratch the same itch as data work: a process you can tune until it is right.',
  },
  {
    icon: 'video',
    title: 'Photography',
    body: 'A camera goes wherever I do. Landscapes mostly — the same eye for composition carries over into how I build a map or a figure.',
  },
  {
    icon: 'book',
    title: 'Always reading',
    body: 'Usually two books at once — one on ecology or statistics, one that has nothing to do with either.',
  },
];
---

<Base
  title="About"
  description="A bit more about who I am outside of the papers and the projects."
  filters={{ section: 'Page' }}
>
  <Breadcrumbs trail={[]} current="About" class="sr-only-nw" />
  <section class="under-nav relative overflow-hidden border-b border-line bg-bg-deep">
    <HeroMesh />
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="shell relative grid items-center gap-10 py-16 md:grid-cols-[0.8fr_1.2fr] md:py-20">
      <div class="mx-auto w-full max-w-[12rem] md:mx-0 md:max-w-none" data-reveal>
        <div class="portrait-frame relative aspect-square">
          <svg
            class="portrait-blob"
            viewBox="0 0 1 1"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path d="M.99 .552C.987 .595 .969 .639 .952 .678C.934 .717 .911 .753 .887 .786C.862 .818 .834 .848 .803 .874C.773 .899 .74 .922 .706 .94C.671 .957 .634 .971 .596 .98C.559 .988 .52 .991 .482 .99C.444 .989 .404 .987 .368 .976C.333 .965 .298 .945 .268 .923C.238 .901 .211 .874 .188 .846C.165 .818 .146 .787 .129 .756C.111 .725 .096 .693 .081 .659C.067 .625 .055 .591 .043 .552C.031 .513 .014 .47 .01 .426C.005 .381 0 .325 .016 .283C.033 .242 .068 .199 .107 .177C.147 .156 .208 .157 .253 .156C.299 .156 .343 .169 .381 .175C.419 .18 .45 .184 .482 .19C.514 .195 .543 .201 .574 .208C.605 .215 .634 .222 .667 .232C.699 .241 .733 .25 .77 .264C.806 .279 .851 .293 .885 .319C.919 .345 .956 .382 .973 .42C.991 .459 .994 .509 .99 .552Z"></path>
            <clipPath id="portrait-clip" clipPathUnits="objectBoundingBox">
              <rect width="1" height=".62"></rect>
              <path d="M.99 .552C.987 .595 .969 .639 .952 .678C.934 .717 .911 .753 .887 .786C.862 .818 .834 .848 .803 .874C.773 .899 .74 .922 .706 .94C.671 .957 .634 .971 .596 .98C.559 .988 .52 .991 .482 .99C.444 .989 .404 .987 .368 .976C.333 .965 .298 .945 .268 .923C.238 .901 .211 .874 .188 .846C.165 .818 .146 .787 .129 .756C.111 .725 .096 .693 .081 .659C.067 .625 .055 .591 .043 .552C.031 .513 .014 .47 .01 .426C.005 .381 0 .325 .016 .283C.033 .242 .068 .199 .107 .177C.147 .156 .208 .157 .253 .156C.299 .156 .343 .169 .381 .175C.419 .18 .45 .184 .482 .19C.514 .195 .543 .201 .574 .208C.605 .215 .634 .222 .667 .232C.699 .241 .733 .25 .77 .264C.806 .279 .851 .293 .885 .319C.919 .345 .956 .382 .973 .42C.991 .459 .994 .509 .99 .552Z"></path>
            </clipPath>
          </svg>
          <div class="portrait-clip">
            <Image
              src={portrait}
              alt="Noah Weidig"
              widths={PORTRAIT_WIDTHS}
              sizes={PORTRAIT_SIZES}
              loading="eager"
              class="aspect-square w-full object-cover"
            />
          </div>
        </div>
      </div>
      <div class="text-center md:text-left" data-reveal style="--reveal-delay:70ms">
        <p class="kicker md:justify-start">About</p>
        <h1 class="display-2 mt-4 font-display font-bold">Hi, I'm Noah.</h1>
        <p class="lede mx-auto mt-5 md:mx-0">
          By day I turn spatial data into decisions. Outside of that, I'm still mostly outdoors —
          just without the laptop.
        </p>
      </div>
    </div>
  </section>

  <div class="shell py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[19rem_1fr] lg:gap-16">
      <aside class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <dl class="card divide-y divide-line">
          {glance.map((g) => (
            <div class="flex gap-4 p-5">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-line bg-raised text-accent-ink">
                <Icon name={g.icon} size={16} />
              </span>
              <div class="min-w-0">
                <dt class="font-mono text-2xs tracking-[0.12em] text-faint uppercase">{g.label}</dt>
                <dd class="mt-1 text-[0.95rem] leading-snug">{g.value}</dd>
              </div>
            </div>
          ))}
        </dl>
      </aside>

      <div data-reveal>
        <h2 class="font-display text-3xl">How I got here</h2>
        <p class="mt-6 text-xl leading-relaxed text-ink md:text-[1.4rem] md:leading-[1.55]">
          I grew up more interested in the woods behind my house than anything on a screen, which is
          a strange starting point for someone who now spends most days in front of one.
        </p>
        <p class="mt-6 text-lg leading-relaxed text-dim">
          Ecology got me curious about why landscapes look the way they do; GIS gave me a way to
          actually answer that question instead of just guessing at it. Somewhere along the way,
          wildfire risk in the wildland-urban interface became the specific question I couldn't stop
          pulling on — where people and fire-prone landscapes meet, and what the data says about
          that.
        </p>
        <p class="mt-5 text-lg leading-relaxed text-dim">
          Outside of research, I care about the same thing from a different angle: getting outside,
          paying attention to a place, and not treating "the environment" as an abstraction. That's
          probably the throughline between the fieldwork, the code, and everything below.
        </p>
      </div>
    </div>

    <div class="mt-20 md:mt-24">
      <h2 class="font-display text-3xl" data-reveal>
        Beyond the work
      </h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {beyondWork.map((b, i) => (
          <div
            class="card card-hover flex flex-col p-6"
            data-reveal
            style={`--reveal-delay:${i * 60}ms`}
          >
            <span class="grid h-12 w-12 place-items-center rounded-xl border border-line bg-raised text-accent-ink">
              <Icon name={b.icon} size={22} />
            </span>
            <b role="heading" aria-level="3" class="mt-5 block text-lg font-medium">{b.title}</b>
            <p class="mt-2 text-sm leading-relaxed text-dim">{b.body}</p>
          </div>
        ))}
      </div>
    </div>

    <div
      class="card relative mt-20 overflow-hidden p-8 md:mt-24 md:p-14 md:text-center"
      data-reveal
    >
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-br from-accent/10 via-transparent to-transparent"
        aria-hidden="true"
      ></div>
      <p class="relative mx-auto max-w-[28ch] font-display text-2xl leading-snug text-balance md:text-4xl">
        "The best spatial analysis still starts with actually knowing the place."
      </p>
      <p class="relative mt-6 text-dim">
        If you want the CV-and-papers version of me, that lives on the{' '}
        <a class="text-accent-ink underline underline-offset-3" href={u('/cv/')}>
          CV page
        </a>
        . This page is the rest of it.
      </p>
      <div class="relative mt-8 flex flex-wrap items-center gap-3 md:justify-center">
        <a class="btn btn-primary" href={u('/contact/')}>
          <Icon name="mail" size={15} />
          Get in touch
        </a>
        <a class="btn btn-ghost" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Flat accent blob behind the cutout. The clip box shares the blob's bottom
     shape plus the band above it, so the head clears the blob. */
  .portrait-blob {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--c-accent);
    fill-opacity: 0.18;
  }
  .portrait-clip {
    position: absolute;
    inset: 0;
    clip-path: url(#portrait-clip);
  }
</style>

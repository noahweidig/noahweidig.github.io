---
import { u } from '../lib/url';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Affiliations from '../components/Affiliations.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import TechMarquee from '../components/TechMarquee.astro';
import SectionHead from '../components/SectionHead.astro';
import StatStrip from '../components/StatStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import CitationRow from '../components/CitationRow.astro';
import TimelineItem from '../components/TimelineItem.astro';
import Icon from '../components/Icon.astro';
import Popup from '../components/Popup.astro';
import { Image } from 'astro:assets';
import { readingTime, year } from '../lib/format';
import { site } from '../lib/site';

const byDate = <T extends { data: { date: Date } }>(a: T, b: T) =>
  b.data.date.getTime() - a.data.date.getTime();

const allProjects = (await getCollection('projects')).sort(byDate);
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 6);
const projects = featuredProjects.length ? featuredProjects : allProjects.slice(0, 6);

const allPubs = (await getCollection('publications')).sort(byDate);
/* `pub-listed` marks the one record Zotero's per-appearance export should
   surface, so a work presented four times is one row, not four. */
const featuredPubs = allPubs
  .filter((p) => p.data['pub-listed'] === 'yes' && p.data.categories.includes('Journal Article'))
  .slice(0, 4);

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDate).slice(0, 3);

const experience = (await getCollection('experience')).sort(byDate);
const education = (await getCollection('education')).sort(byDate);

const awards = (await getCollection('awards')).sort(byDate);
const featuredAwards = awards.filter((a) => a.data.image).slice(0, 6);

const pubCounts = Object.entries(
  allPubs.reduce<Record<string, number>>((acc, p) => {
    const c = p.data.categories[0] ?? 'Other';
    acc[c] = (acc[c] ?? 0) + 1;
    return acc;
  }, {}),
).sort((a, b) => b[1] - a[1]);

const stats = [
  {
    value: `${allPubs.length}+`,
    label: 'Papers & Talks',
    id: 'pop-pubs',
    body: 'Journal articles, conference presentations, webinars and media coverage, by type.',
    items: pubCounts.map(([t, n]) => ({ t: `${t}s`, n: String(n), href: u('/publications/') })),
    href: u('/publications/'),
    cta: 'All publications',
  },
  {
    value: '8+',
    label: 'Years Research Experience',
    id: 'pop-years',
    body: 'Research, GIS, and data roles across universities, a federal agency, and local government.',
    items: experience.map((e) => ({
      t: `${e.data.title}, ${e.data.org}`,
      n: String(year(e.data.date)),
      href: u(`/experience/${e.id}/`),
    })),
    href: '#experience',
    cta: 'See the full background',
  },
  {
    value: '20+',
    label: 'Tools Mastered',
    id: 'pop-tools-count',
    body: 'Mostly R and Python for analysis and modeling, SQL for data wrangling, and GIS tools (ArcGIS Pro, QGIS, GEE, GDAL) for spatial work.',
    items: [],
    href: '#skills',
    cta: 'See the tech stack',
  },
  {
    value: featuredProjects.length,
    label: 'Featured Projects',
    id: 'pop-featured',
    body: 'Open tools, maps, and packages built and maintained in the open.',
    items: projects.map((p) => ({ t: p.data.title, href: u(`/projects/${p.id}/`) })),
    href: '#projects',
    cta: 'Browse the work',
  },
];

const researchAreas = [
  'Remote Sensing',
  'Land-Use Change',
  'Spatial Statistics',
  'Applied AI',
  'Biodiversity',
  'Geospatial Engineering',
];

const starts = [
  {
    id: 'pop-research',
    items: researchAreas.map((t) => ({ t, href: '#interests' })),
    href: '#interests',
    icon: 'layers',
    title: 'Research',
    body: 'Six focus areas, from WUI wildfire risk to species distribution modeling — with the papers behind each.',
    cta: 'Read the research',
  },
  {
    id: 'pop-tools',
    items: projects.map((p) => ({ t: p.data.title, href: u(`/projects/${p.id}/`) })),
    href: '#projects',
    icon: 'terminal',
    title: 'Tools & maps',
    body: 'Open tools: an R package for U.S. fire data, Earth Engine apps, interactive map galleries.',
    cta: 'Browse the work',
  },
  {
    id: 'pop-writing',
    items: posts.map((p) => ({ t: p.data.title, href: u(`/blog/${p.id}/`) })),
    href: '#blog',
    icon: 'pencil',
    title: 'Writing',
    body: 'Tutorials and notes on R, spatial workflows, and doing reproducible research in the open.',
    cta: 'Read the blog',
  },
];

const faqs = [
  {
    q: 'What do you do?',
    a: 'I work at the intersection of geospatial analytics, data science, and applied AI — building reproducible workflows that turn spatial and environmental data into decision-ready insights.',
  },
  {
    q: 'What kinds of projects are you interested in?',
    a: "I'm drawn to work involving remote sensing, land-use change, social-ecological systems, and data storytelling. I especially enjoy projects where rigorous analysis meets clear visual communication.",
  },
  {
    q: 'Are you open to collaboration?',
    a: "Yes. I'm happy to discuss research collaborations, freelance work, and full-time opportunities in data science or GIS. The best way to start a conversation is through the contact page.",
    link: { href: '/contact/', text: 'contact page' },
  },
  {
    q: 'What tools do you typically work with?',
    a: 'Mostly R and Python for analysis and modeling, alongside SQL for data wrangling and a range of GIS tools (ArcGIS Pro, QGIS, GEE, GDAL) for spatial work. See the tech stack section for the full toolkit.',
  },
  {
    q: 'How can I get in touch?',
    a: "Email is the easiest — you'll find it on the contact page.",
    link: { href: '/contact/', text: 'contact page' },
  },
];
---

<Base title={site.name} filters={{ section: 'Page' }}>
  <Hero />

  <!-- stats + affiliations -->
  <section class="shell py-16 md:py-20">
    <StatStrip stats={stats} />
    <Affiliations />
  </section>

  <!-- three ways in -->
  <section class="shell pb-8">
    <div class="grid gap-5 md:grid-cols-3">
      {starts.map((s, i) => (
        <div
          class="card card-hover group relative flex flex-col p-6"
          data-reveal
          style={`--reveal-delay:${i * 70}ms`}
        >
          <span class="grid aspect-square h-11 w-11 shrink-0 place-items-center rounded-full bg-matte text-accent-ink">
            <Icon name={s.icon} size={20} />
          </span>
          <h2 class="mt-5 text-xl">{s.title}</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-dim">{s.body}</p>
          <button
            type="button"
            class="popup-plus mt-5 ml-auto after:absolute after:inset-0 after:rounded-[inherit] after:content-['']"
            data-popup-open={s.id}
            aria-haspopup="dialog"
            aria-label={`More about ${s.title}`}
          >
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path
                d="M8 2.5v11M2.5 8h11"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                fill="none"
              />
            </svg>
          </button>
        </div>
      ))}
    </div>
  </section>

  {[...stats, ...starts].map((s) => (
    <Popup id={s.id} eyebrow={'label' in s ? s.label : s.title} title={s.cta}>
      <p class="text-lg leading-relaxed">{s.body}</p>
      {s.items.length > 0 && (
        <ul class="divide-y divide-line border-y border-line text-ink">
          {s.items.map((it) => (
            <li>
              <a
                class="flex items-center justify-between gap-4 py-3 hover:text-accent-ink"
                href={it.href}
              >
                <span>{it.t}</span>
                {'n' in it ? (
                  <span class="font-mono text-sm text-faint">{it.n}</span>
                ) : (
                  <Icon name="arrow" size={15} class="shrink-0" />
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
      <a class="inline-flex items-center gap-1.5 font-medium text-accent-ink" href={s.href}>
        {s.cta}
        <Icon name="arrow" size={15} />
      </a>
    </Popup>
  ))}

  <!-- research areas -->
  <section
    class="band-dark scroll-mt-24 border-y border-line bg-bg-deep py-24 md:py-28 cv-auto"
    id="interests"
  >
    <div class="shell">
      <SectionHead kicker="Research areas" title="Where I focus my work" />
      <ResearchAreas />
    </div>
  </section>

  <!-- projects -->
  <section class="shell scroll-mt-24 py-20 cv-auto" id="projects">
    <SectionHead
      kicker="Selected work"
      title="Tools, maps & applications"
      href={u('/projects/')}
      linkText="Browse all projects"
    />
    <div class="mt-10" data-carousel data-carousel-label="projects" data-reveal>
      <div
        class="carousel-track flex snap-x snap-mandatory gap-5 overflow-x-auto -mx-4 -my-6 px-4 py-6 [scroll-padding-inline:16px]"
        data-carousel-track
      >
        {projects.map((entry, i) => (
          <ProjectCard
            entry={entry}
            index={i}
            cta
            reveal={false}
            class="w-[min(19rem,calc(100vw-6rem))] shrink-0 snap-start"
          />
        ))}
      </div>

      <div class="mt-8 flex items-center justify-center gap-3">
        <div class="carousel-pill" role="group" aria-label="Choose a project to show">
          {projects.map((entry, i) => (
            <button
              type="button"
              class="carousel-dot"
              data-carousel-dot
              aria-current={i === 0 ? 'true' : undefined}
              aria-label={`Show ${entry.data.title}`}
            >
              <span aria-hidden="true" />
            </button>
          ))}
        </div>
        <button
          type="button"
          class="popup-plus carousel-toggle"
          data-carousel-toggle
          aria-pressed="false"
          aria-label="Pause the projects carousel"
          data-tip="Pause the carousel"
        >
          <span data-carousel-icon-pause>
            <Icon name="pause" size={18} />
          </span>
          <span data-carousel-icon-play hidden>
            <Icon name="play" size={18} />
          </span>
        </button>
      </div>
    </div>
    <a class="btn btn-ghost btn-sm group mt-6 md:hidden" href={u('/projects/')}>
      Browse all projects
      <Icon
        name="arrow"
        size={15}
        class="transition-transform duration-300 group-hover:translate-x-1"
      />
    </a>
  </section>

  <!-- publications -->
  <section class="shell scroll-mt-24 py-20 cv-auto" id="publications">
    <SectionHead
      kicker="Publications"
      title="Peer-reviewed & in review"
      href={u('/publications/')}
      linkText="All publications"
    />
    <div class="mt-8">
      {featuredPubs.map((entry) => (
        <CitationRow entry={entry} compact />
      ))}
    </div>
    <a class="btn btn-ghost btn-sm group mt-6 md:hidden" href={u('/publications/')}>
      All publications
      <Icon
        name="arrow"
        size={15}
        class="transition-transform duration-300 group-hover:translate-x-1"
      />
    </a>
  </section>

  <!-- skills -->
  <section class="band-dark scroll-mt-24 border-y border-line bg-bg-deep py-20 cv-auto" id="skills">
    <div class="shell">
      <SectionHead kicker="Tech stack" title="Technologies I use to build things" />
      <TechMarquee />
    </div>
  </section>

  <!-- experience + education -->
  <section class="shell scroll-mt-24 py-24 cv-auto" id="experience">
    <SectionHead kicker="Background" title="Where I've worked and studied" />
    <div class="mt-10 grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h3 class="font-mono text-2xs tracking-[0.18em] text-faint uppercase">Experience</h3>
        <ul class="mt-5 ml-1">
          {experience.slice(0, 2).map((entry, i) => (
            <li>
              <TimelineItem entry={entry} base="experience" current={i === 0} headingLevel={4} />
            </li>
          ))}
        </ul>
        <a class="btn btn-ghost btn-sm group mt-6" href={u('/experience/')}>
          See all experience
          <Icon
            name="arrow"
            size={15}
            class="transition-transform duration-300 group-hover:translate-x-1"
          />
        </a>
      </div>
      <div id="education" class="scroll-mt-24">
        <h3 class="font-mono text-2xs tracking-[0.18em] text-faint uppercase">Education</h3>
        <ul class="mt-5 ml-1">
          {education.slice(0, 2).map((entry) => (
            <li>
              <TimelineItem entry={entry} base="education" headingLevel={4} />
            </li>
          ))}
        </ul>
        <a class="btn btn-ghost btn-sm group mt-6" href={u('/education/')}>
          See all education
          <Icon
            name="arrow"
            size={15}
            class="transition-transform duration-300 group-hover:translate-x-1"
          />
        </a>
      </div>
    </div>
  </section>

  <!-- awards -->
  <section class="band-dark scroll-mt-24 border-y border-line bg-bg-deep py-20 cv-auto" id="awards">
    <div class="shell">
      <SectionHead
        kicker="Recognition"
        title="Featured awards"
        href={u('/awards/')}
        linkText="All awards"
      />
    </div>
    <div class="shell mt-10" data-carousel data-reveal>
      <div
        class="carousel-track flex snap-x snap-mandatory gap-5 overflow-x-auto -mx-4 -my-6 px-4 py-6 [scroll-padding-inline:16px]"
        data-carousel-track
      >
        {featuredAwards.map((entry) => (
          <a
            href={u(`/awards/${entry.id}/`)}
            class="card card-hover group flex w-[min(19rem,calc(100vw-6rem))] shrink-0 snap-start flex-col overflow-hidden"
          >
            <div class="relative aspect-4/3 overflow-hidden border-b border-line bg-raised">
              <Image
                src={entry.data.image!}
                alt={entry.data['image-alt'] ?? ''}
                widths={[320, 640]}
                sizes="(max-width: 25rem) calc(100vw - 6rem), 304px"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.05]"
              />
              <span class="absolute top-3 left-3 chip bg-black/55 text-white backdrop-blur-md">
                {year(entry.data.date)}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <b
                role="heading"
                aria-level="3"
                class="block text-body-lg leading-snug font-medium transition-colors group-hover:text-accent-ink"
              >
                {entry.data.title}
              </b>
              <span class="mt-1.5 block text-[0.82rem] text-dim">{entry.data.description}</span>
              <span class="mt-auto flex justify-end pt-4">
                <span
                  class="grid h-9 w-9 place-items-center rounded-full border border-line bg-raised transition-colors group-hover:bg-accent group-hover:text-white"
                  aria-hidden="true"
                >
                  <Icon
                    name="chevron"
                    size={16}
                    class="-rotate-90 transition-transform duration-300 group-hover:translate-x-0.5"
                  />
                </span>
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-8 flex items-center justify-center gap-3">
        <div class="carousel-pill" role="group" aria-label="Choose an award to show">
          {featuredAwards.map((entry, i) => (
            <button
              type="button"
              class="carousel-dot"
              data-carousel-dot
              aria-current={i === 0 ? 'true' : undefined}
              aria-label={`Show ${entry.data.title}`}
            >
              <span aria-hidden="true" />
            </button>
          ))}
        </div>
        <button
          type="button"
          class="popup-plus carousel-toggle"
          data-carousel-toggle
          aria-pressed="false"
          aria-label="Pause the awards carousel"
          data-tip="Pause the carousel"
        >
          <span data-carousel-icon-pause>
            <Icon name="pause" size={18} />
          </span>
          <span data-carousel-icon-play hidden>
            <Icon name="play" size={18} />
          </span>
        </button>
      </div>
    </div>
    <div class="shell">
      <a class="btn btn-ghost btn-sm group mt-6 md:hidden" href={u('/awards/')}>
        All awards
        <Icon
          name="arrow"
          size={15}
          class="transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>
  </section>

  <!-- blog -->
  <section class="shell scroll-mt-24 py-20 cv-auto" id="blog">
    <SectionHead
      kicker="Writing"
      title="Notes & tutorials"
      href={u('/blog/')}
      linkText="Read more posts"
    />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((entry, i) => (
        <PostCard entry={entry} index={i} cta readingTime={readingTime(entry.body)} />
      ))}
    </div>
    <a class="btn btn-ghost btn-sm group mt-6 md:hidden" href={u('/blog/')}>
      Read more posts
      <Icon
        name="arrow"
        size={15}
        class="transition-transform duration-300 group-hover:translate-x-1"
      />
    </a>
  </section>

  <!-- cta -->
  <section
    class="band-dark relative isolate scroll-mt-24 overflow-hidden bg-bg-deep py-28 text-center md:py-40 cv-auto"
    id="cta"
  >
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-70"
      style="background: radial-gradient(60% 80% at 15% 100%, var(--c-violet), transparent 70%), radial-gradient(60% 80% at 85% 100%, var(--c-ember), transparent 70%), radial-gradient(50% 60% at 50% 110%, var(--c-accent), transparent 70%);"
      aria-hidden="true"
    ></div>
    <div class="shell-narrow" data-reveal>
      <p class="font-mono text-2xs tracking-[0.18em] text-faint uppercase">
        Open to data science &amp; GIS roles
      </p>
      <h2 class="mt-5 font-display text-[clamp(2.6rem,1.4rem+6vw,6rem)] leading-[1.02] font-bold tracking-tight text-balance">
        Let's talk about spatial problems worth solving.
      </h2>
      <p class="lede mx-auto mt-6 max-w-[40ch]">
        Looking for <strong class="text-ink">data scientist</strong> and{' '}
        <strong class="text-ink">GIS analyst</strong> roles where rigorous spatial analysis drives
        real decisions. Replies within 24 hours.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href={u('/contact/')}>
          <Icon name="mail" size={15} />
          Get in touch
        </a>
        <a class="btn btn-ghost" href={u(site.resume)} target="_blank" rel="noopener">
          <Icon name="download" size={15} />
          Download resume
          <span class="sr-only-nw"> (opens in a new tab)</span>
        </a>
      </div>
      <p class="mt-6 text-sm text-faint">
        Prefer email?{' '}
        <a
          class="font-medium text-accent-ink underline underline-offset-2"
          href={`mailto:${site.email}`}
        >
          {site.email}
        </a>
      </p>
    </div>
  </section>

  <!-- faq -->
  <section class="shell scroll-mt-24 py-20 cv-auto" id="faq">
    <SectionHead
      kicker="FAQ"
      title="About my work"
      subtitle="Common questions about collaboration and what I do"
    />
    <div class="mt-9 divide-y divide-line border-y border-line">
      {faqs.map((f) => (
        <details class="faq group" name="faq" data-reveal>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[1.05rem] font-semibold transition-colors hover:text-accent-ink">
            <span class="min-w-0">{f.q}</span>
            <span class="faq-chevron shrink-0" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="18" height="18">
                <path
                  d="M2.5 5.5 8 11l5.5-5.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </summary>
          <p class="max-w-3xl pb-5 text-body-lg leading-relaxed text-dim">
            {f.link ? (
              <>
                {f.a.split(f.link.text)[0]}
                <a class="text-accent-ink underline underline-offset-3" href={u(f.link.href)}>
                  {f.link.text}
                </a>
                {f.a.split(f.link.text)[1]}
              </>
            ) : (
              f.a
            )}
          </p>
        </details>
      ))}
    </div>
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })}
    ></script>
  </section>
</Base>

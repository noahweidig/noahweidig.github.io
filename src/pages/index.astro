---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Affiliations from '../components/Affiliations.astro';
import TechPreview from '../components/TechPreview.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AwardCard from '../components/AwardCard.astro';
import PostCard from '../components/PostCard.astro';
import CitationRow from '../components/CitationRow.astro';
import TimelineItem from '../components/TimelineItem.astro';
import Icon from '../components/Icon.astro';
import { byDate, readingTime } from '../lib/format';
import { researchAreas } from '../lib/research-areas';
import { site } from '../lib/site';
import '../styles/home.css';

const allProjects = (await getCollection('projects')).sort(byDate);
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 6);
const projects = featuredProjects.length ? featuredProjects : allProjects.slice(0, 6);

const allPubs = (await getCollection('publications')).sort(byDate);
/* `pub-listed` marks the one record Zotero's per-appearance export should
   surface, so a work presented four times is one row, not four. */
const featuredPubs = allPubs
  .filter((p) => p.data['pub-listed'] === 'yes' && p.data.categories.includes('Journal Article'))
  .slice(0, 4);

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDate).slice(0, 3);

const experience = (await getCollection('experience')).sort(byDate);
const education = (await getCollection('education')).sort(byDate);

const awards = (await getCollection('awards')).sort(byDate);
const featuredAwards = awards.filter((a) => a.data.image).slice(0, 6);

const stats = [
  { value: `${allPubs.length}+`, label: 'Papers & talks' },
  { value: '8+', label: 'Years research experience' },
  { value: '20+', label: 'Tools mastered' },
  { value: String(featuredProjects.length), label: 'Featured projects' },
];

const ways = [
  {
    band: 'band-sun',
    title: 'Research',
    body: 'Six focus areas, from WUI wildfire risk to species distribution modeling, with the papers behind each.',
    cta: 'Read the research',
    href: '#interests',
  },
  {
    band: 'band-ice',
    title: 'Tools & maps',
    body: 'Open tools: an R package for U.S. fire data, Earth Engine apps, interactive map galleries.',
    cta: 'Browse the work',
    href: '#projects',
  },
  {
    band: 'band-deep',
    title: 'Writing',
    body: 'Tutorials and notes on R, spatial workflows, and doing reproducible research in the open.',
    cta: 'Read the blog',
    href: '#blog',
  },
];

const faqs = [
  {
    q: 'What do you do?',
    a: 'I work at the intersection of geospatial analytics, data science, and applied AI — building reproducible workflows that turn spatial and environmental data into decision-ready insights.',
  },
  {
    q: 'What kinds of projects are you interested in?',
    a: "I'm drawn to work involving remote sensing, land-use change, social-ecological systems, and data storytelling. I especially enjoy projects where rigorous analysis meets clear visual communication.",
  },
  {
    q: 'Are you open to collaboration?',
    a: "Yes. I'm happy to discuss research collaborations, freelance work, and full-time opportunities in data science or GIS. The best way to start a conversation is through the contact page.",
    link: { href: '/contact/', text: 'contact page' },
  },
  {
    q: 'What tools do you typically work with?',
    a: 'Mostly R and Python for analysis and modeling, alongside SQL for data wrangling and a range of GIS tools (ArcGIS Pro, QGIS, GEE, GDAL) for spatial work. See the tech stack section for the full toolkit.',
  },
  {
    q: 'How can I get in touch?',
    a: "Email is the easiest — you'll find it on the contact page.",
    link: { href: '/contact/', text: 'contact page' },
  },
];
---

<Base title={site.name} filters={{ section: 'Page' }}>
  <Hero />

  <section class="band-ice hm-band" aria-label="At a glance">
    <div class="shell-wide">
      <ul class="hm-stats">
        {stats.map((s) => (
          <li>
            <span class="hm-num xc">{s.value}</span>
            <span class="xw">{s.label}</span>
          </li>
        ))}
      </ul>
      <Affiliations />
    </div>
  </section>

  <section class="hm-ways" aria-label="Start here">
    {ways.map((w) => (
      <div class={`hm-way ${w.band}`}>
        <div>
          <h2 class="hm-way-title xc">{w.title}</h2>
          <p class="hm-way-body">{w.body}</p>
        </div>
        <a class="btn btn-primary self-start" href={w.href}>
          {w.cta}
          <Icon name="arrow" size={15} />
        </a>
      </div>
    ))}
  </section>

  <section class="band-blue hm-band scroll-mt-24" id="interests">
    <div class="shell-wide">
      <SectionHead kicker="Research areas" title="Where I focus my work." />
      <div class="hm-rows">
        {researchAreas.map((a, i) => (
          <details class="hm-area" name="area" open={i === 0}>
            <summary>
              <span class="hm-area-name xc">{a.tab}</span>
              <span class="hm-area-plus" aria-hidden="true"></span>
            </summary>
            <div class="hm-area-body">
              <p class="xw">{a.eyebrow}</p>
              <h3 class="hm-area-head">{a.heading}</h3>
              <p class="hm-area-text">{a.body}</p>
              <ul class="hm-chips">
                {a.chips.map((c) => (
                  <li class="chip">{c}</li>
                ))}
              </ul>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="band-ice hm-band scroll-mt-24" id="projects">
    <div class="shell-wide">
      <SectionHead
        kicker="Selected work"
        title="Tools, maps & applications."
        href="/projects/"
        linkLabel="projects"
      />
      <div class="hm-grid">
        {projects.map((entry, i) => (
          <ProjectCard entry={entry} index={i} cta reveal={false} />
        ))}
      </div>
    </div>
  </section>

  <section class="band-sun hm-band scroll-mt-24" id="publications">
    <div class="shell-wide">
      <SectionHead
        kicker="Publications"
        title="Peer-reviewed & in review."
        href="/publications/"
        linkLabel="publications"
      />
      <div class="hm-stack">
        {featuredPubs.map((entry) => (
          <CitationRow entry={entry} compact />
        ))}
      </div>
    </div>
  </section>

  <section class="band-deep hm-band scroll-mt-24" id="skills">
    <div class="shell-wide">
      <SectionHead
        kicker="Tech stack"
        title="Technologies I use to build things."
        href="/tech/"
        linkLabel="tools"
      />
      <TechPreview />
    </div>
  </section>

  <section class="band-ice hm-band scroll-mt-24" id="experience">
    <div class="shell-wide">
      <SectionHead kicker="Background" title="Where I've worked and studied." />
      <div class="hm-bg2">
        <div class="hm-bg-col">
          <h3 class="xw">Experience</h3>
          <ul class="hm-stack">
            {experience.slice(0, 2).map((entry, i) => (
              <li>
                <TimelineItem
                  entry={entry}
                  base="experience"
                  current={i === 0}
                  headingLevel={4}
                  card
                />
              </li>
            ))}
          </ul>
          <a class="btn btn-outline group self-start" href="/experience/">
            View all<span class="sr-only"> experience</span>
            <Icon name="arrow" size={15} />
          </a>
        </div>
        <div class="hm-bg-col scroll-mt-24" id="education">
          <h3 class="xw">Education</h3>
          <ul class="hm-stack">
            {education.slice(0, 2).map((entry) => (
              <li>
                <TimelineItem entry={entry} base="education" headingLevel={4} card />
              </li>
            ))}
          </ul>
          <a class="btn btn-outline group self-start" href="/education/">
            View all<span class="sr-only"> education</span>
            <Icon name="arrow" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="band-blue hm-band scroll-mt-24" id="awards">
    <div class="shell-wide">
      <SectionHead
        kicker="Recognition"
        title="Featured awards."
        href="/awards/"
        linkLabel="awards"
      />
      <div class="hm-grid">
        {featuredAwards.map((entry, i) => (
          <AwardCard entry={entry} index={i} reveal={false} />
        ))}
      </div>
    </div>
  </section>

  <section class="band-ice hm-band scroll-mt-24" id="blog">
    <div class="shell-wide">
      <SectionHead kicker="Writing" title="Notes & tutorials." href="/blog/" linkLabel="posts" />
      <div class="hm-grid">
        {posts.map((entry, i) => (
          <PostCard entry={entry} index={i} cta readingTime={readingTime(entry.body)} />
        ))}
      </div>
    </div>
  </section>

  <section class="band-sun hm-band scroll-mt-24" id="cta">
    <div class="shell-wide">
      <p class="xw">Open to data science &amp; GIS roles</p>
      <h2 class="hm-cta-title xc">
        Let's talk about spatial problems <span>worth solving.</span>
      </h2>
      <div class="hm-cta-row">
        <a class="btn btn-primary" href="/contact/">
          <Icon name="mail" size={16} />
          Get in touch
        </a>
        <a class="btn btn-outline" href={site.resume} target="_blank" rel="noopener">
          <Icon name="download" size={16} />
          Resume
          <span class="sr-only-nw">(PDF, opens in a new tab)</span>
        </a>
        <span class="chip">Replies within 24 hours</span>
      </div>
      <p class="hm-cta-mail">
        or email{' '}
        <a class="font-bold underline underline-offset-4" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </p>
    </div>
  </section>

  <section class="band-ice hm-band scroll-mt-24" id="faq">
    <div class="shell-wide">
      <SectionHead
        kicker="FAQ"
        title="About my work."
        subtitle="Common questions about collaboration and what I do"
      />
      <div class="hm-faq">
        {faqs.map((f) => (
          <details class="faq" name="faq">
            <summary>
              <span class="min-w-0">{f.q}</span>
              <span class="faq-chevron shrink-0" aria-hidden="true">
                <Icon name="chevron" size={18} />
              </span>
            </summary>
            <p>
              {f.link ? (
                <>
                  {f.a.split(f.link.text)[0]}
                  <a class="underline underline-offset-4" href={f.link.href}>
                    {f.link.text}
                  </a>
                  {f.a.split(f.link.text)[1]}
                </>
              ) : (
                f.a
              )}
            </p>
          </details>
        ))}
      </div>
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        })}
      ></script>
    </div>
  </section>
</Base>

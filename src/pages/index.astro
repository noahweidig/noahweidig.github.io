---
import { u } from '../lib/url';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Affiliations from '../components/Affiliations.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import TechPreview from '../components/TechPreview.astro';
import SectionHead from '../components/SectionHead.astro';
import StatStrip from '../components/StatStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AwardCard from '../components/AwardCard.astro';
import PostCard from '../components/PostCard.astro';
import CitationRow from '../components/CitationRow.astro';
import TimelineItem from '../components/TimelineItem.astro';
import Icon from '../components/Icon.astro';
import Popup from '../components/Popup.astro';
import { byDate, readingTime, year } from '../lib/format';
import { site } from '../lib/site';

const allProjects = (await getCollection('projects')).sort(byDate);
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 6);
const projects = featuredProjects.length ? featuredProjects : allProjects.slice(0, 6);

const allPubs = (await getCollection('publications')).sort(byDate);
/* `pub-listed` marks the one record Zotero's per-appearance export should
   surface, so a work presented four times is one row, not four. */
const featuredPubs = allPubs
  .filter((p) => p.data['pub-listed'] === 'yes' && p.data.categories.includes('Journal Article'))
  .slice(0, 4);

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDate).slice(0, 3);

const experience = (await getCollection('experience')).sort(byDate);
const education = (await getCollection('education')).sort(byDate);

const awards = (await getCollection('awards')).sort(byDate);
const featuredAwards = awards.filter((a) => a.data.image).slice(0, 6);

const pubCounts = Object.entries(
  allPubs.reduce<Record<string, number>>((acc, p) => {
    const c = p.data.categories[0] ?? 'Other';
    acc[c] = (acc[c] ?? 0) + 1;
    return acc;
  }, {}),
).sort((a, b) => b[1] - a[1]);

const stats = [
  {
    value: `${allPubs.length}+`,
    label: 'Papers & Talks',
    id: 'pop-pubs',
    body: 'Journal articles, conference presentations, webinars and media coverage, by type.',
    items: pubCounts.map(([t, n]) => ({ t: `${t}s`, n: String(n), href: u('/publications/') })),
    href: u('/publications/'),
    cta: 'All publications',
  },
  {
    value: '8+',
    label: 'Years Research Experience',
    id: 'pop-years',
    body: 'Research, GIS, and data roles across universities, a federal agency, and local government.',
    items: experience.map((e) => ({
      t: `${e.data.title}, ${e.data.org}`,
      n: String(year(e.data.date)),
      href: u(`/experience/${e.id}/`),
    })),
    href: '#experience',
    cta: 'See the full background',
  },
  {
    value: '20+',
    label: 'Tools Mastered',
    id: 'pop-tools-count',
    body: 'Mostly R and Python for analysis and modeling, SQL for data wrangling, and GIS tools (ArcGIS Pro, QGIS, GEE, GDAL) for spatial work.',
    items: [],
    href: '#skills',
    cta: 'See the tech stack',
  },
  {
    value: featuredProjects.length,
    label: 'Featured Projects',
    id: 'pop-featured',
    body: 'Open tools, maps, and packages built and maintained in the open.',
    items: projects.map((p) => ({ t: p.data.title, href: u(`/projects/${p.id}/`) })),
    href: '#projects',
    cta: 'Browse the work',
  },
];

const researchAreas = [
  'Remote Sensing',
  'Land-Use Change',
  'Spatial Statistics',
  'Applied AI',
  'Biodiversity',
  'Geospatial Engineering',
];

const starts = [
  {
    id: 'pop-research',
    items: researchAreas.map((t) => ({ t, href: '#interests' })),
    href: '#interests',
    icon: 'layers',
    title: 'Research',
    body: 'Six focus areas, from WUI wildfire risk to species distribution modeling — with the papers behind each.',
    cta: 'Read the research',
  },
  {
    id: 'pop-tools',
    items: projects.map((p) => ({ t: p.data.title, href: u(`/projects/${p.id}/`) })),
    href: '#projects',
    icon: 'terminal',
    title: 'Tools & maps',
    body: 'Open tools: an R package for U.S. fire data, Earth Engine apps, interactive map galleries.',
    cta: 'Browse the work',
  },
  {
    id: 'pop-writing',
    items: posts.map((p) => ({ t: p.data.title, href: u(`/blog/${p.id}/`) })),
    href: '#blog',
    icon: 'pencil',
    title: 'Writing',
    body: 'Tutorials and notes on R, spatial workflows, and doing reproducible research in the open.',
    cta: 'Read the blog',
  },
];

const faqs = [
  {
    q: 'What do you do?',
    a: 'I work at the intersection of geospatial analytics, data science, and applied AI — building reproducible workflows that turn spatial and environmental data into decision-ready insights.',
  },
  {
    q: 'What kinds of projects are you interested in?',
    a: "I'm drawn to work involving remote sensing, land-use change, social-ecological systems, and data storytelling. I especially enjoy projects where rigorous analysis meets clear visual communication.",
  },
  {
    q: 'Are you open to collaboration?',
    a: "Yes. I'm happy to discuss research collaborations, freelance work, and full-time opportunities in data science or GIS. The best way to start a conversation is through the contact page.",
    link: { href: '/contact/', text: 'contact page' },
  },
  {
    q: 'What tools do you typically work with?',
    a: 'Mostly R and Python for analysis and modeling, alongside SQL for data wrangling and a range of GIS tools (ArcGIS Pro, QGIS, GEE, GDAL) for spatial work. See the tech stack section for the full toolkit.',
  },
  {
    q: 'How can I get in touch?',
    a: "Email is the easiest — you'll find it on the contact page.",
    link: { href: '/contact/', text: 'contact page' },
  },
];
---

<Base title={site.name} filters={{ section: 'Page' }}>
  <Hero />

  <!-- stats + affiliations -->
  <section class="shell py-20 md:py-28">
    <StatStrip stats={stats} />
    <Affiliations />
  </section>

  <!-- three ways in -->
  <section class="shell pb-12 md:pb-16">
    <div class="grid gap-5 md:grid-cols-3">
      {starts.map((s, i) => (
        <div
          class="card card-hover group relative flex flex-col p-6"
          data-reveal
          style={`--reveal-delay:${i * 70}ms`}
        >
          <span class="grid aspect-square h-11 w-11 shrink-0 place-items-center rounded-full bg-matte text-accent-ink">
            <Icon name={s.icon} size={20} />
          </span>
          <h2 class="mt-5 text-xl">{s.title}</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-dim">{s.body}</p>
          <button
            type="button"
            class="popup-plus mt-5 ml-auto after:absolute after:inset-0 after:rounded-[inherit] after:content-['']"
            data-popup-open={s.id}
            aria-haspopup="dialog"
            aria-label={`More about ${s.title}`}
          >
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path
                d="M8 2.5v11M2.5 8h11"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                fill="none"
              />
            </svg>
          </button>
        </div>
      ))}
    </div>
  </section>

  {[...stats, ...starts].map((s) => (
    <Popup id={s.id} eyebrow={'label' in s ? s.label : s.title} title={s.cta}>
      <p class="text-lg leading-relaxed">{s.body}</p>
      {s.items.length > 0 && (
        <ul class="divide-y divide-line border-y border-line text-ink">
          {s.items.map((it) => (
            <li>
              <a
                class="flex items-center justify-between gap-4 py-3 hover:text-accent-ink"
                href={it.href}
              >
                <span>{it.t}</span>
                {'n' in it ? (
                  <span class="font-mono text-sm text-faint">{it.n}</span>
                ) : (
                  <Icon name="arrow" size={15} class="shrink-0" />
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
      <a class="inline-flex items-center gap-1.5 font-medium text-accent-ink" href={s.href}>
        {s.cta}
        <Icon name="arrow" size={15} />
      </a>
    </Popup>
  ))}

  <!-- research areas -->
  <section
    class="band-dark scroll-mt-24 border-y border-line bg-bg-deep py-28 md:py-36 cv-auto"
    id="interests"
  >
    <div class="shell">
      <SectionHead kicker="Research areas" title="Where I focus my work" />
      <ResearchAreas />
    </div>
  </section>

  <!-- projects -->
  <section class="shell scroll-mt-24 py-24 md:py-32 cv-auto" id="projects">
    <SectionHead
      kicker="Selected work"
      title="Tools, maps & applications"
      href={u('/projects/')}
      linkText="Browse all projects"
    />
    <div class="mt-10" data-carousel data-reveal>
      <div
        class="carousel-track flex snap-x snap-mandatory gap-4 overflow-x-auto -mx-4 -my-6 px-4 py-6 [scroll-padding-inline:16px]"
        data-carousel-track
      >
        {projects.map((entry, i) => (
          <ProjectCard
            entry={entry}
            index={i}
            cta
            reveal={false}
            class="w-[min(38rem,calc(100vw-3rem))] shrink-0 snap-start"
          />
        ))}
      </div>

      <div class="mt-8 flex items-center justify-between gap-3 md:justify-end">
        <a class="btn btn-ghost group h-12 md:hidden" href={u('/projects/')}>
          Browse all projects
          <Icon
            name="arrow"
            size={15}
            class="transition-transform duration-300 group-hover:translate-x-1"
          />
        </a>
        <div class="flex items-center gap-3">
          <button
            type="button"
            class="popup-plus carousel-btn"
            data-carousel-prev
            aria-label="Previous project"
          >
            <span class="carousel-chev carousel-chev-prev">
              <Icon name="chevron" size={18} />
            </span>
          </button>
          <button
            type="button"
            class="popup-plus carousel-btn"
            data-carousel-next
            aria-label="Next project"
          >
            <span class="carousel-chev carousel-chev-next">
              <Icon name="chevron" size={18} />
            </span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- publications -->
  <section class="shell scroll-mt-24 py-24 md:py-32 cv-auto" id="publications">
    <SectionHead
      kicker="Publications"
      title="Peer-reviewed & in review"
      href={u('/publications/')}
      linkText="All publications"
    />
    <div class="mt-8">
      {featuredPubs.map((entry) => (
        <CitationRow entry={entry} compact />
      ))}
    </div>
    <a class="btn btn-ghost group mt-6 h-12 md:hidden" href={u('/publications/')}>
      All publications
      <Icon
        name="arrow"
        size={15}
        class="transition-transform duration-300 group-hover:translate-x-1"
      />
    </a>
  </section>

  <!-- skills -->
  <section
    class="band-dark scroll-mt-24 border-y border-line bg-bg-deep py-24 md:py-32 cv-auto"
    id="skills"
  >
    <div class="shell">
      <SectionHead
        kicker="Tech stack"
        title="Technologies I use to build things"
        href={u('/tech/')}
        linkText="View all tools"
      />
      <TechPreview />
    </div>
  </section>

  <!-- experience + education -->
  <section class="shell scroll-mt-24 py-28 md:py-36 cv-auto" id="experience">
    <SectionHead kicker="Background" title="Where I've worked and studied" />
    <div class="mt-10 grid gap-x-16 gap-y-12 lg:grid-cols-2 lg:gap-y-0">
      <div class="grid content-start gap-y-5 lg:row-span-4 lg:grid-rows-subgrid">
        <h3 class="font-mono text-2xs tracking-[0.18em] text-faint uppercase">Experience</h3>
        <ul class="grid gap-4 lg:row-span-2 lg:grid-rows-subgrid">
          {experience.slice(0, 2).map((entry, i) => (
            <li>
              <TimelineItem
                entry={entry}
                base="experience"
                current={i === 0}
                headingLevel={4}
                card
              />
            </li>
          ))}
        </ul>
        <a
          class="btn btn-ghost btn-sm group mt-1 justify-self-start max-md:h-12 max-md:px-[1.15rem] max-md:text-sm"
          href={u('/experience/')}
        >
          See all experience
          <Icon
            name="arrow"
            size={15}
            class="transition-transform duration-300 group-hover:translate-x-1"
          />
        </a>
      </div>
      <div
        id="education"
        class="grid scroll-mt-24 content-start gap-y-5 lg:row-span-4 lg:grid-rows-subgrid"
      >
        <h3 class="font-mono text-2xs tracking-[0.18em] text-faint uppercase">Education</h3>
        <ul class="grid gap-4 lg:row-span-2 lg:grid-rows-subgrid">
          {education.slice(0, 2).map((entry) => (
            <li>
              <TimelineItem entry={entry} base="education" headingLevel={4} card />
            </li>
          ))}
        </ul>
        <a
          class="btn btn-ghost btn-sm group mt-1 justify-self-start max-md:h-12 max-md:px-[1.15rem] max-md:text-sm"
          href={u('/education/')}
        >
          See all education
          <Icon
            name="arrow"
            size={15}
            class="transition-transform duration-300 group-hover:translate-x-1"
          />
        </a>
      </div>
    </div>
  </section>

  <!-- awards -->
  <section
    class="band-dark scroll-mt-24 border-y border-line bg-bg-deep py-24 md:py-32 cv-auto"
    id="awards"
  >
    <div class="shell">
      <SectionHead
        kicker="Recognition"
        title="Featured awards"
        href={u('/awards/')}
        linkText="All awards"
      />
    </div>
    <div class="shell mt-10" data-carousel data-reveal>
      <div
        class="carousel-track flex snap-x snap-mandatory gap-4 overflow-x-auto -mx-4 -my-6 px-4 py-6 [scroll-padding-inline:16px]"
        data-carousel-track
      >
        {featuredAwards.map((entry, i) => (
          <AwardCard
            entry={entry}
            index={i}
            reveal={false}
            class="w-[min(38rem,calc(100vw-3rem))] shrink-0 snap-start"
          />
        ))}
      </div>

      <div class="mt-8 flex items-center justify-between gap-3 md:justify-end">
        <a class="btn btn-ghost group h-12 md:hidden" href={u('/awards/')}>
          All awards
          <Icon
            name="arrow"
            size={15}
            class="transition-transform duration-300 group-hover:translate-x-1"
          />
        </a>
        <div class="flex items-center gap-3">
          <button
            type="button"
            class="popup-plus carousel-btn"
            data-carousel-prev
            aria-label="Previous award"
          >
            <span class="carousel-chev carousel-chev-prev">
              <Icon name="chevron" size={18} />
            </span>
          </button>
          <button
            type="button"
            class="popup-plus carousel-btn"
            data-carousel-next
            aria-label="Next award"
          >
            <span class="carousel-chev carousel-chev-next">
              <Icon name="chevron" size={18} />
            </span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- blog -->
  <section class="shell scroll-mt-24 py-24 md:py-32 cv-auto" id="blog">
    <SectionHead
      kicker="Writing"
      title="Notes & tutorials"
      href={u('/blog/')}
      linkText="Read more posts"
    />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((entry, i) => (
        <PostCard entry={entry} index={i} cta readingTime={readingTime(entry.body)} />
      ))}
    </div>
    <a class="btn btn-ghost group mt-6 h-12 md:hidden" href={u('/blog/')}>
      Read more posts
      <Icon
        name="arrow"
        size={15}
        class="transition-transform duration-300 group-hover:translate-x-1"
      />
    </a>
  </section>

  <!-- cta -->
  <section
    class="band-dark relative isolate scroll-mt-24 overflow-hidden bg-bg-deep py-28 text-center md:py-40 cv-auto"
    id="cta"
  >
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: linear-gradient(to bottom, rgb(255 255 255 / 0.12), transparent 40%), linear-gradient(120deg, #7b2cbf 0%, #b3197a 45%, #e5132b 100%);"
      aria-hidden="true"
    ></div>
    <div class="shell-narrow" data-reveal>
      <p class="font-mono text-2xs tracking-[0.18em] text-white/80 uppercase">
        Open to data science &amp; GIS roles
      </p>
      <h2 class="mt-5 font-display text-[clamp(2rem,1.3rem+2.8vw,3.5rem)] leading-[1.1] font-semibold tracking-tight text-balance">
        Let's talk about spatial problems worth solving.
      </h2>
      <p class="lede mx-auto mt-6 max-w-[40ch] text-white/90">
        Looking for <strong class="text-white">data scientist</strong> and{' '}
        <strong class="text-white">GIS analyst</strong> roles where rigorous spatial analysis drives
        real decisions. Replies within 24 hours.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href={u('/contact/')}>
          <Icon name="mail" size={15} />
          Get in touch
        </a>
        <a
          class="btn btn-ghost border-white bg-transparent text-white hover:bg-white/10"
          href={u(site.resume)}
          target="_blank"
          rel="noopener"
        >
          <Icon name="download" size={15} />
          Download resume
          <span class="sr-only-nw"> (opens in a new tab)</span>
        </a>
      </div>
      <p class="mt-6 text-sm text-white/80">
        Prefer email?{' '}
        <a
          class="font-medium text-white underline underline-offset-2"
          href={`mailto:${site.email}`}
        >
          {site.email}
        </a>
      </p>
    </div>
  </section>

  <!-- faq -->
  <section class="shell scroll-mt-24 py-24 md:py-32 cv-auto" id="faq">
    <SectionHead
      kicker="FAQ"
      title="About my work"
      subtitle="Common questions about collaboration and what I do"
    />
    <div class="mt-9 divide-y divide-line border-y border-line">
      {faqs.map((f) => (
        <details class="faq group" name="faq" data-reveal>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[1.05rem] font-semibold transition-colors hover:text-accent-ink">
            <span class="min-w-0">{f.q}</span>
            <span class="faq-chevron shrink-0" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="18" height="18">
                <path
                  d="M2.5 5.5 8 11l5.5-5.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </summary>
          <p class="max-w-3xl pb-5 text-body-lg leading-relaxed text-dim">
            {f.link ? (
              <>
                {f.a.split(f.link.text)[0]}
                <a class="text-accent-ink underline underline-offset-3" href={u(f.link.href)}>
                  {f.link.text}
                </a>
                {f.a.split(f.link.text)[1]}
              </>
            ) : (
              f.a
            )}
          </p>
        </details>
      ))}
    </div>
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })}
    ></script>
  </section>
</Base>

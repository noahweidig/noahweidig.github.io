---
import { u } from '../lib/url';
import { tagHref } from '../lib/tags';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import ShareRow from '../components/ShareRow.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PrevNext from '../components/PrevNext.astro';
import Toc from '../components/Toc.astro';
import type { Heading } from '../components/Toc.astro';
import type { Sibling } from '../components/PrevNext.astro';

interface Props {
  title: string;
  description?: string;
  kicker?: string;
  meta?: string;
  backHref: string;
  backLabel: string;
  chips?: string[];
  links?: { label: string; href: string; variant?: 'primary' | 'ghost'; external?: boolean }[];
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  section: string;
  prev?: Sibling | null;
  next?: Sibling | null;
  headings?: Heading[];
}
const {
  title,
  description,
  kicker,
  meta,
  backHref,
  backLabel,
  chips = [],
  links = [],
  image,
  type = 'article',
  publishedTime,
  section,
  prev,
  next,
  headings = [],
} = Astro.props;

/* Reading mode is a blog-post affordance: strip the rails and grow the type. */
const reading = section === 'Blog';

/* The contents rail needs room beside the measure, so a page that has one
   widens from the reading shell to the full one. */
const hasToc = headings.filter((h) => h.depth === 2 || h.depth === 3).length > 1;
---

<Base
  title={title}
  description={description}
  image={image}
  type={type}
  publishedTime={publishedTime}
  filters={{ section, tags: chips }}
>
  <article>
    <header class="relative overflow-hidden border-b border-line bg-bg-deep">
      <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
      <div class="shell relative py-12 text-center md:py-16">
        <Breadcrumbs
          trail={[{ label: section, href: backHref }]}
          current={title}
          class="flex justify-center"
        />

        {
          kicker && (
            <p class="kicker mt-6 justify-center" data-pagefind-ignore>
              {kicker}
            </p>
          )
        }
        <h1
          class="mx-auto mt-4 max-w-4xl font-display text-[clamp(1.9rem,1.2rem+2.6vw,3.1rem)] font-medium"
        >
          {title}
        </h1>
        {
          meta && (
            <p class="mt-4 text-sm text-dim" data-pagefind-ignore>
              {meta}
            </p>
          )
        }

        {
          chips.length > 0 && (
            <div class="mt-5 flex flex-wrap justify-center gap-1.5" data-pagefind-ignore>
              {chips.map((c) => (
                <a
                  href={u(tagHref(c))}
                  data-tip={`Browse everything tagged ${c}`}
                  class="chip transition-colors hover:border-accent hover:text-accent-ink"
                >
                  {c}
                </a>
              ))}
            </div>
          )
        }

        {
          links.length > 0 && (
            <div class="mt-7 flex flex-wrap justify-center gap-2.5" data-pagefind-ignore>
              {links.map((l) => (
                <a
                  class:list={['btn', l.variant === 'primary' ? 'btn-primary' : 'btn-ghost']}
                  href={u(l.href)}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener' : undefined}
                >
                  {l.label}
                  {l.external && <Icon name="external" size={14} />}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    {
      hasToc ? (
        <div class="shell py-12 md:py-16">
          <div
            class="mx-auto grid max-w-none gap-x-10 lg:grid-cols-[1fr_min(46rem,100%)_1fr]"
            data-article-grid
          >
            <div class="min-w-0 lg:col-start-2">
              {reading && (
                <div class="no-print mb-6 flex justify-end" data-pagefind-ignore>
                  <button
                    type="button"
                    class="btn btn-ghost btn-sm"
                    data-reading-toggle
                    aria-pressed="false"
                    data-tip="Reading mode: just the article"
                  >
                    <Icon name="reader" size={15} />
                    <span data-reading-label>Reading mode</span>
                  </button>
                </div>
              )}
              <div class="prose-nw">
                <slot />
              </div>
              <ShareRow title={title} />
            </div>
            <div class="lg:col-start-3 lg:row-start-1">
              <Toc headings={headings} />
            </div>
          </div>
        </div>
      ) : (
        <div class="shell-narrow py-12 md:py-16">
          {reading && (
            <div class="no-print mb-6 flex justify-end" data-pagefind-ignore>
              <button
                type="button"
                class="btn btn-ghost btn-sm"
                data-reading-toggle
                aria-pressed="false"
                data-tip="Reading mode: just the article"
              >
                <Icon name="reader" size={15} />
                <span data-reading-label>Reading mode</span>
              </button>
            </div>
          )}
          <div class="prose-nw">
            <slot />
          </div>
          <ShareRow title={title} />
        </div>
      )
    }

    <slot name="after" />

    <PrevNext prev={prev} next={next} label={backLabel.replace(/^All /i, '')} />
  </article>
</Base>

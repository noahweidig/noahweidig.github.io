{
  "name": "noahweidig-site",
  "type": "module",
  "private": true,
  "description": "noahweidig.com — Astro + TypeScript + Tailwind.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "a11y": "node scripts/axe-audit.mjs",
    "astro": "astro",
    "audit:post": "mkdir -p .audit && AUDIT_REPORTS=1 astro build",
    "build": "astro check && astro build && pagefind --site dist",
    "build:fast": "astro build && pagefind --site dist",
    "covers": "node scripts/generate-blog-covers.mjs",
    "covers:all": "node scripts/generate-blog-covers.mjs --site --collections --pages",
    "covers:ensure": "node scripts/ensure-blog-covers.mjs",
    "dev": "astro dev",
    "format": "prettier --write .",
    "globe": "node scripts/generate-globe-svg.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "logos:pkg": "node scripts/generate-pkg-logo-srcset.mjs",
    "lint": "prettier --check . && astro check",
    "pdfs": "node scripts/generate-pdfs.mjs",
    "seo:audit": "node scripts/run-seo-audit.mjs",
    "shots": "node scripts/generate-project-shots.mjs",
    "preview": "astro preview",
    "start": "astro dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@bytemd/plugin-gfm": "^1.21.0",
    "@octokit/rest": "^22.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "bytemd": "^1.21.0",
    "remark-github-blockquote-alert": "^2.1.0",
    "sanitize-html": "^2.17.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@casoon/astro-post-audit": "0.6.0",
    "@types/node": "^26.5.1",
    "@types/sanitize-html": "^2.16.1",
    "axe-core": "^4.13.0",
    "js-yaml": "^4.3.2",
    "lighthouse": "^13.4.1",
    "lucide-static": "^1.47.0",
    "pagefind": "^1.5.2",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "puppeteer": "^25.11.0",
    "sharp": "^0.35.4",
    "svelte": "^5.57.1",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}

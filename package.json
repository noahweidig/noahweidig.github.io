{
  "name": "noahweidig-site",
  "type": "module",
  "private": true,
  "description": "noahweidig.com — Astro + TypeScript + Tailwind.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build && pagefind --site dist",
    "build:fast": "astro build && pagefind --site dist",
    "dev": "astro dev",
    "format": "prettier --write .",
    "logos:pkg": "node scripts/generate/pkg-logo-srcset.mjs",
    "lint": "prettier --check . && astro check && node scripts/check/tokens.mjs",
    "pdfs": "node scripts/generate/pdfs.mjs",
    "shots": "node scripts/generate/project-shots.mjs",
    "preview": "astro preview",
    "start": "astro dev",
    "test": "node --test \"src/lib/*.test.ts\""
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.1",
    "js-yaml": "^5.5.0",
    "pagefind": "^1.5.2",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "puppeteer": "^25.15.0",
    "sharp": "^0.35.4",
    "typescript": "^5.7.0"
  }
}

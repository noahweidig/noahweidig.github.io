{
  "name": "noahweidig-site",
  "type": "module",
  "private": true,
  "description": "noahweidig.com — Astro + TypeScript + Tailwind.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "build:fast": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "prettier --check . && astro check",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.10.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.0"
  }

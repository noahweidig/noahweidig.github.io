{
  "name": "noahweidig-site",
  "type": "module",
  "private": true,
  "description": "noahweidig.com \u2014 Astro + TypeScript + Tailwind.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "a11y": "node scripts/axe-audit.mjs",
    "astro": "astro",
    "build": "astro check && astro build && pagefind --site dist",
    "build:fast": "astro build && pagefind --site dist",
    "covers": "node scripts/generate-blog-covers.mjs",
    "dev": "astro dev",
    "format": "prettier --write .",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "prettier --check . && astro check",
    "pdfs": "node scripts/generate-pdfs.mjs",
    "preview": "astro preview",
    "start": "astro dev"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.10.0",
    "axe-core": "^4.13.0",
    "lighthouse": "^13.4.1",
    "lucide-static": "^1.40.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "puppeteer": "^25.9.0",
    "typescript": "^5.7.0"
  }
}
